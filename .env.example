# Supabase: in locale i valori li dà `supabase status` (API_URL e PUBLISHABLE_KEY).
# Senza queste due righe il sito usa i 48 annunci di prova in memoria e l'accesso è disattivato.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chiave API di Claude: serve per leggere le foto in "Scatta e vendi" e in create_draft.
# Senza chiave, le bozze si creano dal testo con regole semplici.
ANTHROPIC_API_KEY=

# Modello per le bozze (predefinito: claude-opus-5-5)
PIAZZA_DRAFT_MODEL=claude-opus-5-5

# Indirizzo pubblico del sito, usato nei link restituiti dal server MCP
PIAZZA_BASE_URL=http://localhost:4321

# Chiave segreta di Supabase, solo lato server (in locale: SECRET_KEY di `supabase status`).
# Serve per gli avvisi: cercare chi ha salvato una ricerca o un annuncio e scrivergli.
SUPABASE_SECRET_KEY=

# Email degli avvisi. In locale finiscono nella casella di prova Mailpit: http://127.0.0.1:54324
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_USER=
SMTP_PASS=
MAIL_FROM=giro.shop <avvisi@giro.shop>
