---
import { createHash } from 'node:crypto';
import '../styles/fonts.css';
import '../styles/global.css';
import archivoLatin from '../assets/fonts/archivo-latin.woff2?url';
import instrumentLatin from '../assets/fonts/instrument-sans-latin.woff2?url';
import martianLatin from '../assets/fonts/martian-mono-latin.woff2?url';
import UserMenu from '../components/UserMenu.astro';
import PlacePicker from '../components/PlacePicker.astro';
import PasskeyOffer from '../components/PasskeyOffer.astro';
import Toasts from '../components/Toasts.astro';
import ThemeSwitch from '../components/ThemeSwitch.astro';
import { jsonLdScript } from '../core/seo.ts';
import { siteOrigin } from '../lib/notify.ts';

interface Props {
  title: string;
  description?: string;
  /** Immagine per le anteprime dei link condivisi (Open Graph). */
  image?: string;
  /** Testo alternativo dell'immagine di anteprima. */
  imageAlt?: string;
  /** Prezzo in CHF delle schede annuncio, per le anteprime che lo mostrano (Facebook, Pinterest). */
  price?: number;
  /** Dati strutturati schema.org per i motori di ricerca: uno o più blocchi. */
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  /** "product" per le schede annuncio, "website" per il resto. */
  ogType?: 'website' | 'product';
  /** Pagina da non far trovare ai motori di ricerca (es. /usato senza annunci). */
  noindex?: boolean;
}

const {
  title,
  description = 'Compra e vendi in Ticino: annunci da una foto, ricerca a parole tue, connettore per assistenti AI.',
  image,
  imageAlt,
  price,
  jsonLd,
  ogType = 'website',
  noindex = false,
} = Astro.props;
const path = Astro.url.pathname;
// Indirizzo canonico: senza parametri, sull'indirizzo pubblico del sito
const origin = siteOrigin(Astro.url.origin);
const canonical = `${origin}${path}`;
// Senza immagine propria vale l'anteprima del sito (public/og.png, pnpm icone); entrambe 1200×630
const ogImage = image ? (image.startsWith('http') ? image : `${origin}${image}`) : `${origin}/og.png`;
const ogImageAlt = image ? (imageAlt ?? title) : 'giro.shop: compra e vendi in Ticino';
const ogImageType = ogImage.split('?')[0].endsWith('.png') ? 'image/png' : 'image/jpeg';
const jsonLdBlocks = jsonLd ? [jsonLd].flat() : [];
const summary = description.length > 200 ? `${description.slice(0, 197)}…` : description;
const nav = [
  { href: '/cerca', label: 'Cerca' },
  { href: '/connetti', label: 'Assistente AI' },
];
const footerNav = [
  {
    title: 'Compra e vendi',
    links: [
      { href: '/cerca', label: 'Cerca annunci' },
      { href: '/vendi', label: 'Vendi un oggetto' },
      { href: '/svuota-casa', label: 'Svuota casa' },
      { href: '/cercasi', label: 'Cercasi' },
      { href: '/pro', label: 'Pro per negozi' },
    ],
  },
  {
    title: 'Aiuto',
    links: [
      { href: '/sicurezza', label: 'Comprare e vendere sicuri' },
      { href: '/connetti', label: 'Assistente AI' },
      { href: '/partner', label: 'Partner: sgombero e traslochi' },
    ],
  },
  {
    title: 'Note legali',
    links: [
      { href: '/privacy', label: 'Privacy' },
      { href: '/condizioni', label: "Condizioni d'uso" },
    ],
  },
];
const year = new Date().getFullYear();
// Su telefono la barra dei comandi va dal lato del pollice: per chi è mancino a sinistra. Si legge prima del disegno,
// così non salta da una parte all'altra (chiave come in core/hand.ts). Script inline: il suo hash va nella CSP.
const HAND_SCRIPT = "try{if(localStorage.getItem('giro:mano')==='sinistra')document.documentElement.dataset.mano='sinistra'}catch{}";
Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(HAND_SCRIPT).digest('base64')}`);
// Tema scelto a mano (components/ThemeSwitch.astro): anche lui prima del disegno, per non far lampeggiare la pagina
const THEME_SCRIPT =
  "try{var t=localStorage.getItem('giro:tema');if(t==='chiaro'||t==='scuro'){document.documentElement.dataset.tema=t;var c=t==='scuro'?'#0b0b0c':'#ffffff';document.querySelectorAll('meta[name=theme-color]').forEach(function(m){m.content=c})}}catch{}";
Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(THEME_SCRIPT).digest('base64')}`);
// Menu account (server island): arriva dopo il primo disegno e ogni pagina "lampeggiava" in testata. Qui, al posto del
// segnaposto, si rimette subito il menu dell'ultima pagina vista in questa scheda (lo salva lib/motion.ts uscendo);
// quando l'isola arriva lo sostituisce con quello fresco, di solito identico. Prima visita: il segnaposto, come prima.
const MENU_SCRIPT =
  "(function(){try{var h=sessionStorage.getItem('giro:menu'),s=document.currentScript,g=s&&s.previousElementSibling;if(h&&g&&g.classList.contains('nav-ghost')){var t=document.createElement('template');t.innerHTML=h;g.replaceWith(t.content)}}catch(e){}})();";
Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(MENU_SCRIPT).digest('base64')}`);
// Passaggio tra le pagine (stili in global.css, "Transizioni tra pagine"): la foto della card toccata vola fino alla foto
// grande dell'annuncio, e torna nella sua card con Indietro. Il nome di transizione va solo su quella card, al momento:
// pageswap sulla pagina che si lascia, pagereveal su quella che arriva (che deve essere ascoltato prima del primo disegno,
// per questo è qui in testa). Una transizione saltata (scheda in background, link aperto da fuori) non è un errore: quiet(). Senza Navigation API (Safari fino alla 18) resta la dissolvenza semplice.
// Tornando indietro (traverse) la pagina di solito si ricarica: .vt-back spegne l'entrata delle card e la sfumatura
// delle foto (global.css), che facevano atterrare la foto in una card ancora invisibile; la foto di quella card si carica subito.
const VT_SCRIPT =
  "(function(){var N='foto-annuncio';function clear(){document.querySelectorAll('.lph[style*=view-transition],.hero-photo[style*=view-transition]').forEach(function(e){e.style.viewTransitionName=''})}function card(u){if(!u)return null;var p=new URL(u).pathname,c=null;document.querySelectorAll('a.lcard').forEach(function(a){if(!c&&a.pathname===p&&a.querySelector('.lph img'))c=a.querySelector('.lph')});return c}function quiet(t){var f=function(){};t.ready.catch(f);t.finished.catch(f);if(t.updateCallbackDone)t.updateCallbackDone.catch(f)}function name(c){var h=document.querySelector('.hero-photo');if(h)h.style.viewTransitionName='none';c.style.viewTransitionName=N}addEventListener('pageswap',function(e){var t=e.viewTransition;if(!t)return;quiet(t);clear();var c=card(e.activation&&e.activation.entry&&e.activation.entry.url);if(c)name(c)});addEventListener('pagereveal',function(e){var t=e.viewTransition;if(!t)return;quiet(t);clear();var a=window.navigation&&navigation.activation;if(a&&a.navigationType==='traverse')document.documentElement.classList.add('vt-back');var c=card(a&&a.from&&a.from.url);if(!c)return;var i=c.querySelector('img');if(i)i.loading='eager';name(c);t.finished.then(clear,clear)})})();";
Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(VT_SCRIPT).digest('base64')}`);
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={summary} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content="giro.shop" />
    <meta property="og:locale" content="it_CH" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={summary} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    {price != null && <meta property="product:price:amount" content={price.toFixed(2)} />}
    {price != null && <meta property="product:price:currency" content="CHF" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={summary} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {jsonLdBlocks.map((data) => <script type="application/ld+json" set:html={jsonLdScript(data)} />)}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="giro.shop" />
    <meta name="application-name" content="giro.shop" />
    <!-- Font serviti da noi (src/styles/fonts.css), niente richieste a Google: si caricano subito quelli dei caratteri latini -->
    <link rel="preload" href={instrumentLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={martianLatin} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0b0c" media="(prefers-color-scheme: dark)" />
    <script is:inline set:html={HAND_SCRIPT} />
    <script is:inline set:html={THEME_SCRIPT} />
    <script is:inline set:html={VT_SCRIPT} />
  </head>
  <body>
    <a class="skip" href="#contenuto">Vai al contenuto</a>
    <header class="top">
      <div class="wrap top-in">
        <a class="brand" href="/" aria-label="giro.shop, pagina iniziale" data-astro-prefetch>
          <svg class="mark" viewBox="0 0 32 32" aria-hidden="true">
            <rect x="1" y="1" width="30" height="30" rx="9"></rect>
            <path class="glyph" d="M5.5 23.5L11.5 12L16 19L20.5 12L26.5 23.5"></path>
          </svg>
          <span class="wordmark">Mercatino <span class="tld">Ticino</span></span>
        </a>
        <nav aria-label="Principale">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class={item.href === '/cerca' ? 'nav-search' : 'nav-ai'}
                data-astro-prefetch
                aria-current={path.startsWith(item.href) ? 'page' : undefined}
              >
                {item.href === '/cerca' && (
                  <svg class="nav-ico" viewBox="0 0 16 16" aria-hidden="true">
                    <circle cx="7" cy="7" r="5" />
                    <path d="M11 11l3.5 3.5" />
                  </svg>
                )}
                <span class="nav-text">{item.label}</span>
              </a>
            ))
          }
          <UserMenu server:defer>
            <Fragment slot="fallback">
              <span class="nav-ghost" aria-hidden="true">Accedi</span>
              <script is:inline set:html={MENU_SCRIPT} />
            </Fragment>
          </UserMenu>
          <a class="btn primary nav-sell" href="/vendi" data-astro-prefetch aria-current={path.startsWith('/vendi') ? 'page' : undefined}>
            <svg class="rail-ico" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M8 2.5v11M2.5 8h11" />
            </svg>
            <span class="rail-text">Vendi</span>
          </a>
        </nav>
      </div>
    </header>
    <main id="contenuto">
      <PasskeyOffer />
      <slot />
    </main>
    <PlacePicker />
    <Toasts />
    <footer class="foot">
      <div class="wrap foot-in">
        <div class="foot-brand">
          <a class="brand" href="/" aria-label="giro.shop, pagina iniziale" data-astro-prefetch>
            <svg class="mark" viewBox="0 0 32 32" aria-hidden="true">
              <rect x="1" y="1" width="30" height="30" rx="9"></rect>
              <path class="glyph" d="M5.5 23.5L11.5 12L16 19L20.5 12L26.5 23.5"></path>
            </svg>
            <span class="wordmark">Mercatino <span class="tld">Ticino</span></span>
          </a>
          <p>Compra e vendi in Ticino.</p>
        </div>
        <nav class="foot-nav" aria-label="Piè di pagina">
          {
            footerNav.map((group) => (
              <div class="foot-col">
                <h2 class="label">{group.title}</h2>
                <ul>
                  {group.links.map((link) => (
                    <li>
                      <a href={link.href} aria-current={path === link.href ? 'page' : undefined}>
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </nav>
        <div class="foot-legal">
          <p>© {year} giro.shop</p>
          <ThemeSwitch />
        </div>
      </div>
    </footer>
    <script>
      import { initRail } from '../lib/rail.ts';
      import { initMotion, rememberMenu } from '../lib/motion.ts';
      initRail();
      initMotion();
      rememberMenu();
    </script>
  </body>
</html>
