---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Compra e vendi in Ticino: annunci da una foto, ricerca a parole tue, connettore per assistenti AI.',
} = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: '/cerca', label: 'Cerca' },
  { href: '/connetti', label: 'Assistente AI' },
];
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@300..700&family=Instrument+Sans:wght@400..600&family=Martian+Mono:wght@400..500&display=swap"
    />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0b0c" media="(prefers-color-scheme: dark)" />
  </head>
  <body>
    <header class="top">
      <div class="wrap top-in">
        <a class="brand" href="/" aria-label="Piazza, pagina iniziale">
          <svg class="mark" viewBox="0 0 32 32" aria-hidden="true">
            <rect x="1" y="1" width="30" height="30" rx="9"></rect>
            <circle class="ring" cx="16" cy="16" r="7.5"></circle>
            <circle class="dot" cx="16" cy="16" r="2.8"></circle>
          </svg>
          <span class="wordmark">piazza</span>
        </a>
        <nav aria-label="Principale">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
          <a class="btn primary" href="/vendi" aria-current={path.startsWith('/vendi') ? 'page' : undefined}>Vendi</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="foot">
      <div class="wrap">
        <span>Piazza · prototipo, annunci di prova</span>
        <span>Nomi, prezzi e annunci sono inventati per provare ricerca, stime e connettore MCP.</span>
      </div>
    </footer>
  </body>
</html>
