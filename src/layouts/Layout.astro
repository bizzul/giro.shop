---
import '../styles/global.css';
import UserMenu from '../components/UserMenu.astro';
import PlacePicker from '../components/PlacePicker.astro';
import Toasts from '../components/Toasts.astro';
import { jsonLdScript } from '../core/seo.ts';
import { siteOrigin } from '../lib/notify.ts';

interface Props {
  title: string;
  description?: string;
  /** Immagine per le anteprime dei link condivisi (Open Graph). */
  image?: string;
  /** Dati strutturati schema.org per i motori di ricerca. */
  jsonLd?: Record<string, unknown>;
  /** "product" per le schede annuncio, "website" per il resto. */
  ogType?: 'website' | 'product';
}

const {
  title,
  description = 'Compra e vendi in Ticino: annunci da una foto, ricerca a parole tue, connettore per assistenti AI.',
  image,
  jsonLd,
  ogType = 'website',
} = Astro.props;
const path = Astro.url.pathname;
// Indirizzo canonico: senza parametri, sull'indirizzo pubblico del sito
const origin = siteOrigin(Astro.url.origin);
const canonical = `${origin}${path}`;
const ogImage = image ? (image.startsWith('http') ? image : `${origin}${image}`) : undefined;
const summary = description.length > 200 ? `${description.slice(0, 197)}…` : description;
const nav = [
  { href: '/cerca', label: 'Cerca' },
  { href: '/connetti', label: 'Assistente AI' },
];
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={summary} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="giro.shop" />
    <meta property="og:locale" content="it_CH" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={summary} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    {jsonLd && <script type="application/ld+json" set:html={jsonLdScript(jsonLd)} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@300..700&family=Instrument+Sans:wght@400..600&family=Martian+Mono:wght@400..500&display=swap"
    />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0b0c" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Su telefono la barra dei comandi va dal lato del pollice: per chi è mancino a sinistra.
      // Si legge prima del disegno, così non salta da una parte all'altra (chiave come in core/hand.ts).
      try {
        if (localStorage.getItem('giro:mano') === 'sinistra') document.documentElement.dataset.mano = 'sinistra';
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#contenuto">Vai al contenuto</a>
    <header class="top">
      <div class="wrap top-in">
        <a class="brand" href="/" aria-label="giro.shop, pagina iniziale">
          <svg class="mark" viewBox="0 0 32 32" aria-hidden="true">
            <rect x="1" y="1" width="30" height="30" rx="9"></rect>
            <g class="arrow">
              <circle cx="15" cy="13" r="5.6"></circle>
              <path d="M20.6 13V20a5 5 0 0 1-5 5H11.5"></path>
              <path d="M14 22.4L11.5 25L14 27.6"></path>
            </g>
          </svg>
          <span class="wordmark">giro<span class="tld">.shop</span></span>
        </a>
        <nav aria-label="Principale">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class={item.href === '/cerca' ? 'nav-search' : 'nav-ai'}
                aria-current={path.startsWith(item.href) ? 'page' : undefined}
              >
                {item.href === '/cerca' && (
                  <svg class="nav-ico" viewBox="0 0 16 16" aria-hidden="true">
                    <circle cx="7" cy="7" r="5" />
                    <path d="M11 11l3.5 3.5" />
                  </svg>
                )}
                <span class="nav-text">{item.label}</span>
              </a>
            ))
          }
          <UserMenu server:defer>
            <span slot="fallback" class="nav-ghost" aria-hidden="true">Accedi</span>
          </UserMenu>
          <a class="btn primary nav-sell" href="/vendi" aria-current={path.startsWith('/vendi') ? 'page' : undefined}>
            <svg class="rail-ico" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M8 2.5v11M2.5 8h11" />
            </svg>
            <span class="rail-text">Vendi</span>
          </a>
        </nav>
      </div>
    </header>
    <main id="contenuto">
      <slot />
    </main>
    <PlacePicker />
    <Toasts />
    <footer class="foot">
      <div class="wrap">
        <span>
          giro.shop · prototipo, annunci di prova · <a href="/sicurezza">Comprare e vendere sicuri</a> · <a href="/privacy">Privacy</a> ·{' '}
          <a href="/condizioni">Condizioni d'uso</a>
        </span>
        <span>Nomi, prezzi e annunci sono inventati per provare ricerca, stime e connettore MCP.</span>
      </div>
    </footer>
    <script>
      import { initRail } from '../lib/rail.ts';
      initRail();
    </script>
  </body>
</html>
