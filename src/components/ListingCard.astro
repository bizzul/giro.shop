---
import type { Listing, PriceVerdict } from '../core/types.ts';
import CategoryIcon from './CategoryIcon.astro';
import { getComune } from '../core/comuni.ts';
import { getPhoto } from '../core/store.ts';
import { formatKm, isNew, priceText, VERDICT_LABEL } from '../core/format.ts';
import { listingPath } from '../core/seo.ts';

interface Props {
  listing: Listing;
  distanceKm?: number;
  reasons?: string[];
  verdict?: PriceVerdict;
  /** Le prime card visibili si caricano subito, le altre quando servono. */
  eager?: boolean;
  /** Posizione nella griglia (o nella pagina aggiunta): le card entrano una dopo l'altra. */
  index?: number;
}

const { listing, distanceKm, reasons = [], verdict, eager = false, index } = Astro.props;
const comune = getComune(listing.comuneId);
const photo = getPhoto(listing.id);
const verdictTone = verdict === 'sopra_mercato' ? 'bad' : 'ok';
// Al massimo due badge sulla foto, in ordine di importanza.
const promoted = listing.promotedUntil != null && new Date(listing.promotedUntil) > new Date();
const badges = [
  promoted && { tone: 'volt', label: 'In vetrina' },
  listing.priceChf === 0 && { tone: 'volt', label: 'Regalo' },
  isNew(listing.publishedAt) && { tone: 'sun', label: 'Nuovo oggi' },
  verdict && listing.priceChf > 0 && { tone: verdictTone, label: VERDICT_LABEL[verdict] },
  listing.negotiable && { tone: 'plain', label: 'Trattabile' },
]
  .filter((b): b is { tone: string; label: string } => Boolean(b))
  .slice(0, 2);
---

<a class="lcard" href={listingPath(listing)} data-lat={comune?.lat} data-lon={comune?.lon} style={index ? `--i:${index}` : undefined}>
  <div class="lph">
    {
      badges.length > 0 && (
        <div class="badges">
          {badges.map((b) => (
            <span class={`badge ${b.tone}`}>{b.label}</span>
          ))}
        </div>
      )
    }
    {
      photo ? (
        <img
          src={photo.srcSmall}
          srcset={`${photo.srcSmall} 480w, ${photo.src} ${photo.width}w`}
          sizes="(max-width: 560px) 50vw, 360px"
          width="480"
          height="360"
          alt={listing.title}
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
        />
      ) : (
        <CategoryIcon category={listing.category} />
      )
    }
  </div>
  <div class="lb">
    <span class="lrow">
      <span class="lprice">{priceText(listing)}</span>
      {
        listing.negotiating ? (
          <span class="lstate sun">In trattativa</span>
        ) : (
          <span class="lstate ok" title="Disponibile">
            <span class="sr">Disponibile</span>
          </span>
        )
      }
    </span>
    <span class="ltitle">{listing.title}</span>
    <span class="lmeta">
      {comune?.name}{distanceKm != null ? ` · ${formatKm(distanceKm)}` : <span data-dist />}
    </span>
    {
      reasons.length > 0 && (
        <span class="lwhy">
          <span class="ai-mark sm" />
          {reasons.join(' · ')}
        </span>
      )
    }
  </div>
</a>
