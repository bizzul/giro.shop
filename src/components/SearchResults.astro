---
import ListingCard from './ListingCard.astro';
import { browseListings, search, type SortOrder } from '../core/search.ts';
import { priceVerdict } from '../core/price.ts';
import { getComune } from '../core/comuni.ts';
import { meaningFor } from '../lib/semantic.ts';

interface Props {
  q: string;
  /** "home": a campo vuoto prima gli ultimi 8 annunci; "cerca": tutti. Poi altri scorrendo, a pagine. */
  mode: 'home' | 'cerca';
  sort?: SortOrder;
  /** Quanti annunci mostrare dall'inizio (es. /cerca?n=48 dopo aver scorso due pagine). */
  n?: number;
  /** Solo la pagina che parte da qui: la griglia la aggiunge in fondo mentre si scorre (/risultati?inizio=24). */
  start?: number;
  /** Comune di chi cerca (scelto nel browser), per "Più vicini a te". */
  from?: string;
}

/** Annunci per pagina: si divide bene in 2, 3 e 4 colonne. */
const PAGE = 24;
/** Nella home, a campo vuoto, la prima pagina è più corta: sotto ci sono altre sezioni. */
const HOME_FIRST = 8;
/** Oltre non si va, nemmeno scorrendo. */
const MAX = 480;

const { q, mode, sort, n, start: startProp, from: fromParam } = Astro.props;
const from = fromParam && getComune(fromParam) ? fromParam : undefined;
const first = mode === 'home' && !q ? HOME_FIRST : PAGE;
const start = startProp && startProp > 0 ? Math.min(Math.floor(startProp), MAX) : 0;
const limit = start ? Math.min(start + PAGE, MAX) : Math.min(Math.max(first, n ?? first), MAX);
// Anche per significato ("sofà" → divano), se il modello locale è pronto; altrimenti solo per parole
const meaning = q ? await meaningFor(q) : null;
const result = q ? search(q, { sort, limit, from, meaning: meaning ?? undefined }) : null;
const onlyByMeaning = Boolean(result && result.total > 0 && result.byMeaning === result.total);
const browse = result ? null : browseListings(sort, limit, from);
const total = result?.total ?? browse?.total ?? 0;
const shown = result?.hits.length ?? browse?.listings.length ?? 0;

// Ordini sensati per questa ricerca: "più vicini" solo se la frase nomina un luogo
// Con un luogo nella frase le distanze partono da lì; altrimenti dal comune di chi cerca, se l'ha scelto
const placeInQuery = Boolean(result?.filters.comuneId);
const nearLabel = placeInQuery ? 'Più vicini' : from ? 'Più vicini a te' : null;
const nearOption = (nearLabel ? [['vicini', nearLabel]] : []) as Array<[SortOrder, string]>;
const orders: Array<[SortOrder | '', string]> = result
  ? [['', 'Pertinenza'], ...nearOption, ['recenti', 'Più recenti'], ['prezzo', 'Prezzo crescente'], ['prezzo-desc', 'Prezzo decrescente']]
  : [['', 'Più recenti'], ...nearOption, ['prezzo', 'Prezzo crescente'], ['prezzo-desc', 'Prezzo decrescente']];
const selected = orders.some(([v]) => v && v === sort) ? sort : '';
const showSort = total > 1 && !(mode === 'home' && !result);

// Altri annunci scorrendo: il JavaScript chiede la pagina dopo (/risultati?inizio=…) e l'aggiunge in fondo.
// Senza JavaScript "Mostra altri" è un link vero, che ricarica /cerca con più annunci.
const params = (extra: Record<string, string>) => {
  const p = new URLSearchParams();
  if (q) p.set('q', q);
  if (selected) p.set('ordine', selected);
  if (from) p.set('da', from);
  for (const [k, v] of Object.entries(extra)) p.set(k, v);
  return p.toString();
};
const moreHref = `/cerca?${params({ n: String(shown + PAGE) })}`;
const nextPage = `/risultati?${params({ vista: mode, inizio: String(shown) })}`;
// L'indirizzo di /cerca con gli annunci caricati finora: ricaricando o tornando indietro si ritrovano
const hereQuery = params(shown > PAGE ? { n: String(shown) } : {});
const hereUrl = hereQuery ? `/cerca?${hereQuery}` : '/cerca';
const hasMore = shown < total && shown < MAX;
const hits = result ? result.hits.slice(start) : [];
const listings = browse ? browse.listings.slice(start) : [];
const chipHref = (text: string) => (text ? `/cerca?q=${encodeURIComponent(text)}` : '/cerca');
---

{
  start > 0 ? (
    <>
      <div class="cards">
        {hits.map((h) => (
          <ListingCard listing={h.listing} distanceKm={placeInQuery ? h.distanceKm : undefined} reasons={h.reasons} verdict={h.verdict} />
        ))}
        {listings.map((l) => (
          <ListingCard listing={l} verdict={priceVerdict(l)} />
        ))}
      </div>
      {hasMore ? (
        <div class="more" data-more data-url={hereUrl}>
          <span class="muted">
            {shown} di {total}
          </span>
          <a class="btn" href={moreHref} data-page={nextPage}>
            <span class="idle">Mostra altri {Math.min(PAGE, total - shown)}</span>
            <span class="busy">Carico altri annunci…</span>
          </a>
        </div>
      ) : (
        <p class="more-end muted" data-url={hereUrl}>
          {total === 1 ? 'Hai visto l\'unico annuncio.' : `Hai visto tutti i ${total} annunci.`}
        </p>
      )}
    </>
  ) : (
  <>
{
  result && result.chips.length > 0 && (
    <div class="understood">
      <span class="label">Ho capito così</span>
      <div class="chips">
        {result.chips.map((c) =>
          c.without != null ? (
            <a class="chip removable" href={chipHref(c.without)} data-q={c.without} aria-label={`Togli il filtro ${c.key}: ${c.value}`}>
              <span class="k">{c.key}</span>
              {c.value}
              <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 3l6 6M9 3l-6 6" /></svg>
            </a>
          ) : (
            <span class="chip">
              <span class="k">{c.key}</span>
              {c.value}
            </span>
          ),
        )}
      </div>
    </div>
  )
}

<div class="bar">
  {
    result ? (
      <p class="count">
        <span data-status>
          {total === 0 ? 'Nessun annuncio corrisponde.' : <b>{total === 1 ? '1 annuncio' : `${total} annunci`}</b>}
          {onlyByMeaning && <span class="muted"> con lo stesso significato: nessuno usa proprio queste parole</span>}
        </span>
        {total > 0 && (
          <a class="save-search" href={`/salvati/nuova?q=${encodeURIComponent(q)}`}>
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 11.5V7a4 4 0 0 1 8 0v4.5l1 1H3z" /><path d="M6.5 14a1.5 1.5 0 0 0 3 0" /></svg>
            Avvisami per i prossimi
          </a>
        )}
      </p>
    ) : (
      <div class="browse-h">
        <h2 data-status>
          {mode === 'home' ? 'Ultimi annunci' : 'Tutti gli annunci'}
          {mode === 'cerca' && <span class="muted"> · {total}</span>}
        </h2>
        {mode === 'home' && <a href="/cerca">Tutti gli annunci</a>}
      </div>
    )
  }
  <button class="place-btn" type="button" data-place-open>
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 14.5s4.5-4.2 4.5-8a4.5 4.5 0 0 0-9 0c0 3.8 4.5 8 4.5 8z" /><circle cx="8" cy="6.5" r="1.6" /></svg>
    <span data-place-label>Distanze da te</span>
  </button>
  {
    showSort && (
      <label class="sort">
        <span class="muted">Ordina per</span>
        <select name="ordine" form="ricerca">
          {orders.map(([value, label]) => (
            <option value={value} selected={value === selected}>
              {label}
            </option>
          ))}
        </select>
      </label>
    )
  }
</div>

{
  shown > 0 ? (
    <div class="cards">
      {hits.map((h, i) => (
        <ListingCard listing={h.listing} distanceKm={placeInQuery ? h.distanceKm : undefined} reasons={h.reasons} verdict={h.verdict} eager={i < 4} />
      ))}
      {listings.map((l, i) => <ListingCard listing={l} verdict={priceVerdict(l)} eager={i < 4} />)}
    </div>
  ) : (
    result && (
      <div class="panel empty">
        <h3>Ancora niente, ma può arrivare.</h3>
        <p class="muted">
          Salva la ricerca: ti scriviamo, qui e per email, appena qualcuno pubblica un annuncio che corrisponde. Intanto prova a
          togliere un filtro o ad allargare la zona.
        </p>
        <a class="btn primary" href={`/salvati/nuova?q=${encodeURIComponent(q)}`}>Avvisami quando arriva</a>
      </div>
    )
  )
}

{
  hasMore && (
    <div class="more" data-more data-url={hereUrl}>
      <span class="muted">
        {shown} di {total}
      </span>
      <a class="btn" href={moreHref} data-page={nextPage}>
        <span class="idle">Mostra altri {Math.min(PAGE, total - shown)}</span>
        <span class="busy">Carico altri annunci…</span>
      </a>
    </div>
  )
}
  </>
  )
}

<script>
  // Chip "togli filtro" e altri annunci scorrendo (o con "Mostra altri") dentro i risultati dal vivo.
  // Il blocco dei risultati viene sostituito a ogni ricerca: si ascolta sul documento.
  let refocus: 'chips' | null = null;

  /** Caricamenti in corso, per riquadro "altri": un clic durante uno scorrimento aspetta quello. */
  const pending = new WeakMap<HTMLElement, Promise<HTMLElement[]>>();

  /**
   * Aggiunge in fondo alla griglia la pagina dopo. `byHand`: "Mostra altri" toccato (o Invio),
   * allora il fuoco va sul primo annuncio nuovo; scorrendo invece resta dov'è.
   */
  async function loadMore(box: HTMLElement, byHand: boolean) {
    // Dopo un errore si riprova solo a mano, non a ogni scorrimento
    if (!byHand && box.dataset.failed != null) return;
    let load = pending.get(box);
    if (!load) {
      load = fetchPage(box, byHand);
      pending.set(box, load);
    }
    const fresh = await load;
    if (byHand) fresh[0]?.focus({ preventScroll: true });
  }

  async function fetchPage(box: HTMLElement, byHand: boolean): Promise<HTMLElement[]> {
    const link = box.querySelector<HTMLAnchorElement>('a[data-page]');
    const results = box.closest<HTMLElement>('.results');
    const cards = results?.querySelector<HTMLElement>('.cards');
    if (!link || !results || !cards) return [];
    box.dataset.loading = '';
    box.setAttribute('aria-busy', 'true');
    const res = await fetch(link.dataset.page ?? '').catch(() => null);
    const html = res?.ok ? await res.text().catch(() => null) : null;
    if (!box.isConnected) return []; // nel frattempo è partita un'altra ricerca
    if (html == null) {
      delete box.dataset.loading;
      box.removeAttribute('aria-busy');
      box.dataset.failed = '';
      pending.delete(box);
      if (byHand) location.href = link.href;
      return [];
    }
    const page = document.createElement('template');
    page.innerHTML = html;

    // Se nel frattempo è arrivato un annuncio nuovo l'ordine scala di uno: niente doppioni
    const seen = new Set([...cards.querySelectorAll('a.lcard')].map((a) => a.getAttribute('href')));
    const fresh = [...page.content.querySelectorAll<HTMLElement>('.cards > a.lcard')].filter((a) => !seen.has(a.getAttribute('href')));
    const next = page.content.querySelector<HTMLElement>('[data-more], .more-end');
    // Gli annunci nuovi compaiono dove si sta guardando: senza questo Chrome resterebbe "agganciato"
    // al piè di pagina e li metterebbe sopra lo schermo, se si è già arrivati in fondo
    // Chi era sul bottone con la tastiera non deve perdere il fuoco quando il bottone se ne va
    const hadFocus = box.contains(document.activeElement);
    const root = document.documentElement;
    root.style.overflowAnchor = 'none';
    cards.append(...fresh);
    if (next) box.replaceWith(next);
    else box.remove();
    void root.offsetHeight;
    root.style.removeProperty('overflow-anchor');

    if (location.pathname === '/cerca' && next?.dataset.url) history.replaceState(null, '', next.dataset.url);
    const status = document.getElementById('risultati-stato');
    const count = cards.querySelectorAll('a.lcard').length;
    if (status) status.textContent = next?.matches('.more-end') ? (next.textContent?.trim() ?? '') : `${count} annunci caricati`;
    // Distanze da te e simili si ridisegnano anche sugli annunci nuovi
    results.dispatchEvent(new CustomEvent('results:update', { bubbles: true }));
    if (hadFocus) fresh[0]?.focus({ preventScroll: true });
    return fresh;
  }

  // Scorrendo: la pagina dopo parte quando il fondo della griglia è a meno di uno schermo e mezzo
  // (o è già passato, con uno scorrimento lungo). Solo dopo che la persona ha iniziato a scorrere:
  // la home non si allunga da sola appena aperta.
  const AHEAD = 900;
  let scrolled = scrollY > 0;
  let frame = 0;
  const check = () => {
    frame = 0;
    if (!scrolled) return;
    for (const box of document.querySelectorAll<HTMLElement>('.results [data-more]')) {
      if (box.getBoundingClientRect().top < innerHeight + AHEAD) loadMore(box, false);
    }
  };
  const schedule = () => {
    frame ||= requestAnimationFrame(check);
  };
  addEventListener(
    'scroll',
    () => {
      scrolled = true;
      schedule();
    },
    { passive: true },
  );
  addEventListener('resize', schedule);
  // Dopo una pagina in più (o una nuova ricerca dal vivo) si guarda se ne serve subito un'altra
  document.addEventListener('results:update', schedule);

  document.addEventListener('click', async (event) => {
    const target = event.target as Element;

    const chip = target.closest<HTMLAnchorElement>('.results a[data-q]');
    const input = document.querySelector<HTMLInputElement>('form[data-live] input[name="q"]');
    if (chip && input) {
      event.preventDefault();
      input.value = chip.dataset.q ?? '';
      // Dopo l'aggiornamento il chip non c'è più: il fuoco va sul primo chip rimasto
      refocus = 'chips';
      input.dispatchEvent(new Event('input', { bubbles: true }));
      return;
    }

    const more = target.closest<HTMLAnchorElement>('.results a[data-page]');
    const box = more?.closest<HTMLElement>('[data-more]');
    if (!more || !box) return;
    event.preventDefault();
    loadMore(box, true);
  });

  document.addEventListener('results:update', (event) => {
    if (refocus !== 'chips') return;
    refocus = null;
    const results = event.target as HTMLElement;
    const next = results.querySelector<HTMLElement>('.chip.removable') ?? results.querySelector<HTMLElement>('[data-status]');
    if (next && !next.matches('a')) next.tabIndex = -1;
    next?.focus({ preventScroll: true });
  });
</script>

<style>
  .understood { display: grid; gap: 10px; margin-bottom: 24px; }
  .removable { text-decoration: none; cursor: pointer; align-items: center; }
  .removable svg { width: 10px; height: 10px; margin-left: 2px; stroke: var(--muted); stroke-width: 1.6; stroke-linecap: round; fill: none; }
  .removable:hover { border-color: var(--ink); }
  .removable:hover svg { stroke: var(--ink); }
  .bar { display: flex; align-items: baseline; justify-content: space-between; gap: 12px 24px; flex-wrap: wrap; margin-bottom: 24px; }
  .count { display: flex; align-items: baseline; gap: 6px 16px; flex-wrap: wrap; font-size: 14px; }
  .save-search { display: inline-flex; align-items: center; gap: 6px; color: var(--ink); text-underline-offset: 3px; text-decoration-color: var(--line-strong); font-size: 13.5px; }
  .save-search svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linejoin: round; align-self: center; }
  .count b { font-weight: 500; }
  .browse-h { display: flex; align-items: baseline; gap: 16px; flex: 1; justify-content: space-between; }
  .browse-h h2 { font: 500 16px/1.3 var(--f-body); letter-spacing: 0; }
  .browse-h a { color: var(--muted); font-size: 14px; text-underline-offset: 4px; text-decoration-color: var(--line-strong); }
  .browse-h a:hover { color: var(--ink); }
  .sort { display: inline-flex; align-items: baseline; gap: 8px; font-size: 14px; }
  .place-btn { display: inline-flex; align-items: center; gap: 6px; margin-left: auto; border: 0; background: none; padding: 0; color: var(--muted); font: 400 13.5px/1.4 var(--f-body); cursor: pointer; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--line-strong); }
  .place-btn:hover { color: var(--ink); }
  .place-btn svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.5; }
  .sort select {
    font: 500 14px/1.4 var(--f-body);
    color: var(--ink);
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--line-strong);
    border-radius: 0;
    padding: 2px 18px 2px 0;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, currentColor 50%), linear-gradient(135deg, currentColor 50%, transparent 50%);
    background-position: right 5px top 55%, right 0 top 55%;
    background-size: 5px 5px;
    background-repeat: no-repeat;
  }
  .sort select:hover { border-bottom-color: var(--ink); }
  .empty { max-width: 640px; }
  .more, .more-end { display: grid; justify-items: center; gap: 12px; margin-top: 40px; font-size: 14px; text-align: center; }
  /* Mentre arriva la pagina dopo il bottone dice che sta caricando e pulsa piano.
     Resta al suo posto: chi ci era sopra con la tastiera non perde il fuoco */
  .more .busy { display: none; }
  .more[data-loading] .idle { display: none; }
  .more[data-loading] .busy { display: inline; }
  .more[data-loading] .btn { pointer-events: none; border-color: var(--line); animation: breathe 1.2s ease-in-out infinite alternate; }
  @keyframes breathe { from { opacity: 0.4; } to { opacity: 1; } }
</style>
