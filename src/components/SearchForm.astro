---
import SearchSuggest from './SearchSuggest.astro';
import PhotoSearch from './PhotoSearch.astro';

interface Props {
  value?: string;
  autofocus?: boolean;
  /** Id del contenitore dei risultati da aggiornare mentre si scrive. */
  target?: string;
  /** "home" mostra gli ultimi annunci a campo vuoto, "cerca" tutti. */
  mode?: 'home' | 'cerca';
  /** Frasi d'esempio che si scrivono e si cancellano a turno nel campo vuoto. */
  suggestions?: string[];
}

// Frasi d'esempio: corte, così stanno intere anche su telefono; ognuna trova almeno un annuncio
const SUGGESTIONS = [
  'scrivania in legno sotto i 150 franchi',
  'bici per una bimba di 6 anni a Bellinzona',
  "Vespa anni '80 anche da sistemare",
  'sci da 170 cm, zona Airolo',
  'passeggino trio vicino a Locarno',
  'iPhone sotto i 400 franchi a Lugano',
  'poltrona in velluto vicino a Mendrisio',
  'giacca da sci taglia L',
];
const { value = '', autofocus = false, target, mode = 'cerca', suggestions = SUGGESTIONS } = Astro.props;
---

<form id="ricerca" class="search dock" action="/cerca" method="get" role="search" data-bottom-ui data-live={target ? '' : undefined} data-target={target} data-mode={mode}>
  <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="5"></circle><path d="M11 11l3.5 3.5"></path></svg>
  <label class="sr" for="q">Cosa cerchi</label>
  <input
    id="q"
    name="q"
    type="search"
    value={value}
    placeholder="bici per una bimba di 6 anni a Bellinzona"
    autocomplete="off"
    enterkeyhint="search"
    autofocus={autofocus}
    data-suggestions={suggestions?.length ? JSON.stringify(suggestions) : undefined}
  />
  <PhotoSearch />
  <SearchSuggest />
</form>

<script>
  // Ricerca dal vivo: mentre scrivi, il server rimanda solo la griglia dei risultati.
  // Senza JavaScript il form continua a funzionare: Invio apre /cerca?q=…
  // Il menu "Ordina per" sta nei risultati ma appartiene a questo form (attributo form="ricerca").
  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-live]')) {
    const input = form.querySelector<HTMLInputElement>('input[name="q"]');
    const target = document.getElementById(form.dataset.target ?? '');
    const status = document.getElementById(`${form.dataset.target}-stato`);
    const mode = form.dataset.mode ?? 'cerca';
    if (!input || !target) continue;

    let timer: ReturnType<typeof setTimeout> | undefined;
    let controller: AbortController | undefined;

    // q e ordine, senza i valori vuoti: è anche l'indirizzo di /cerca
    const query = () => {
      const params = new URLSearchParams();
      for (const [key, value] of new FormData(form)) {
        const text = String(value).trim();
        if (text) params.set(key, text);
      }
      return params;
    };
    let shown = query().toString();

    const update = async () => {
      const params = query();
      const key = params.toString();
      if (key === shown) return;
      const q = params.get('q') ?? '';
      controller?.abort();
      controller = new AbortController();
      target.setAttribute('aria-busy', 'true');
      try {
        const res = await fetch(`/risultati?vista=${mode}&${key}`, { signal: controller.signal });
        if (!res.ok) throw new Error(String(res.status));
        target.innerHTML = await res.text();
        shown = key;
        if (mode === 'cerca') {
          history.replaceState(null, '', key ? `/cerca?${key}` : '/cerca');
          document.title = q ? `${q} · giro.shop` : 'Cerca · giro.shop';
        }
        if (status) status.textContent = target.querySelector('[data-status]')?.textContent?.trim() ?? '';
        target.dispatchEvent(new CustomEvent('results:update', { bubbles: true }));
      } catch (error) {
        if ((error as Error).name === 'AbortError') return;
        // Se la ricerca dal vivo non risponde, si passa alla pagina dei risultati.
        location.href = key ? `/cerca?${key}` : '/cerca';
      } finally {
        if (!controller.signal.aborted) target.removeAttribute('aria-busy');
      }
    };

    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(update, 180);
    });

    // Cambio di ordine: subito, senza aspettare
    document.addEventListener('change', (event) => {
      const field = event.target as HTMLSelectElement;
      if (field.form !== form || field === (input as unknown)) return;
      clearTimeout(timer);
      update();
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      clearTimeout(timer);
      // Campo vuoto con un suggerimento in vista: Invio cerca proprio quello
      if (!input.value.trim() && input.dataset.current) input.value = input.dataset.current;
      update();
      input.blur();
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }

  // Suggerimenti nel campo vuoto: una frase si scrive lettera per lettera, resta un attimo,
  // si cancella e ne arriva un'altra. Con il campo attivo o pieno si ferma sulla frase intera.
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  for (const input of document.querySelectorAll<HTMLInputElement>('input[data-suggestions]')) {
    const list: string[] = JSON.parse(input.dataset.suggestions ?? '[]');
    if (!list.length) continue;
    let i = Math.floor(Math.random() * list.length);
    let shown = 0;
    let phase: 'type' | 'hold' | 'erase' = 'type';
    let timer: ReturnType<typeof setTimeout> | undefined;

    const show = (text: string) => {
      input.placeholder = text;
    };
    // Ci si ferma solo se il campo l'ha attivato la persona: l'autofocus di /cerca non conta
    let touched = false;
    const paused = () => (touched && document.activeElement === input) || input.value !== '' || document.hidden;

    function step() {
      const text = list[i];
      if (paused()) {
        show(text);
        input.dataset.current = text;
        shown = text.length;
        phase = 'hold';
        return;
      }
      if (phase === 'type') {
        shown += 1;
        show(text.slice(0, shown));
        if (shown >= text.length) {
          input.dataset.current = text;
          phase = 'hold';
          timer = setTimeout(step, 2400);
        } else {
          timer = setTimeout(step, 38 + Math.random() * 45);
        }
      } else if (phase === 'hold') {
        phase = 'erase';
        timer = setTimeout(step, 0);
      } else {
        shown -= 1;
        show(text.slice(0, shown));
        if (shown <= 0) {
          delete input.dataset.current;
          i = (i + 1) % list.length;
          phase = 'type';
          timer = setTimeout(step, 450);
        } else {
          timer = setTimeout(step, 16);
        }
      }
    }

    function start() {
      clearTimeout(timer);
      if (still.matches) {
        show(list[i]);
        input.dataset.current = list[i];
        return;
      }
      timer = setTimeout(step, phase === 'hold' ? 1200 : 300);
    }

    show('');
    shown = 0;
    start();
    const freeze = () => {
      touched = true;
      clearTimeout(timer);
      step();
    };
    input.addEventListener('focus', freeze);
    // Con l'autofocus il campo è già attivo: il primo tocco non genera "focus"
    input.addEventListener('pointerdown', freeze);
    input.addEventListener('blur', () => {
      touched = false;
      start();
    });
    input.addEventListener('input', () => {
      clearTimeout(timer);
      if (input.value === '') start();
    });
    document.addEventListener('visibilitychange', () => (document.hidden ? clearTimeout(timer) : start()));
    still.addEventListener('change', start);
  }

  // Telefono: la barra in basso segue la tastiera. La tastiera rimpicciolisce la parte visibile
  // della pagina (visualViewport) ma non quella su cui sono fissati gli elementi: la differenza
  // è quanto la barra deve salire per restarle sopra.
  const vv = window.visualViewport;
  if (vv && document.querySelector('.search.dock')) {
    const root = document.documentElement;
    const sync = () => {
      const covered = root.clientHeight - vv.height - vv.offsetTop;
      // Pochi pixel sono solo la barra del browser che compare o sparisce, non la tastiera
      const open = covered > 80;
      root.style.setProperty('--kb', open ? `${Math.round(covered)}px` : '0px');
      root.classList.toggle('kb-open', open);
    };
    vv.addEventListener('resize', sync);
    vv.addEventListener('scroll', sync);
    sync();
  }
</script>
