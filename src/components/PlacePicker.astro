---
/**
 * "Da dove parti?": il comune della persona, per mostrare le distanze ("a 3 km da te")
 * e ordinare per vicinanza. Resta solo in questo browser; la posizione GPS serve una volta
 * per trovare il comune più vicino e non viene salvata.
 * Un solo dialogo per pagina (sta nel layout); lo aprono i bottoni con data-place-open.
 */
import ComunePicker from './ComunePicker.tsx';
---

<dialog class="place-dialog" data-place-dialog aria-labelledby="place-title">
  <form method="dialog" class="place-form">
    <h2 id="place-title">Da dove parti?</h2>
    <p class="muted small">Ti mostriamo quanto è lontano ogni annuncio. Il comune resta solo in questo browser.</p>
    <button class="btn" type="button" data-place-locate>
      <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="2.5" /><path d="M8 1.5v2M8 12.5v2M1.5 8h2M12.5 8h2" /><circle cx="8" cy="8" r="5" /></svg>
      Usa la mia posizione
    </button>
    <p class="place-msg small" data-place-msg aria-live="polite"></p>
    <div class="fld">
      <label class="label" for="place-comune">Oppure scrivi il tuo comune</label>
      <ComunePicker client:idle id="place-comune" />
    </div>
    <div class="place-actions">
      <button class="link-button" type="button" data-place-clear>Non mostrare le distanze</button>
      <button class="link-button" value="close">Chiudi</button>
    </div>
  </form>
</dialog>

<script>
  import { COMUNI, distanceKm, getComune, resolveComune } from '../core/comuni.ts';
  import { formatKm } from '../core/format.ts';
  import { toast } from '../lib/toast.ts';

  const KEY = 'giro:zona';
  const read = () => {
    try {
      return getComune(localStorage.getItem(KEY) ?? '') ?? null;
    } catch {
      return null;
    }
  };
  const write = (id: string | null) => {
    try {
      if (id) localStorage.setItem(KEY, id);
      else localStorage.removeItem(KEY);
    } catch {
      /* senza salvataggio vale solo per questa pagina */
    }
  };

  const dialog = document.querySelector<HTMLDialogElement>('[data-place-dialog]');
  const msg = dialog?.querySelector<HTMLElement>('[data-place-msg]');
  // Il campo è un'isola (ComunePicker): si imposta con l'evento "comune:set" e annuncia le scelte con "comune:pick"
  const field = () => dialog?.querySelector<HTMLInputElement>('#place-comune') ?? null;
  const setField = (name: string) => {
    const input = field();
    if (!input) return;
    input.value = name;
    input.dispatchEvent(new CustomEvent('comune:set', { detail: name }));
  };

  /** Distanze sulle schede annuncio e nelle schede della ricerca. */
  function paint() {
    const place = read();
    for (const label of document.querySelectorAll<HTMLElement>('[data-place-label]')) {
      label.textContent = place ? `Distanze da ${place.name}` : 'Distanze da te';
    }
    for (const el of document.querySelectorAll<HTMLElement>('[data-dist]')) {
      const card = el.closest<HTMLElement>('[data-lat]');
      if (!card || !place) {
        el.textContent = '';
        continue;
      }
      const km = distanceKm(place, { lat: Number(card.dataset.lat), lon: Number(card.dataset.lon) } as typeof place);
      el.textContent = ` · ${formatKm(km)} da te`;
    }
    for (const ask of document.querySelectorAll<HTMLElement>('[data-place-ask]')) ask.hidden = Boolean(place);
    // La ricerca dal vivo riceve il comune: serve per "Più vicini a te"
    for (const form of document.querySelectorAll<HTMLFormElement>('form[data-live]')) {
      let input = form.querySelector<HTMLInputElement>('input[name="da"]');
      if (!input) {
        input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'da';
        form.append(input);
      }
      input.value = place?.id ?? '';
    }
  }

  function changed() {
    paint();
    const input = document.querySelector<HTMLInputElement>('form[data-live] input[name="da"]');
    input?.dispatchEvent(new Event('change', { bubbles: true }));
  }

  /** Niente bottone "Usa questo comune": la scelta vale subito, come negli altri moduli. */
  function use(name: string, note?: string) {
    const comune = resolveComune(name);
    if (!comune) return false;
    const before = read()?.id;
    write(comune.id);
    dialog?.close();
    if (before !== comune.id) {
      changed();
      toast(note ?? `Distanze da ${comune.name}`);
    }
    return true;
  }

  document.addEventListener('click', (event) => {
    if (!(event.target as Element).closest('[data-place-open]') || !dialog) return;
    setField(read()?.name ?? '');
    if (msg) msg.textContent = '';
    dialog.returnValue = '';
    dialog.showModal();
  });

  // Clic o Invio su un comune dell'elenco
  dialog?.addEventListener('comune:pick', (event) => use((event as CustomEvent<{ name: string }>).detail.name));
  // Invio con l'elenco chiuso: conferma il comune scritto invece di chiudere il dialogo
  dialog?.addEventListener('keydown', (event) => {
    if (event.key !== 'Enter' || event.defaultPrevented || (event.target as Element).id !== 'place-comune') return;
    event.preventDefault();
    const typed = field()?.value ?? '';
    if (!use(typed) && msg) msg.textContent = typed.trim() ? `«${typed.trim()}» non è un comune dell'elenco.` : 'Scrivi il comune o usa la tua posizione.';
  });
  // Scritto il comune e toccato "Chiudi": vale quel comune (Esc invece annulla)
  dialog?.addEventListener('close', () => {
    if (dialog.returnValue !== 'close') return;
    const typed = field()?.value ?? '';
    if (typed && resolveComune(typed)?.id !== read()?.id) use(typed);
  });

  dialog?.querySelector('[data-place-clear]')?.addEventListener('click', () => {
    const had = Boolean(read());
    write(null);
    dialog.close('clear');
    if (had) {
      changed();
      toast('Distanze nascoste');
    }
  });
  dialog?.querySelector('[data-place-locate]')?.addEventListener('click', () => {
    if (!navigator.geolocation) {
      if (msg) msg.textContent = 'Questo browser non dà la posizione: scrivi il comune.';
      return;
    }
    if (msg) msg.textContent = 'Cerco la tua posizione…';
    navigator.geolocation.getCurrentPosition(
      (pos) => {
        const here = { lat: pos.coords.latitude, lon: pos.coords.longitude } as (typeof COMUNI)[number];
        const nearest = [...COMUNI].sort((a, b) => distanceKm(here, a) - distanceKm(here, b))[0];
        const far = distanceKm(here, nearest) > 40;
        setField(nearest.name);
        use(nearest.name, far ? `Sei lontano dal Ticino: distanze da ${nearest.name}, il comune più vicino` : `Distanze da ${nearest.name}, vicino a te`);
      },
      () => {
        if (msg) msg.textContent = 'Posizione non disponibile: scrivi il comune.';
      },
      { timeout: 10000, maximumAge: 600000 },
    );
  });

  paint();
  document.addEventListener('results:update', paint);
</script>

<style>
  /* overflow visibile: l'elenco dei comuni esce dal dialogo invece di restare tagliato */
  .place-dialog { overflow: visible; border: 0; border-radius: 8px; padding: 0; width: min(420px, calc(100vw - 32px)); background: var(--bg); color: var(--ink); box-shadow: var(--shadow-search); }
  .place-dialog::backdrop { background: rgba(0, 0, 0, 0.45); }
  .place-form { display: grid; gap: 14px; padding: 24px; }
  .place-form h2 { font: 500 20px/1.3 var(--f-body); letter-spacing: -0.01em; }
  .place-form .btn svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.5; }
  .place-msg:empty { display: none; }
  .fld { display: grid; gap: 8px; }
  .fld > .label { justify-self: start; }
  .place-actions { display: flex; align-items: center; gap: 12px 18px; flex-wrap: wrap; }
</style>
