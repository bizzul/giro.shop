---
import type { CategoryId } from '../core/types.ts';
import { getCategory } from '../core/categories.ts';
import { iconPath } from '../lib/category-icons.ts';

interface Props {
  category: CategoryId;
}

const { category } = Astro.props;
const d = iconPath(getCategory(category).icon);
---

<svg class="ico" viewBox="0 0 64 64" aria-hidden="true">
  <path d={d}></path>
</svg>
