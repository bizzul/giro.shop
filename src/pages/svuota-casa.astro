---
import Layout from '../layouts/Layout.astro';
import HouseForm from '../components/HouseForm.tsx';
import { claudeKey } from '../lib/claude.ts';
import { MAX_HOUSE_PHOTOS } from '../core/house.ts';
import '../styles/sell.css';

const signedIn = Boolean(Astro.locals.user);
const aiOn = Boolean(claudeKey());
---

<Layout title="Svuota casa · giro.shop" description="Trasloco, cantina, eredità: foto delle stanze e una bozza per ogni oggetto, da pubblicare in un colpo.">
  <section class="wrap band sell">
    <div class="intro">
      <p class="eyebrow">Svuota casa</p>
      <h1>Tante cose, una volta sola.</h1>
      <p class="muted">
        {
          aiOn
            ? `Trasloco, cantina, eredità: carica fino a ${MAX_HOUSE_PHOTOS} foto delle stanze. L'assistente trova gli oggetti che si possono vendere, ritaglia ognuno dalla foto e propone titolo e prezzo. Tu scegli cosa pubblicare.`
            : `Trasloco, cantina, eredità: carica fino a ${MAX_HOUSE_PHOTOS} foto, una per oggetto, e scrivi sotto cos'è. Diventano annunci da controllare e pubblicare in un colpo.`
        }
      </p>
      {!signedIn && (
        <p class="small">
          Puoi preparare le bozze subito; per pubblicarle <a href="/accedi?next=/svuota-casa">accedi con la tua email</a>.
        </p>
      )}
      <p class="small">Un oggetto solo? <a href="/vendi">Scatta e vendi</a> è più veloce.</p>
    </div>
    <HouseForm client:load signedIn={signedIn} aiOn={aiOn} max={MAX_HOUSE_PHOTOS} />
  </section>
</Layout>

<style>
  .sell { display: grid; gap: 40px; max-width: 860px; }
  .intro { display: grid; gap: 16px; }
  .intro h1 { font-size: clamp(32px, 4.4vw, 48px); }
</style>
