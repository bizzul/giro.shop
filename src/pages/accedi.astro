---
import Layout from '../layouts/Layout.astro';
import { actions, isInputError } from 'astro:actions';
import { safeNext } from '../actions/account.ts';
import { passkeysEnabled, supabaseConfigured } from '../lib/supabase.ts';
import '../styles/sell.css';

const next = safeNext(Astro.url.searchParams.get('next'));
if (Astro.locals.user) return Astro.redirect(next);
// Passkey facoltative: il bottone compare solo se Supabase le accetta e (dallo script) se il browser le sa usare
const passkeys = await passkeysEnabled();

const result = Astro.getActionResult(actions.account.sendMagicLink);
const emailError = result?.error && isInputError(result.error) ? result.error.fields.email?.[0] : undefined;
const linkFailed = Astro.url.searchParams.has('errore');
const deleted = Astro.url.searchParams.has('eliminato');
---

<Layout title="Accedi · giro.shop" description="Entra in giro.shop con un link via email, senza password.">
  <section class="wrap band auth">
    {
      result?.data ? (
        <div class="panel">
          <span class="label">Controlla la posta</span>
          <h1>Ti abbiamo mandato un link.</h1>
          <p class="muted">
            Apri l'email inviata a <b>{result.data.email}</b> e tocca il link per entrare. Vale un'ora; aprilo nello stesso browser
            da cui l'hai chiesto.
          </p>
          {import.meta.env.DEV && (
            <p class="small">
              In sviluppo le email non partono davvero: le trovi in Mailpit, su{' '}
              <a href="http://127.0.0.1:54324" target="_blank" rel="noopener">127.0.0.1:54324</a>.
            </p>
          )}
        </div>
      ) : (
        <form class="panel sellform" method="POST" action={actions.account.sendMagicLink}>
          <span class="label">Accedi o crea un account</span>
          <h1>Entra con la tua email.</h1>
          <p class="muted">Niente password: ti mandiamo un link. Se è la prima volta, l'account si crea da solo.</p>
          <p class="small">
            Entrando accetti le <a href="/condizioni">condizioni d'uso</a>. Come trattiamo i tuoi dati lo spiega l'<a href="/privacy">informativa sulla privacy</a>.
          </p>
          {linkFailed && <p class="error">Il link non è valido o è scaduto. Chiedine uno nuovo.</p>}
          {deleted && <p class="notice" role="status">Il tuo account è stato eliminato, con tutti i suoi dati. Grazie di aver usato giro.shop.</p>}
          {result?.error && !emailError && <p class="error">{result.error.message}</p>}
          {!supabaseConfigured() && <p class="error">Supabase non è configurato: manca PUBLIC_SUPABASE_URL nel file .env.</p>}
          <label class="fld">
            <span class="label">Email</span>
            <input id="email" name="email" type="email" autocomplete="email" inputmode="email" required placeholder="nome@esempio.ch" />
            {emailError && <small class="error-text">{emailError}</small>}
          </label>
          <input type="hidden" name="next" value={next} />
          <button class="btn primary" type="submit" disabled={!supabaseConfigured()}>Mandami il link</button>
          {passkeys && (
            <div class="passkey-login" data-next={next} hidden>
              <span class="or" aria-hidden="true">oppure</span>
              <button class="btn" type="button">
                <svg viewBox="0 0 16 16" aria-hidden="true">
                  <circle cx="6" cy="5" r="2.75" />
                  <path d="M1.5 14a4.5 4.5 0 0 1 7-3.75" />
                  <circle cx="12" cy="8.5" r="1.75" />
                  <path d="M12 10.25V14.5l1-1-1-1 1-1" />
                </svg>
                Entra con una passkey
              </button>
              <p class="small muted">Se ne hai aggiunta una dal tuo account: impronta, viso o PIN del dispositivo, senza aspettare l'email.</p>
              <p class="error" role="alert" hidden></p>
            </div>
          )}
        </form>
      )
    }
  </section>
</Layout>

<script>
  // Accesso con passkey: sfida dal server, firma del dispositivo, sessione aperta dal server (src/actions/passkeys.ts)
  import { actions } from 'astro:actions';
  import { credentialToJSON, isCancel, passkeysSupported, requestOptionsFromJSON } from '../lib/webauthn.ts';

  const box = document.querySelector<HTMLElement>('.passkey-login');
  const button = box?.querySelector('button');
  const errorBox = box?.querySelector<HTMLElement>('.error');
  if (box && button && errorBox && passkeysSupported()) {
    box.hidden = false;
    const showError = (message: string) => {
      errorBox.textContent = message;
      errorBox.hidden = !message;
    };
    button.addEventListener('click', async () => {
      showError('');
      button.disabled = true;
      let signedIn = false;
      try {
        const start = await actions.passkeys.loginOptions();
        if (start.error) return showError(start.error.message);
        const credential = (await navigator.credentials.get({ publicKey: requestOptionsFromJSON(start.data.options) })) as PublicKeyCredential | null;
        if (!credential) return;
        const result = await actions.passkeys.login({ challengeId: start.data.challengeId, credential: credentialToJSON(credential) });
        if (result.error) return showError(result.error.message);
        signedIn = true;
        button.textContent = 'Entro…';
        location.assign(box.dataset.next || '/miei-annunci');
      } catch (error) {
        if (!isCancel(error)) showError('Questo dispositivo non è riuscito a usare la passkey. Entra con il link via email.');
      } finally {
        // Dopo l'accesso il bottone resta fermo finché la pagina cambia
        if (!signedIn) button.disabled = false;
      }
    });
  }
</script>

<style>
  .auth { max-width: 560px; }
  .auth h1 { font-size: clamp(28px, 3.6vw, 40px); }
  .auth .fld { width: 100%; }
  .error-text { color: var(--bad); }
  .passkey-login { display: grid; gap: 10px; justify-items: start; width: 100%; }
  .passkey-login[hidden] { display: none; }
  .passkey-login .or { display: flex; align-items: center; gap: 12px; width: 100%; font-size: 13px; color: var(--muted); }
  .passkey-login .or::before,
  .passkey-login .or::after { content: ''; flex: 1; border-top: 1px solid var(--line); }
  .passkey-login .btn { display: inline-flex; align-items: center; gap: 10px; }
  .passkey-login svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
</style>
