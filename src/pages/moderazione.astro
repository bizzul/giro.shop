---
/**
 * Moderazione, solo per chi modera:
 * - segnalazioni aperte, raggruppate per contenuto, con la proposta dell'agente quando c'è;
 * - registro delle decisioni (dell'agente e delle persone), ognuna si può annullare.
 */
import Layout from '../layouts/Layout.astro';
import { actions } from 'astro:actions';
import { adminClient } from '../lib/admin.ts';
import { claudeKey } from '../lib/claude.ts';
import { allowedDecisions, parseTarget, type TargetKind } from '../lib/moderation.ts';
import { REPORT_REASONS, type ReportReason } from '../core/rules.ts';
import { formatAge, formatChf } from '../core/format.ts';

const { user, supabase } = Astro.locals;
if (!user || !supabase) return Astro.redirect('/accedi?next=/moderazione');
const { data: me } = await supabase.from('profiles').select('is_moderator').eq('id', user.id).maybeSingle();
const admin = adminClient();
if (!me?.is_moderator || !admin) return new Response('Pagina non trovata', { status: 404 });

const decided = Astro.getActionResult(actions.moderation.decide);
const undone = Astro.getActionResult(actions.moderation.undo);
const asked = Astro.getActionResult(actions.moderation.askAgent);
const appealed = Astro.getActionResult(actions.moderation.decideAppeal);
if (appealed?.data) return Astro.redirect(`/moderazione?fatto=contestazione-${appealed.data.decision}#contestazioni`, 303);
if (decided?.data) return Astro.redirect(`/moderazione?fatto=${decided.data.decision}`, 303);
if (undone?.data) return Astro.redirect('/moderazione?fatto=annulla#registro', 303);
if (asked?.data) return Astro.redirect(`/moderazione?fatto=agente-${asked.data.action}`, 303);
const error = [decided, undone, asked, appealed].find((r) => r?.error)?.error?.message;
const done = Astro.url.searchParams.get('fatto');
const NOTICE: Record<string, string> = {
  nascondi: 'Nascosto: chi ha segnalato e chi ha pubblicato sono stati avvisati.',
  sospendi: "Account sospeso: i suoi annunci sono nascosti e la persona è stata avvisata.",
  respingi: 'Segnalazioni respinte.',
  annulla: 'Decisione annullata: contenuto o account ripristinati, e le persone coinvolte avvisate.',
  'agente-nascondi': "L'agente ha nascosto il contenuto.",
  'agente-respingi': "L'agente ha respinto le segnalazioni.",
  'agente-passa': "L'agente ha lasciato una proposta: decidi tu.",
  'contestazione-accogli': 'Contestazione accolta: la decisione è annullata e la persona è stata avvisata.',
  'contestazione-respingi': 'Contestazione respinta: la persona ha ricevuto la tua risposta.',
};
const agentOn = Boolean(claudeKey());

interface ReportRow {
  target: string;
  listing_id: string | null;
  question_id: string | null;
  rating_id: string | null;
  conversation_id: string | null;
  reported_user_id: string | null;
  reason: ReportReason;
  note: string | null;
  created_at: string;
  agent_reviewed_at: string | null;
}
const [{ data: reportData }, { data: logData }] = await Promise.all([
  admin
    .from('reports')
    .select('target, listing_id, question_id, rating_id, conversation_id, reported_user_id, reason, note, created_at, agent_reviewed_at')
    .eq('status', 'aperta')
    .order('created_at'),
  admin
    .from('moderation_actions')
    .select('id, target, listing_id, user_id, action, actor, moderator_id, proposal, reason, message, confidence, model, created_at, undone_at')
    .order('created_at', { ascending: false })
    .limit(40),
]);
const rows = (reportData ?? []) as ReportRow[];

// Contestazioni aperte, con la decisione contestata
const { data: appealData } = await admin
  .from('appeals')
  .select('id, message, created_at, user_id, decision:moderation_actions(id, target, listing_id, action, actor, reason, message, created_at)')
  .eq('status', 'aperta')
  .order('created_at');
const openAppeals = (appealData ?? []) as unknown as Array<{
  id: string;
  message: string;
  created_at: string;
  user_id: string;
  decision: { id: string; target: string; listing_id: string | null; action: string; actor: string; reason: string | null; message: string | null; created_at: string } | null;
}>;
const log = (logData ?? []) as Array<{
  id: string;
  target: string;
  listing_id: string | null;
  user_id: string | null;
  action: string;
  actor: 'agente' | 'persona';
  moderator_id: string | null;
  proposal: string | null;
  reason: string | null;
  message: string | null;
  confidence: number | null;
  model: string | null;
  created_at: string;
  undone_at: string | null;
}>;

const groups = new Map<string, ReportRow[]>();
for (const r of rows) groups.set(r.target, [...(groups.get(r.target) ?? []), r]);

const uniq = (values: Array<string | null | undefined>) => [...new Set(values.filter((v): v is string => Boolean(v)))];
const listingIds = uniq([...rows.map((r) => r.listing_id), ...log.map((a) => a.listing_id), ...openAppeals.map((a) => a.decision?.listing_id)]);
const userIds = uniq([...rows.map((r) => r.reported_user_id), ...log.map((a) => a.user_id), ...log.map((a) => a.moderator_id), ...openAppeals.map((a) => a.user_id)]);
const convIds = uniq(rows.map((r) => r.conversation_id));
const [{ data: listings }, { data: questions }, { data: ratings }, { data: people }, { data: messages }, { data: convs }] = await Promise.all([
  admin.from('listings').select('id, title, description, price_chf, status, hidden_at, seller_id').in('id', listingIds),
  admin.from('questions').select('id, body, answer, hidden_at').in('id', uniq(rows.map((r) => r.question_id))),
  admin.from('ratings').select('id, stars, comment, hidden_at').in('id', uniq(rows.map((r) => r.rating_id))),
  admin.from('profiles').select('id, display_name, created_at, suspended_at').in('id', userIds),
  admin.from('messages').select('conversation_id, sender_id, kind, body, offer_chf, created_at').in('conversation_id', convIds).order('created_at'),
  admin.from('conversations').select('id, buyer_id, seller_id').in('id', convIds),
]);
const L = new Map((listings ?? []).map((l) => [l.id as string, l]));
const Q = new Map((questions ?? []).map((q) => [q.id as string, q]));
const Rt = new Map((ratings ?? []).map((r) => [r.id as string, r]));
const P = new Map((people ?? []).map((p) => [p.id as string, p]));
const C = new Map((convs ?? []).map((c) => [c.id as string, c]));
// Anche chi vende e chi partecipa alle conversazioni segnalate, per mostrare i nomi
const sellerIds = uniq([
  ...(listings ?? []).map((l) => l.seller_id as string),
  ...(convs ?? []).flatMap((c) => [c.buyer_id as string, c.seller_id as string]),
  ...(messages ?? []).map((m) => m.sender_id as string),
]).filter((id) => !P.has(id));
if (sellerIds.length) {
  const { data: sellers } = await admin.from('profiles').select('id, display_name, created_at, suspended_at').in('id', sellerIds);
  for (const s of sellers ?? []) P.set(s.id as string, s);
}
const nameOf = (id: string | null | undefined) => (id ? (P.get(id)?.display_name ?? 'Utente') : 'Utente');

const KIND_LABEL: Record<TargetKind, string> = {
  annuncio: 'Annuncio',
  domanda: 'Domanda',
  valutazione: 'Valutazione',
  utente: 'Utente',
  conversazione: 'Conversazione privata',
};

const cards = [...groups].map(([target, list]) => {
  const first = list[0];
  const kind = parseTarget(target)?.kind ?? 'annuncio';
  const listing = first.listing_id ? L.get(first.listing_id) : undefined;
  const userId = kind === 'utente' || kind === 'conversazione' ? first.reported_user_id : listing?.seller_id;
  const reasons = Object.entries(list.reduce<Record<string, number>>((acc, r) => ({ ...acc, [r.reason]: (acc[r.reason] ?? 0) + 1 }), {})).sort((a, b) => b[1] - a[1]);
  const since = list[0].created_at;
  // La proposta dell'agente su queste segnalazioni (la più recente)
  const proposal = log.find((a) => a.target === target && a.action === 'passa' && a.created_at >= since);
  const conv = first.conversation_id ? C.get(first.conversation_id) : undefined;
  const thread = first.conversation_id ? (messages ?? []).filter((m) => m.conversation_id === first.conversation_id).slice(-20) : [];
  return {
    target,
    kind,
    list,
    listing,
    question: first.question_id ? Q.get(first.question_id) : undefined,
    rating: first.rating_id ? Rt.get(first.rating_id) : undefined,
    userId,
    reasons,
    proposal,
    conv,
    thread,
    reviewed: list.some((r) => r.agent_reviewed_at),
    decisions: allowedDecisions(kind),
  };
});

const ACTION_LABEL: Record<string, string> = {
  nascondi: 'Nascosto',
  respingi: 'Respinto',
  sospendi: 'Account sospeso',
  passa: 'Passato a una persona',
  annulla: 'Annullata una decisione',
};
const targetLink = (t: string, listingId: string | null) => {
  const p = parseTarget(t);
  if (!p) return '#';
  if (p.kind === 'utente') return `/venditore/${p.id}`;
  return listingId ? `/annuncio/${listingId}` : '#';
};
const pct = (c: number | null) => (c != null ? `${Math.round(c * 100)}%` : '');
---

<Layout title="Moderazione · giro.shop">
  <section class="wrap band moderation">
    <header class="section-h">
      <h1>Moderazione</h1>
      <span class="muted small">{cards.length === 1 ? '1 contenuto da decidere' : `${cards.length} contenuti da decidere`}</span>
    </header>

    <p class:list={['agent-status', { on: agentOn }]}>
      <span class="ai-mark sm" />
      {
        agentOn
          ? `Agente di moderazione attivo: esamina ogni segnalazione appena arriva. Nasconde o respinge da solo solo quando è molto sicuro; utenti e conversazioni li passa sempre a voi.`
          : 'Agente di moderazione spento: manca ANTHROPIC_API_KEY. Le segnalazioni aspettano una persona.'
      }
    </p>

    {done && NOTICE[done] && <p class="notice" role="status">{NOTICE[done]}</p>}
    {error && <p class="error" role="alert">{error}</p>}

    {
      cards.length === 0 ? (
        <div class="panel">
          <h3>Niente da decidere.</h3>
          <p class="muted">Le segnalazioni che l'agente non chiude da solo compaiono qui, con la sua proposta.</p>
        </div>
      ) : (
        <ul class="reports">
          {cards.map((c) => (
            <li class="panel">
              <div class="r-top">
                <span class="badge plain">{KIND_LABEL[c.kind]}</span>
                {(c.listing?.hidden_at || c.question?.hidden_at || c.rating?.hidden_at) && <span class="badge bad">Già nascosto</span>}
                {c.userId && P.get(c.userId)?.suspended_at && <span class="badge bad">Account sospeso</span>}
                <span class="muted small">
                  {c.list.length === 1 ? '1 persona' : `${c.list.length} persone`} · {formatAge(c.list[0].created_at)}
                </span>
              </div>

              {c.kind === 'utente' ? (
                <a class="title" href={`/venditore/${c.userId}`}>
                  {nameOf(c.userId)}
                </a>
              ) : (
                <a class="title" href={c.listing ? `/annuncio/${c.listing.id}` : '#'}>
                  {c.listing?.title ?? 'Annuncio tolto'}
                </a>
              )}
              <span class="muted small">
                {c.kind === 'conversazione'
                  ? `Segnalato: ${nameOf(c.userId)} · conversazione tra ${nameOf(c.conv?.buyer_id)} (compra) e ${nameOf(c.conv?.seller_id)} (vende)`
                  : c.kind === 'utente'
                    ? `Iscritto ${formatAge(P.get(c.userId ?? '')?.created_at ?? new Date().toISOString())}`
                    : `di ${nameOf(c.listing?.seller_id)}${c.listing ? ` · ${formatChf(Number(c.listing.price_chf))}` : ''}`}
              </span>

              {c.question && (
                <blockquote>
                  «{c.question.body}»{c.question.answer && <span class="muted"> — {c.question.answer}</span>}
                </blockquote>
              )}
              {c.rating && (
                <blockquote>
                  {'★'.repeat(c.rating.stars)} {c.rating.comment ? `«${c.rating.comment}»` : ''}
                </blockquote>
              )}
              {c.kind === 'annuncio' && c.listing?.description && <blockquote>{c.listing.description.slice(0, 280)}</blockquote>}
              {c.thread.length > 0 && (
                <details class="thread">
                  <summary class="small">Leggi la conversazione ({c.thread.length} messaggi)</summary>
                  <ol>
                    {c.thread.map((m) => (
                      <li>
                        <b>{m.sender_id === c.conv?.buyer_id ? `${nameOf(m.sender_id)} (compra)` : `${nameOf(m.sender_id)} (vende)`}:</b>{' '}
                        {m.kind === 'offerta' ? `offerta di ${formatChf(Number(m.offer_chf))}` : m.body}
                      </li>
                    ))}
                  </ol>
                </details>
              )}

              <div class="chips">
                {c.reasons.map(([reason, n]) => (
                  <span class="chip">
                    <span class="k">{n}×</span>
                    {REPORT_REASONS[reason as ReportReason] ?? reason}
                  </span>
                ))}
              </div>
              {c.list.some((r) => r.note) && (
                <ul class="notes small">
                  {c.list
                    .filter((r) => r.note)
                    .slice(0, 5)
                    .map((r) => (
                      <li>«{r.note}»</li>
                    ))}
                </ul>
              )}

              {c.proposal && (
                <div class="proposal">
                  <span class="label">
                    <span class="ai-mark sm" /> L'agente propone: {c.proposal.proposal} {c.proposal.confidence ? `· sicurezza ${pct(c.proposal.confidence)}` : ''}
                  </span>
                  <p>{c.proposal.reason}</p>
                </div>
              )}

              <form class="decide" method="POST" action={actions.moderation.decide}>
                <input type="hidden" name="target" value={c.target} />
                <label class="fld">
                  <span class="label">
                    {c.decisions.includes('sospendi') ? "Messaggio per l'utente, se lo sospendi" : 'Messaggio per chi ha pubblicato, se lo nascondi'}
                  </span>
                  <input name="message" maxlength="300" placeholder="Non rispetta le regole di giro.shop" />
                </label>
                <div class="row">
                  {c.decisions.includes('nascondi') && (
                    <button class:list={['btn', { primary: c.proposal?.proposal === 'nascondi' }]} type="submit" name="decision" value="nascondi">
                      Nascondi
                    </button>
                  )}
                  {c.decisions.includes('sospendi') && (
                    <button class:list={['btn', { primary: c.proposal?.proposal === 'sospendi' }]} type="submit" name="decision" value="sospendi">
                      Sospendi {nameOf(c.userId)}
                    </button>
                  )}
                  <button class:list={['btn', { primary: c.proposal?.proposal === 'respingi' }]} type="submit" name="decision" value="respingi">
                    Respingi
                  </button>
                </div>
              </form>
              {agentOn && !c.reviewed && (
                <form method="POST" action={actions.moderation.askAgent}>
                  <input type="hidden" name="target" value={c.target} />
                  <button class="link-button" type="submit">
                    Chiedi all'agente
                  </button>
                </form>
              )}
            </li>
          ))}
        </ul>
      )
    }

    <section id="contestazioni" aria-labelledby="contestazioni-titolo">
      <div class="section-h">
        <h2 id="contestazioni-titolo">Contestazioni</h2>
        <span class="muted small">Le decide sempre una persona. Accogliere annulla la decisione.</span>
      </div>
      {
        openAppeals.length === 0 ? (
          <p class="muted">Nessuna contestazione aperta.</p>
        ) : (
          <ul class="reports">
            {openAppeals.map((a) => (
              <li class="panel">
                <div class="r-top">
                  <span class="badge plain">{a.decision?.action === 'sospendi' ? 'Account sospeso' : 'Contenuto nascosto'}</span>
                  <span class="muted small">
                    da {nameOf(a.user_id)} · {formatAge(a.created_at)}
                  </span>
                </div>
                {a.decision && (
                  <a class="title" href={targetLink(a.decision.target, a.decision.listing_id)}>
                    {a.decision.listing_id ? (L.get(a.decision.listing_id)?.title ?? a.decision.listing_id) : nameOf(a.user_id)}
                  </a>
                )}
                {a.decision && (
                  <p class="small muted">
                    Deciso da {a.decision.actor === 'agente' ? "l'agente" : 'una persona'} {formatAge(a.decision.created_at)}
                    {a.decision.reason && `: ${a.decision.reason}`}
                  </p>
                )}
                <blockquote>«{a.message}»</blockquote>
                <form class="decide" method="POST" action={actions.moderation.decideAppeal}>
                  <input type="hidden" name="appealId" value={a.id} />
                  <label class="fld">
                    <span class="label">Risposta (obbligatoria se respingi)</span>
                    <input name="reply" maxlength="1000" placeholder="Perché la decisione resta, oppure un messaggio di scuse" />
                  </label>
                  <div class="row">
                    <button class="btn primary" type="submit" name="decision" value="accogli">
                      Accogli e annulla
                    </button>
                    <button class="btn" type="submit" name="decision" value="respingi">
                      Respingi
                    </button>
                  </div>
                </form>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <section id="registro" aria-labelledby="registro-titolo">
      <div class="section-h">
        <h2 id="registro-titolo">Decisioni recenti</h2>
        <span class="muted small">Dell'agente e delle persone. Ogni decisione si può annullare.</span>
      </div>
      {
        log.length === 0 ? (
          <p class="muted">Ancora nessuna decisione.</p>
        ) : (
          <ul class="log">
            {log.map((a) => (
              <li class:list={{ undone: Boolean(a.undone_at) }}>
                <div class="log-head">
                  <span class:list={['badge', a.actor === 'agente' ? 'volt' : 'plain']}>{a.actor === 'agente' ? 'Agente' : nameOf(a.moderator_id)}</span>
                  <b>{ACTION_LABEL[a.action] ?? a.action}</b>
                  {a.action === 'passa' && a.proposal && <span class="muted small">propone: {a.proposal}</span>}
                  {a.confidence != null && a.confidence > 0 && <span class="muted small">sicurezza {pct(a.confidence)}</span>}
                  <span class="muted small when">{formatAge(a.created_at)}</span>
                </div>
                <a class="small" href={targetLink(a.target, a.listing_id)}>
                  {KIND_LABEL[parseTarget(a.target)?.kind ?? 'annuncio']}:{' '}
                  {a.listing_id ? (L.get(a.listing_id)?.title ?? a.listing_id) : nameOf(a.user_id)}
                </a>
                {a.reason && <p class="small reason">{a.reason}</p>}
                {a.message && <p class="small muted">Messaggio: «{a.message}»</p>}
                {a.undone_at ? (
                  <span class="small muted">Annullata {formatAge(a.undone_at)}</span>
                ) : (
                  ['nascondi', 'sospendi', 'respingi'].includes(a.action) && (
                    <form method="POST" action={actions.moderation.undo}>
                      <input type="hidden" name="actionId" value={a.id} />
                      <button class="btn small-btn" type="submit">
                        Annulla
                      </button>
                    </form>
                  )
                )}
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </section>
</Layout>

<style>
  .moderation { display: grid; gap: 24px; max-width: 860px; }
  .moderation h1 { font-size: clamp(28px, 3.6vw, 40px); }
  .agent-status { display: flex; align-items: center; gap: 10px; padding: 12px 14px; border-radius: 4px; background: var(--surface); font-size: 14px; }
  .agent-status:not(.on) { color: var(--muted); }
  .reports { display: grid; gap: 16px; }
  .reports > li { gap: 10px; justify-items: stretch; }
  .r-top { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .title { font-weight: 500; font-size: 17px; text-underline-offset: 4px; overflow-wrap: anywhere; }
  blockquote { margin: 0; padding: 10px 14px; border-left: 2px solid var(--line-strong); background: var(--surface-2); overflow-wrap: anywhere; font-size: 14.5px; }
  .thread ol { display: grid; gap: 6px; margin-top: 10px; padding: 10px 14px; background: var(--surface-2); border-radius: 4px; list-style: none; font-size: 14px; }
  .thread b { font-weight: 500; }
  .notes { display: grid; gap: 4px; color: var(--ink); }
  .proposal { display: grid; gap: 6px; padding: 12px 14px; border-radius: 4px; border: 1px solid var(--volt); }
  .proposal .label { display: inline-flex; align-items: center; gap: 8px; color: var(--ink); }
  .proposal p { font-size: 14px; }
  .decide { display: grid; gap: 12px; }
  .fld { display: grid; gap: 6px; }
  .fld input { font: 400 15px/1.3 var(--f-body); color: var(--ink); background: var(--surface-2); border: 1px solid var(--line-strong); border-radius: 4px; padding: 9px 12px; }
  .row { display: flex; flex-wrap: wrap; gap: 12px; }
  .log { display: grid; border-top: 1px solid var(--line); }
  .log li { display: grid; gap: 6px; padding: 14px 4px; border-bottom: 1px solid var(--line); justify-items: start; }
  .log li.undone { opacity: 0.6; }
  .log-head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; width: 100%; }
  .log-head b { font-weight: 500; }
  .when { margin-left: auto; }
  .reason { color: var(--ink); overflow-wrap: anywhere; }
  .small-btn { padding: 9px 12px; }
</style>
