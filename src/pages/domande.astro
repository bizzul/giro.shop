---
/** Riceve domande e risposte dalla scheda annuncio e torna alla scheda, sulle domande. */
import Layout from '../layouts/Layout.astro';
import { actions } from 'astro:actions';

const asked = Astro.getActionResult(actions.questions.ask);
const answered = Astro.getActionResult(actions.questions.answer);
const listingId = asked?.data?.listingId ?? answered?.data?.listingId ?? Astro.url.searchParams.get('id') ?? '';
const back = listingId ? `/annuncio/${listingId}#domande` : '/cerca';
if (!Astro.locals.user) return Astro.redirect(`/accedi?next=${encodeURIComponent(back)}`);
if (asked?.data || answered?.data) return Astro.redirect(back, 303);
if (!asked && !answered) return Astro.redirect(back);
const error = asked?.error?.message ?? answered?.error?.message;
---

<Layout title="Domanda non inviata · giro.shop">
  <section class="wrap band">
    <div class="panel">
      <span class="label">Non inviato</span>
      <h1>Qualcosa non ha funzionato.</h1>
      <p class="error" role="alert">{error}</p>
      <a class="btn" href={back}>Torna all'annuncio</a>
    </div>
  </section>
</Layout>
