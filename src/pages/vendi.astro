---
import Layout from '../layouts/Layout.astro';
import SellForm from '../components/SellForm.tsx';
import '../styles/sell.css';
import { COMUNI } from '../core/comuni.ts';

const signedIn = Boolean(Astro.locals.user);
const comuni = COMUNI.map((c) => c.name).sort((a, b) => a.localeCompare(b, 'it'));
---

<Layout title="Vendi · giro.shop" description="Scatta e vendi: tre foto e l'assistente prepara l'annuncio.">
  <section class="wrap band sell">
    <div class="intro">
      <p class="eyebrow">Scatta e vendi</p>
      <h1>Tre foto, nessun modulo.</h1>
      <p class="muted">
        Carica da 1 a 5 foto e, se vuoi, due righe. L'assistente riconosce l'oggetto, scrive titolo e descrizione e propone
        una fascia di prezzo dagli annunci simili. I campi con l'anello blu li ha scritti lui: controlla prima di pubblicare.
      </p>
      {!signedIn && (
        <p class="small">
          Puoi preparare la bozza subito; per pubblicarla <a href="/accedi?next=/vendi">accedi con la tua email</a>.
        </p>
      )}
    </div>
    <SellForm client:load comuni={comuni} signedIn={signedIn} />
  </section>
</Layout>

<style>
  .sell { display: grid; gap: 40px; max-width: 760px; }
  .intro { display: grid; gap: 16px; }
  .intro h1 { font-size: clamp(32px, 4.4vw, 48px); }
</style>
