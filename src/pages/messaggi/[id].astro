---
import Layout from '../../layouts/Layout.astro';
import Thread from '../../components/Thread.astro';
import { actions } from 'astro:actions';
import { getConversation } from '../../lib/messages.ts';
import { formatChf } from '../../core/format.ts';
import { formatPickup, zurichDay } from '../../core/pickup.ts';
import { getComune } from '../../core/comuni.ts';
import { protectedPaymentsOn, protectedQuote } from '../../lib/protected.ts';

const { user, supabase } = Astro.locals;
const id = Astro.params.id ?? '';
if (!user || !supabase) return Astro.redirect(`/accedi?next=/messaggi/${id}`);

// Dopo un invio o una risposta si ricarica la pagina con GET, così il form non si reinvia
const sent = Astro.getActionResult(actions.messages.send);
const responded = Astro.getActionResult(actions.messages.respond);
const released = Astro.getActionResult(actions.payments.release);
const disputed = Astro.getActionResult(actions.payments.dispute);
const refunded = Astro.getActionResult(actions.payments.refund);
if (sent?.data || responded?.data || released?.data || disputed?.data || refunded?.data) return Astro.redirect(`/messaggi/${id}#fondo`, 303);
const error =
  [sent, responded, released, disputed, refunded].find((r) => r?.error)?.error?.message ?? Astro.url.searchParams.get('errore')?.slice(0, 200);

const conversation = await getConversation(supabase, user.id, id);
if (!conversation) return new Response('Conversazione non trovata', { status: 404 });
const openForOffers = conversation.listingStatus === 'pubblicato' || conversation.listingStatus === 'in_trattativa';
const STATUS: Record<string, string> = { pubblicato: 'In vendita', in_trattativa: 'In trattativa', venduto: 'Venduto', archiviato: 'Non più in vendita' };
const placeDefault = getComune(conversation.listingComuneId ?? '')?.name ?? '';
const today = zurichDay(new Date());
const pickupPast = conversation.pickupAt ? new Date(conversation.pickupAt) < new Date() : false;

// Pagamento protetto: l'ultimo di questa conversazione, e quanto costerebbe a chi compra
const { data: lastPayment } = await supabase
  .from('payments')
  .select('id, status, amount_chf, fee_chf, metadata, user_id, payee_id')
  .eq('conversation_id', conversation.id)
  .eq('kind', 'protetto')
  .in('status', ['trattenuto', 'contestato', 'rilasciato', 'rimborsato'])
  .order('created_at', { ascending: false })
  .limit(1)
  .maybeSingle();
const held = lastPayment && ['trattenuto', 'contestato'].includes(lastPayment.status) ? lastPayment : null;
const itemOf = (p: { amount_chf: number | string; fee_chf: number | string; metadata: unknown }) =>
  Number((p.metadata as { itemChf?: number }).itemChf ?? Number(p.amount_chf) - Number(p.fee_chf));
const quote =
  protectedPaymentsOn() && conversation.role === 'compro' && !held && openForOffers ? await protectedQuote(conversation.id) : null;
---

<Layout title={`${conversation.otherName} · ${conversation.listingTitle} · giro.shop`}>
  <section class="wrap band chat">
    <p class="crumbs muted"><a href="/messaggi">Messaggi</a></p>

    <header class="chat-head">
      <a class="thumb" href={`/annuncio/${conversation.listingId}`} tabindex="-1" aria-hidden="true">
        {conversation.cover && <img src={conversation.cover} alt="" width="96" height="72" decoding="async" />}
      </a>
      <div class="head-info">
        <a class="title" href={`/annuncio/${conversation.listingId}`}>{conversation.listingTitle}</a>
        <span class="meta">
          <span class="mono">{formatChf(conversation.listingPrice)}</span>
          <span class={`badge ${conversation.listingStatus === 'pubblicato' ? 'ok' : conversation.listingStatus === 'in_trattativa' ? 'sun' : 'plain'}`}>
            {STATUS[conversation.listingStatus] ?? conversation.listingStatus}
          </span>
          <span class="muted">{conversation.role === 'compro' ? `Vende ${conversation.otherName}` : `Ti scrive ${conversation.otherName}`}</span>
        </span>
      </div>
    </header>

    {
      conversation.pickupAt && (
        <p class:list={['pickup-set', { past: pickupPast }]}>
          <b>{pickupPast ? 'Ritiro' : 'Ritiro fissato'}:</b> {formatPickup(conversation.pickupAt)}
          {conversation.pickupPlace && ` · ${conversation.pickupPlace}`}
          {conversation.pickupOutcome === 'non_venduto' && ' · non è andato a buon fine'}
          {conversation.pickupOutcome === 'venduto' && ' · venduto'}
          {!pickupPast && <span class="muted"> · Paga solo quando hai visto l'oggetto.</span>}
        </p>
      )
    }

    {error && <p class="error" role="alert">{error}</p>}

    {
      held && held.status === 'trattenuto' && conversation.role === 'compro' && (
        <div class="panel protected">
          <p>
            <b>Hai pagato {formatChf(itemOf(held))} con il pagamento protetto.</b> I soldi restano fermi: quando hai l'oggetto e va tutto bene,
            confermalo e arrivano a {conversation.otherName}.
          </p>
          <div class="protected-actions">
            <form method="POST" action={actions.payments.release}>
              <input type="hidden" name="paymentId" value={held.id} />
              <button class="btn primary" type="submit">Ho ricevuto l'oggetto, va tutto bene</button>
            </form>
            <details>
              <summary class="small">C'è un problema</summary>
              <form method="POST" action={actions.payments.dispute}>
                <input type="hidden" name="paymentId" value={held.id} />
                <label class="sr" for="reason">Cosa non va</label>
                <textarea id="reason" name="reason" rows="2" maxlength="500" placeholder="Es. l'oggetto non funziona, non è quello delle foto" required></textarea>
                <button class="btn" type="submit">Segnala: i soldi restano fermi</button>
              </form>
            </details>
          </div>
        </div>
      )
    }
    {
      held && held.status === 'trattenuto' && conversation.role === 'vendo' && (
        <div class="panel protected">
          <p>
            <b>{formatChf(itemOf(held))} trattenuti per te</b> con il pagamento protetto. Arrivano quando {conversation.otherName} conferma di aver
            ricevuto l'oggetto (o da soli, due giorni dopo il ritiro).
          </p>
          <form method="POST" action={actions.payments.refund}>
            <input type="hidden" name="paymentId" value={held.id} />
            <button class="btn" type="submit">Non posso consegnare: rimborsa</button>
          </form>
        </div>
      )
    }
    {held && held.status === 'contestato' && <p class="pickup-set"><b>Pagamento protetto fermo:</b> è stato segnalato un problema e decide chi modera.</p>}
    {
      quote && (
        <form class="panel protected" method="POST" action="/pagamento/nuovo">
          <p>
            <b>Pagamento protetto.</b> Paghi qui {formatChf(quote.itemChf)} più {formatChf(quote.feeChf)} di commissione: i soldi restano fermi
            finché confermi di aver ricevuto l'oggetto. Se qualcosa va storto, decide chi modera.
          </p>
          <input type="hidden" name="kind" value="protetto" />
          <input type="hidden" name="conversationId" value={conversation.id} />
          <input type="hidden" name="back" value={`/messaggi/${conversation.id}`} />
          <button class="btn" type="submit">Paga protetto · {formatChf(quote.totalChf)}</button>
        </form>
      )
    }

    <Thread conversation={conversation} userId={user.id} />

    <form class="composer" method="POST" action={actions.messages.send} data-bottom-ui>
      <input type="hidden" name="conversationId" value={conversation.id} />
      <label class="sr" for="body">Messaggio</label>
      <textarea id="body" name="body" rows="2" maxlength="2000" placeholder={`Scrivi a ${conversation.otherName}`}></textarea>
      {
        openForOffers && (
          <details class="pickup-field">
            <summary>Proponi giorno e ora del ritiro</summary>
            <div class="pickup-inputs">
              <label class="fld">
                <span class="label">Giorno</span>
                <input type="date" name="pickupDay" min={today} />
              </label>
              <label class="fld">
                <span class="label">Ora</span>
                <input type="time" name="pickupTime" step="900" />
              </label>
              <label class="fld place">
                <span class="label">Dove</span>
                <input name="pickupPlace" maxlength="120" value={placeDefault} />
              </label>
            </div>
            <p class="small">Con un'offerta, il ritiro va insieme all'offerta. Chi riceve la proposta la accetta con un tocco.</p>
          </details>
        )
      }
      <div class="composer-row">
        {
          openForOffers && (
            <label class="offer-field">
              <span class="label">Offerta</span>
              <span class="chf">
                CHF <input id="offer" name="offer" inputmode="numeric" placeholder={String(conversation.listingPrice)} />
              </span>
            </label>
          )
        }
        <button class="btn primary" type="submit">Invia</button>
      </div>
      <p class="small">
        Non pagare in anticipo a sconosciuti e non condividere codici ricevuti per SMS. Qualcosa non va?{' '}
        <a href={`/segnala?conversazione=${conversation.id}`}>Segnala la conversazione</a>
      </p>
    </form>
  </section>
</Layout>

<script>
  // Aggiorna i messaggi ogni 5 secondi mentre la pagina è visibile
  const thread = document.getElementById('thread');
  const url = `${location.pathname.replace(/\/$/, '')}/thread`;
  const atBottom = () => window.innerHeight + window.scrollY >= document.body.scrollHeight - 160;
  setInterval(async () => {
    const current = document.getElementById('thread');
    if (!current || document.hidden) return;
    const res = await fetch(url).catch(() => null);
    if (!res?.ok) return;
    const holder = document.createElement('div');
    holder.innerHTML = await res.text();
    const next = holder.querySelector<HTMLElement>('#thread');
    if (!next || next.dataset.version === current.dataset.version) return;
    const follow = atBottom();
    current.replaceWith(next);
    if (follow) document.getElementById('fondo')?.scrollIntoView({ block: 'end' });
  }, 5000);
  if (thread && location.hash === '#fondo') document.getElementById('fondo')?.scrollIntoView({ block: 'end' });
</script>

<style>
  .chat { display: grid; gap: 24px; max-width: 760px; }
  .crumbs { font-size: 13px; }
  .crumbs a { color: inherit; text-underline-offset: 4px; }
  .chat-head { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 16px; align-items: center; padding-bottom: 20px; border-bottom: 1px solid var(--line); }
  .thumb { width: 96px; aspect-ratio: 4 / 3; border-radius: 4px; overflow: hidden; background: var(--surface); display: block; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .head-info { display: grid; gap: 6px; min-width: 0; }
  .title { font-weight: 500; font-size: 17px; text-decoration: none; overflow-wrap: anywhere; }
  .title:hover { text-decoration: underline; text-underline-offset: 4px; }
  .meta { display: flex; flex-wrap: wrap; gap: 6px 12px; align-items: center; font-size: 13px; }
  .composer { display: grid; gap: 10px; position: sticky; bottom: 0; background: var(--bg); padding-block: 12px max(12px, env(safe-area-inset-bottom, 0px)); border-top: 1px solid var(--line); }
  .composer textarea { width: 100%; font: 400 15px/1.5 var(--f-body); color: var(--ink); background: var(--surface-2); border: 1px solid var(--line-strong); border-radius: 4px; padding: 10px 12px; resize: vertical; }
  .composer-row { display: flex; justify-content: space-between; align-items: end; gap: 12px; flex-wrap: wrap; }
  .offer-field { display: grid; gap: 6px; }
  .chf { display: inline-flex; align-items: center; gap: 8px; font: 500 14px/1 var(--f-mono); }
  .pickup-set { background: var(--surface); border-radius: 4px; padding: 10px 14px; font-size: 14.5px; }
  .protected { gap: 12px; padding: 16px 18px; font-size: 14.5px; }
  .protected b { font-weight: 500; }
  .protected-actions { display: grid; gap: 10px; width: 100%; }
  .protected-actions details form { display: grid; gap: 8px; margin-top: 8px; }
  .protected-actions textarea { width: 100%; font: 400 15px/1.5 var(--f-body); color: var(--ink); background: var(--surface-2); border: 1px solid var(--line-strong); border-radius: 4px; padding: 8px 10px; }
  .protected-actions summary { cursor: pointer; }
  .pickup-set b { font-weight: 500; }
  .pickup-set.past { color: var(--muted); }
  .pickup-field summary { cursor: pointer; font-size: 14px; }
  .pickup-inputs { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 10px; }
  .pickup-inputs .fld { display: grid; gap: 6px; }
  .pickup-inputs .place { flex: 1 1 180px; }
  .pickup-inputs input { font: 400 15px/1.2 var(--f-body); color: var(--ink); background: var(--surface-2); border: 1px solid var(--line-strong); border-radius: 4px; padding: 9px 10px; width: 100%; }
  .chf input { width: 110px; font: 400 15px/1.2 var(--f-mono); color: var(--ink); background: var(--surface-2); border: 1px solid var(--line-strong); border-radius: 4px; padding: 9px 10px; }
</style>
