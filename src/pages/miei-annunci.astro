---
import Layout from '../layouts/Layout.astro';
import { actions } from 'astro:actions';
import { getListing, photoUrl } from '../core/store.ts';
import { demandForListings } from '../lib/demand.ts';
import type { Listing } from '../core/types.ts';
import { formatAge, formatChf, formatDay } from '../core/format.ts';
import { maskSwissMobile } from '../core/phone.ts';
import { EMAIL_GROUPS, EMAIL_MODES, EMAIL_MODE_LABEL, groupIsOn, type EmailPrefs } from '../core/email-prefs.ts';
import { SCOPES } from '../core/oauth.ts';
import { connectionsOf } from '../lib/oauth.ts';
import { estimatePrice } from '../core/price.ts';
import { daysBetween, priceTip } from '../core/insights.ts';
import { AVAILABILITY, formatPickup } from '../core/pickup.ts';
import '../styles/sell.css';

const user = Astro.locals.user;
const supabase = Astro.locals.supabase;
if (!user || !supabase) return Astro.redirect('/accedi?next=/miei-annunci');

const signOut = Astro.getActionResult(actions.account.signOut);
if (signOut && !signOut.error) return Astro.redirect('/');
const deleted = Astro.getActionResult(actions.account.deleteAccount);
if (deleted?.data) return Astro.redirect('/accedi?eliminato=1', 303);

const nameResult = Astro.getActionResult(actions.account.updateName);
const statusResult = Astro.getActionResult(actions.account.setListingStatus);
const deleteResult = Astro.getActionResult(actions.account.deleteListing);
const emailResult = Astro.getActionResult(actions.account.setEmailNotices);
const handResult = Astro.getActionResult(actions.account.setHand);
const renewResult = Astro.getActionResult(actions.account.renewListing);
const lowerResult = Astro.getActionResult(actions.account.lowerPrice);
const outcomeResult = Astro.getActionResult(actions.messages.pickupOutcome);
const phoneStart = Astro.getActionResult(actions.account.startPhoneVerification);
const phoneConfirm = Astro.getActionResult(actions.account.confirmPhone);
const phoneError = phoneStart?.error?.message ?? phoneConfirm?.error?.message;

// Stato del cellulare: verificato, in attesa del codice, oppure da aggiungere
const { data: authData } = await supabase.auth.getUser();
const authUser = authData.user;
const verifiedPhone = authUser?.phone && authUser.phone_confirmed_at ? `+${authUser.phone}` : null;
const pendingPhone = phoneStart?.data?.phone ?? (authUser?.new_phone ? `+${authUser.new_phone}` : null);
const error = [nameResult, statusResult, deleteResult, signOut, emailResult, handResult, renewResult, deleted, lowerResult, outcomeResult].find((r) => r?.error)?.error?.message;
const notice = outcomeResult?.data
  ? "Peccato. L'annuncio è di nuovo in vendita: nella conversazione puoi proporre un altro ritiro."
  : lowerResult?.data
  ? `Prezzo abbassato a ${formatChf(lowerResult.data.price)}: chi aveva salvato l'annuncio riceve un avviso.`
  : renewResult?.data
  ? `Rinnovato: resta online fino ${formatDay(renewResult.data.expires, 'al')}.`
  : handResult?.data
  ? `Su telefono la barra dei comandi ora sta ${handResult.data.hand === 'sinistra' ? 'a sinistra' : 'a destra'}.`
  : emailResult?.data
  ? emailResult.data.on
    ? 'Email degli avvisi accese.'
    : 'Email degli avvisi spente: gli avvisi restano sotto la campanella.'
  : nameResult?.data
  ? 'Nome salvato.'
  : statusResult?.data
    ? { venduto: 'Segnato come venduto.', pubblicato: 'Di nuovo in vendita.', archiviato: 'Annuncio archiviato.' }[statusResult.data.status]
    : deleteResult?.data
      ? 'Annuncio eliminato.'
      : phoneConfirm?.data
        ? 'Cellulare verificato: lo vedono anche gli acquirenti.'
        : null;

// Decisioni di moderazione che mi riguardano: servono per il link "Contesta la decisione"
const { data: decisionRows } = await supabase.rpc('my_moderation_actions');
const decisions = ((decisionRows ?? []) as Array<{ id: string; listing_id: string | null; action: string; undone_at: string | null; appeal_status: string | null }>).filter(
  (d) => !d.undone_at,
);
const suspension = decisions.find((d) => d.action === 'sospendi');
const hideDecision = (listingId: string) => decisions.find((d) => d.action === 'nascondi' && d.listing_id === listingId);

// Assistenti AI collegati con OAuth (connettore MCP con accesso)
const assistants = await connectionsOf(user.id);

const { data: profile } = await supabase
  .from('profiles')
  .select('display_name, phone_verified_at, email_mode, email_off, left_handed, is_moderator, suspended_at, suspended_reason')
  .eq('id', user.id)
  .single();
const { data: rows } = await supabase
  .from('listings')
  .select('id, title, price_chf, status, published_at, created_at, expires_at, sold_at, sold_price_chf, hidden_at, hidden_reason, category_id, condition, tags, photos:listing_photos(storage_path, position)')
  .eq('seller_id', user.id)
  .order('created_at', { ascending: false });

// Chi ha scritto per ogni annuncio: quando si segna venduto si sceglie a chi, per valutarsi a vicenda
const { data: convs } = await supabase
  .from('conversations')
  .select('id, listing_id, buyer_id, pickup_at, pickup_place, pickup_outcome, buyer:profiles!conversations_buyer_id_fkey(display_name)')
  .eq('seller_id', user.id);
type ConvRow = { id: string; listing_id: string; buyer_id: string; pickup_at: string | null; pickup_place: string | null; pickup_outcome: string | null; buyer: { display_name: string } | null };
const buyersOf = new Map<string, Array<{ id: string; name: string }>>();
// Ritiro fissato e non ancora concluso, per annuncio: il più recente
const pickupOf = new Map<string, { conversationId: string; buyerId: string; buyerName: string; at: string; place: string | null; offer: number | null }>();
const convRows = (convs ?? []) as unknown as ConvRow[];
const withPickup = convRows.filter((c) => c.pickup_at && !c.pickup_outcome);
const { data: accepted } = withPickup.length
  ? await supabase.from('messages').select('conversation_id, offer_chf').eq('kind', 'offerta').eq('offer_status', 'accettata').in('conversation_id', withPickup.map((c) => c.id))
  : { data: [] };
const acceptedOffer = new Map((accepted ?? []).map((m) => [m.conversation_id as string, Number(m.offer_chf)]));
for (const c of convRows) {
  const list = buyersOf.get(c.listing_id) ?? [];
  list.push({ id: c.buyer_id, name: c.buyer?.display_name ?? 'Utente' });
  buyersOf.set(c.listing_id, list);
  if (c.pickup_at && !c.pickup_outcome && (pickupOf.get(c.listing_id)?.at ?? '') < c.pickup_at) {
    pickupOf.set(c.listing_id, {
      conversationId: c.id,
      buyerId: c.buyer_id,
      buyerName: c.buyer?.display_name ?? 'Utente',
      at: c.pickup_at,
      place: c.pickup_place,
      offer: acceptedOffer.get(c.id) ?? null,
    });
  }
}
const nowIso = new Date().toISOString();

// Statistiche (visite, salvati, contatti, domande), impostazioni private (ribasso automatico) e assistente venditore
const [{ data: statRows }, { data: settingRows }, { data: sellerSettings }] = await Promise.all([
  supabase.rpc('my_listing_stats'),
  supabase.from('listing_settings').select('listing_id, drop_pct, drop_floor_chf'),
  supabase.from('seller_settings').select('assistant_on, availability').eq('user_id', user.id).maybeSingle(),
]);
const availability: string[] = sellerSettings?.availability ?? [];
type Stats = { views_total: number; views_week: number; saves: number; contacts: number; questions: number; last_contact_at: string | null };
const statsOf = new Map(((statRows ?? []) as Array<Stats & { listing_id: string }>).map((r) => [r.listing_id, r]));
const dropOf = new Map((settingRows ?? []).filter((r) => r.drop_pct != null).map((r) => [r.listing_id as string, { pct: Number(r.drop_pct), floor: Number(r.drop_floor_chf) }]));
const count = (n: number | undefined, one: string, many: string) => `${n ?? 0} ${Number(n) === 1 ? one : many}`;
// Quante persone hanno una ricerca salvata che corrisponde (solo il numero)
const demandOf = await demandForListings(
  (rows ?? [])
    .filter((r) => r.status === 'pubblicato' || r.status === 'in_trattativa')
    .map((r) => getListing(r.id))
    .filter((l): l is Listing => Boolean(l)),
);

const listings = (rows ?? []).map((r) => {
  const stats = statsOf.get(r.id);
  const onSale = r.status === 'pubblicato' || r.status === 'in_trattativa';
  const estimate = onSale
    ? estimatePrice({ text: `${r.title} ${(r.tags ?? []).join(' ')}`, category: r.category_id, condition: r.condition, excludeId: r.id })
    : null;
  const price = Number(r.price_chf);
  const market =
    estimate && estimate.basis === 'simili' && estimate.comparables >= 3
      ? price > estimate.high
        ? 'sopra'
        : price < estimate.low
          ? 'sotto'
          : 'in linea'
      : null;
  return {
    ...r,
    cover: [...(r.photos ?? [])].sort((a, b) => a.position - b.position)[0]?.storage_path,
    buyers: buyersOf.get(r.id) ?? [],
    pickup: onSale ? pickupOf.get(r.id) : undefined,
    wanted: demandOf.get(r.id)?.people ?? 0,
    stats,
    estimate,
    market,
    drop: dropOf.get(r.id),
    tip:
      r.status === 'pubblicato' && r.published_at && !dropOf.has(r.id)
        ? priceTip({ priceChf: price, publishedAt: r.published_at, lastContactAt: stats?.last_contact_at, estimate })
        : null,
  };
});

const STATUS_LABEL: Record<string, string> = {
  bozza: 'Bozza',
  pubblicato: 'In vendita',
  in_trattativa: 'In trattativa',
  venduto: 'Venduto',
  archiviato: 'Archiviato',
  scaduto: 'Scaduto',
};
// Da quanti giorni manca la scadenza: sotto le due settimane compare "Rinnova"
const daysLeft = (iso: string | null) => (iso ? Math.ceil((new Date(iso).getTime() - Date.now()) / 864e5) : null);
---

<Layout title="I miei annunci · giro.shop">
  <section class="wrap band mine">
    <header class="mine-head">
      <div>
        <span class="label">Il tuo account</span>
        <h1>{profile?.display_name ?? 'I miei annunci'}</h1>
        <p class="muted small">{user.email}</p>
      </div>
      <div class="head-actions">
        <a class="btn primary" href="/vendi">Nuovo annuncio</a>
        <a class="btn" href="/salvati">Salvati</a>
        {/* Come ti vedono gli altri; con l'account sospeso il profilo non è visibile */}
        {!profile?.suspended_at && <a class="btn" href={`/venditore/${user.id}`}>Profilo pubblico</a>}
        {profile?.is_moderator && <a class="btn" href="/moderazione">Moderazione</a>}
        <form method="POST" action={actions.account.signOut}>
          <button class="btn" type="submit">Esci</button>
        </form>
      </div>
    </header>

    {
      profile?.suspended_at && (
        <div class="suspended" role="alert">
          <b>Il tuo account è sospeso.</b>
          <span>
            {profile.suspended_reason && profile.suspended_reason !== 'moderazione' ? `${profile.suspended_reason} ` : ''}I tuoi annunci non sono
            visibili e non puoi pubblicare né scrivere.{' '}
            {suspension ? <a href={`/contesta/${suspension.id}`}>{suspension.appeal_status ? 'Vedi la tua contestazione' : 'Contesta la decisione'}</a> : null}
          </span>
        </div>
      )
    }
    {notice && <p class="notice" role="status">{notice}</p>}
    {error && <p class="error" role="alert">{error}</p>}

    <section class="panel phone-panel" aria-labelledby="cellulare-title">
      <div class="phone-head">
        <h2 id="cellulare-title">Cellulare</h2>
        {verifiedPhone && !pendingPhone && <span class="badge ok">Verificato · {maskSwissMobile(verifiedPhone)}</span>}
      </div>
      {phoneError && <p class="error" role="alert">{phoneError}</p>}
      {
        pendingPhone ? (
          <>
            <p class="muted">Ti abbiamo mandato un SMS con un codice di 6 cifre al {maskSwissMobile(pendingPhone)}.</p>
            <form class="phone-form" method="POST" action={actions.account.confirmPhone}>
              <input type="hidden" name="phone" value={pendingPhone} />
              <label class="fld">
                <span class="label">Codice</span>
                <input id="code" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required />
              </label>
              <button class="btn primary" type="submit">Conferma</button>
            </form>
            <form class="inline-link" method="POST" action={actions.account.startPhoneVerification}>
              <input type="hidden" name="phone" value={pendingPhone} />
              <button class="link-button" type="submit">Manda un nuovo codice</button>
            </form>
          </>
        ) : verifiedPhone ? (
          <details>
            <summary class="small">Cambia numero</summary>
            <form class="phone-form" method="POST" action={actions.account.startPhoneVerification}>
              <label class="fld">
                <span class="label">Nuovo cellulare</span>
                <input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="079 123 45 67" required />
              </label>
              <button class="btn" type="submit">Mandami il codice</button>
            </form>
          </details>
        ) : (
          <>
            <p class="muted">Chi compra si fida di più: accanto al tuo nome compare "Cellulare verificato". Il numero non viene mostrato.</p>
            <form class="phone-form" method="POST" action={actions.account.startPhoneVerification}>
              <label class="fld">
                <span class="label">Il tuo cellulare</span>
                <input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="079 123 45 67" required />
              </label>
              <button class="btn primary" type="submit">Mandami il codice</button>
            </form>
          </>
        )
      }
      {import.meta.env.DEV && <p class="small">In locale non parte nessun SMS: usa 079 123 45 67 con il codice 123456.</p>}
    </section>

    <section class="panel email-panel" id="email" aria-labelledby="email-title">
      <h2 id="email-title">Email degli avvisi</h2>
      <p class="muted small">Gli avvisi restano sempre nel sito, sotto la campanella. Qui scegli quali ti arrivano anche per email, e quando.</p>
      <form class="email-form" method="POST" action={actions.account.setEmailNotices} autocomplete="off">
        <fieldset>
          <legend class="label">Quando</legend>
          {
            EMAIL_MODES.map((m) => (
              <label class="toggle">
                <input type="radio" name="mode" value={m} checked={(profile?.email_mode ?? 'subito') === m} />
                <span>
                  {EMAIL_MODE_LABEL[m]}
                  {m === 'riassunto' && <span class="muted small">Una sola email con gli avvisi del giorno che non hai ancora visto.</span>}
                </span>
              </label>
            ))
          }
        </fieldset>
        <fieldset class="email-kinds">
          <legend class="label">Per cosa</legend>
          {
            EMAIL_GROUPS.map((g) => (
              <label class="toggle">
                <input type="checkbox" name="group" value={g.key} checked={groupIsOn(profile as EmailPrefs | null, g)} />
                <span>{g.label}</span>
              </label>
            ))
          }
          <p class="muted small">Le decisioni di moderazione sui tuoi contenuti arrivano sempre subito, tranne con «Mai».</p>
        </fieldset>
        <noscript><button class="btn" type="submit">Salva</button></noscript>
      </form>
    </section>

    <section class="panel assistant-panel" id="assistente" aria-labelledby="assistente-title">
      <h2 id="assistente-title">Assistente venditore</h2>
      <p class="muted small">
        Risponde da solo alle domande che arrivano sempre uguali («è ancora disponibile?», «dove si ritira?», «si può spedire?»), usando i dati
        dell'annuncio e le risposte che hai già dato. Rifiuta con gentilezza le offerte sotto il minimo che scegli in ogni annuncio e propone gli
        orari di ritiro. Le sue risposte sono segnate come automatiche; accettare un'offerta o un ritiro resta sempre una tua decisione. Quando
        scrivi tu, per 15 minuti tace.
      </p>
      <form class="email-form assistant-form" method="POST" action={actions.account.setAssistant} autocomplete="off">
        <label class="toggle">
          <input type="checkbox" name="assistant" checked={Boolean(sellerSettings?.assistant_on)} />
          <span>Assistente acceso</span>
        </label>
        <fieldset>
          <legend class="label">Di solito si può ritirare</legend>
          {
            AVAILABILITY.map((a) => (
              <label class="toggle">
                <input type="checkbox" name="availability" value={a.key} checked={availability.includes(a.key)} />
                <span>{a.label}</span>
              </label>
            ))
          }
          <p class="muted small">Senza orari l'assistente non propone ritiri: risponde solo alle domande.</p>
        </fieldset>
        <noscript><button class="btn" type="submit">Salva</button></noscript>
      </form>
    </section>

    <section class="panel hand-panel" id="mano" aria-labelledby="mano-title">
      <h2 id="mano-title">Su telefono</h2>
      <p class="muted small">Cerca, messaggi, avvisi, account e Vendi stanno in una barra sul lato, sotto il pollice. Scegli da che parte.</p>
      <form class="hand-form" method="POST" action={actions.account.setHand} autocomplete="off">
        <fieldset>
          <legend class="sr">Lato della barra dei comandi</legend>
          {
            (['destra', 'sinistra'] as const).map((hand) => (
              <label class="hand-choice">
                <input type="radio" name="hand" value={hand} checked={(profile?.left_handed ? 'sinistra' : 'destra') === hand} />
                <svg class="hand-phone" viewBox="0 0 40 64" aria-hidden="true">
                  <rect class="hp-body" x="1" y="1" width="38" height="62" rx="7" />
                  <rect class="hp-line" x="7" y="9" width="14" height="3" rx="1.5" />
                  <rect class="hp-line" x="7" y="16" width="26" height="2" rx="1" />
                  <rect class="hp-line" x="7" y="21" width="20" height="2" rx="1" />
                  <rect class="hp-dock" x="5" y="53" width="30" height="6" rx="2" />
                  <rect class="hp-rail" x={hand === 'destra' ? 29 : 5} y="27" width="6" height="22" rx="2" />
                </svg>
                <span>
                  {hand === 'destra' ? 'A destra' : 'A sinistra'}
                  <span class="muted small">{hand === 'destra' ? 'Per chi usa il telefono con la destra.' : 'Per chi è mancino.'}</span>
                </span>
              </label>
            ))
          }
        </fieldset>
        <noscript><button class="btn" type="submit">Salva</button></noscript>
      </form>
    </section>

    <details class="panel name-panel">
      <summary>Cambia il nome visibile agli altri</summary>
      <form class="name-form" method="POST" action={actions.account.updateName} autocomplete="off">
        <label class="fld">
          <span class="label">Nome</span>
          <input id="displayName" name="displayName" value={profile?.display_name ?? ''} minlength="2" maxlength="40" required />
        </label>
        <p class="small">Si salva quando esci dal campo.</p>
        <noscript><button class="btn" type="submit">Salva</button></noscript>
      </form>
    </details>

    <section class="panel assistants-panel" id="assistenti" aria-labelledby="assistenti-titolo">
      <h2 id="assistenti-titolo">Assistenti AI collegati</h2>
      {
        assistants.length === 0 ? (
          <p class="muted small">
            Nessuno. Puoi collegare Claude o un altro assistente al tuo account per salvare ricerche e pubblicare annunci parlando:
            <a href="/connetti">ecco come</a>.
          </p>
        ) : (
          <ul class="assistants">
            {assistants.map((a) => (
              <li>
                <div>
                  <b>{a.name}</b>
                  <span class="muted small">
                    {' '}
                    · collegato {formatAge(a.since)}
                    {a.lastUsed ? ` · usato ${formatAge(a.lastUsed)}` : ' · mai usato'}
                  </span>
                  <ul class="muted small scopes">
                    {a.scopes.filter((s): s is keyof typeof SCOPES => s in SCOPES).map((s) => (
                      <li>{SCOPES[s]}</li>
                    ))}
                  </ul>
                </div>
                <form method="POST" action={actions.account.disconnectAssistant}>
                  <input type="hidden" name="clientId" value={a.clientId} />
                  <button class="btn" type="submit">Scollega</button>
                </form>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <section class="panel data-panel" id="dati" aria-labelledby="dati-titolo">
      <h2 id="dati-titolo">I tuoi dati</h2>
      <p class="muted small">
        Puoi scaricare tutto quello che giro.shop tiene su di te, in un file. Come li usiamo è spiegato nell'<a href="/privacy">informativa sulla privacy</a>.
      </p>
      <a class="btn" href="/account/dati" download>Scarica i tuoi dati</a>
      <details class="danger delete-account">
        <summary>Elimina l'account</summary>
        <form method="POST" action={actions.account.deleteAccount}>
          <p class="small">
            Si cancellano per sempre: account, annunci e foto, conversazioni (spariscono anche per l'altra persona), domande,
            valutazioni, salvati, ricerche e avvisi. Non si può annullare.
          </p>
          <label class="fld">
            <span class="label">Per confermare scrivi ELIMINA</span>
            <input name="confirm" autocomplete="off" required pattern="[Ee][Ll][Ii][Mm][Ii][Nn][Aa]" />
          </label>
          <button class="btn danger-btn" type="submit">Elimina per sempre</button>
        </form>
      </details>
    </section>

    <div class="section-h">
      <h2>I miei annunci</h2>
      <span class="muted small">{listings.length === 1 ? '1 annuncio' : `${listings.length} annunci`}</span>
    </div>

    {
      listings.length === 0 ? (
        <div class="panel">
          <h3>Non hai ancora annunci.</h3>
          <p class="muted">Con "Scatta e vendi" bastano tre foto: l'assistente scrive l'annuncio e propone il prezzo.</p>
          <a class="btn primary" href="/vendi">Prepara il primo annuncio</a>
        </div>
      ) : (
        <ul class="rows">
          {listings.map((l) => (
            <li class="row-item" id={`a-${l.id}`}>
              <a class="thumb" href={`/annuncio/${l.id}`} tabindex="-1" aria-hidden="true">
                {l.cover && <img src={photoUrl(l.cover)} alt="" width="96" height="72" loading="lazy" decoding="async" />}
              </a>
              <div class="info">
                <a class="title" href={`/annuncio/${l.id}`}>{l.title}</a>
                <span class="meta">
                  <span class={`badge ${l.status === 'pubblicato' ? 'ok' : 'plain'}`}>{STATUS_LABEL[l.status] ?? l.status}</span>
                  <span class="mono">{formatChf(Number(l.price_chf))}</span>
                  {l.status === 'venduto' && l.sold_price_chf != null && <span class="muted">venduto a {formatChf(Number(l.sold_price_chf))}</span>}
                  {l.published_at && <span class="muted">pubblicato {formatAge(l.published_at)}</span>}
                  {(l.status === 'pubblicato' || l.status === 'in_trattativa') && l.expires_at && (
                    <span class:list={[(daysLeft(l.expires_at) ?? 99) <= 3 ? 'soon' : 'muted']}>
                      scade {formatDay(l.expires_at)}
                    </span>
                  )}
                  {l.hidden_at && <span class="badge bad">Nascosto: in verifica</span>}
                </span>
                {l.stats && l.status !== 'bozza' && (
                  <span class="stats small muted">
                    {count(l.stats.views_total, 'visita', 'visite')}
                    {l.stats.views_week > 0 && l.stats.views_week !== l.stats.views_total && ` (${l.stats.views_week} questa settimana)`}
                    {' · '}
                    {count(l.stats.saves, 'salvato', 'salvati')} · {count(l.stats.contacts, 'contatto', 'contatti')}
                    {l.stats.questions > 0 && ` · ${count(l.stats.questions, 'domanda', 'domande')}`}
                    {l.wanted > 0 && ` · ${l.wanted === 1 ? 'lo cerca 1 persona' : `lo cercano in ${l.wanted}`}`}
                    {l.status === 'venduto' && l.published_at && l.sold_at && ` · venduto in ${count(daysBetween(l.published_at, l.sold_at), 'giorno', 'giorni')}`}
                  </span>
                )}
                {(l.market || l.drop) && (
                  <span class="stats small muted">
                    {l.market && l.estimate && (
                      <>
                        Prezzo <b class:list={['market', l.market === 'sopra' && 'high']}>{l.market === 'in linea' ? 'in linea con' : `${l.market} il`} mercato</b> (simili{' '}
                        {formatChf(l.estimate.low)}–{formatChf(l.estimate.high)})
                      </>
                    )}
                    {l.market && l.drop && ' · '}
                    {l.drop && `Ribasso automatico −${l.drop.pct}%, mai sotto ${formatChf(l.drop.floor)}`}
                  </span>
                )}
                {l.pickup && l.pickup.at > nowIso && (
                  <span class="stats small">
                    <a href={`/messaggi/${l.pickup.conversationId}`}>Ritiro con {l.pickup.buyerName}</a> {formatPickup(l.pickup.at)}
                    {l.pickup.place && ` · ${l.pickup.place}`}
                  </span>
                )}
              </div>
              {l.pickup && l.pickup.at <= nowIso && (
                <div class="tip small">
                  <p>
                    Ritiro con {l.pickup.buyerName} {formatPickup(l.pickup.at)}: com'è andato? Se l'hai venduto, l'annuncio sparisce dalle ricerche e potete
                    valutarvi a vicenda.
                  </p>
                  <div class="tip-actions">
                    <form method="POST" action={actions.account.setListingStatus}>
                      <input type="hidden" name="id" value={l.id} />
                      <input type="hidden" name="status" value="venduto" />
                      <input type="hidden" name="soldPrice" value={l.pickup.offer ?? Number(l.price_chf)} />
                      <input type="hidden" name="buyerId" value={l.pickup.buyerId} />
                      <input type="hidden" name="pickupConversationId" value={l.pickup.conversationId} />
                      <button class="btn primary" type="submit">Sì, venduto a {formatChf(l.pickup.offer ?? Number(l.price_chf))}</button>
                    </form>
                    <form method="POST" action={actions.messages.pickupOutcome}>
                      <input type="hidden" name="conversationId" value={l.pickup.conversationId} />
                      <input type="hidden" name="outcome" value="non_venduto" />
                      <button class="btn" type="submit">No, è ancora in vendita</button>
                    </form>
                  </div>
                </div>
              )}
              {l.tip && (
                <div class="tip small">
                  <p>
                    Nessun contatto da {l.tip.quietDays} giorni e costa il {l.tip.overPct}% in più degli annunci simili. Con {formatChf(l.tip.suggested)}{' '}
                    lo vedono più persone, oppure attiva il ribasso automatico.
                  </p>
                  <div class="tip-actions">
                    <form method="POST" action={actions.account.lowerPrice}>
                      <input type="hidden" name="id" value={l.id} />
                      <input type="hidden" name="price" value={l.tip.suggested} />
                      <button class="btn primary" type="submit">Abbassa a {formatChf(l.tip.suggested)}</button>
                    </form>
                    <a class="btn" href={`/miei-annunci/${l.id}#dropOn`}>Ribasso automatico</a>
                  </div>
                </div>
              )}
              {l.hidden_at && (
                <p class="hidden-note small">
                  {l.hidden_reason === 'segnalazioni'
                    ? 'Più persone hanno segnalato questo annuncio: non è visibile finché non lo controlliamo.'
                    : `Nascosto da chi modera${l.hidden_reason && l.hidden_reason !== 'moderazione' ? `: ${l.hidden_reason}` : '.'}`}
                  {hideDecision(l.id) && (
                    <>
                      {' '}
                      <a href={`/contesta/${hideDecision(l.id)!.id}`}>
                        {hideDecision(l.id)!.appeal_status ? 'Vedi la tua contestazione' : 'Contesta la decisione'}
                      </a>
                    </>
                  )}
                </p>
              )}
              <div class="row-actions">
                <a class="btn" href={`/miei-annunci/${l.id}`}>Modifica</a>
                {(l.status === 'scaduto' || ((l.status === 'pubblicato' || l.status === 'in_trattativa') && (daysLeft(l.expires_at) ?? 99) <= 14)) && (
                  <form method="POST" action={actions.account.renewListing}>
                    <input type="hidden" name="id" value={l.id} />
                    <button class="btn primary" type="submit">Rinnova</button>
                  </form>
                )}
                {l.status === 'pubblicato' || l.status === 'in_trattativa' ? (
                  <>
                    <form class="inline" method="POST" action={actions.account.setListingStatus}>
                      <input type="hidden" name="id" value={l.id} />
                      <input type="hidden" name="status" value="venduto" />
                      <label class="sr" for={`sold-${l.id}`}>Prezzo di vendita in CHF</label>
                      <input id={`sold-${l.id}`} class="sold" name="soldPrice" inputmode="numeric" placeholder={String(Number(l.price_chf))} />
                      {l.buyers.length > 0 && (
                        <>
                          <label class="sr" for={`buyer-${l.id}`}>A chi l'hai venduto</label>
                          <select id={`buyer-${l.id}`} class="buyer" name="buyerId">
                            <option value="">A chi? (facoltativo)</option>
                            {l.buyers.map((b) => (
                              <option value={b.id}>{b.name}</option>
                            ))}
                          </select>
                        </>
                      )}
                      <button class="btn" type="submit">Venduto</button>
                    </form>
                    <form method="POST" action={actions.account.setListingStatus}>
                      <input type="hidden" name="id" value={l.id} />
                      <input type="hidden" name="status" value="archiviato" />
                      <button class="btn" type="submit">Archivia</button>
                    </form>
                  </>
                ) : l.status === 'scaduto' ? null : l.status === 'bozza' && l.photos.length === 0 ? (
                  <a class="btn primary" href={`/miei-annunci/${l.id}#foto`}>Aggiungi una foto per pubblicare</a>
                ) : (
                  <form method="POST" action={actions.account.setListingStatus}>
                    <input type="hidden" name="id" value={l.id} />
                    <input type="hidden" name="status" value="pubblicato" />
                    <button class={l.status === 'bozza' ? 'btn primary' : 'btn'} type="submit">{l.status === 'bozza' ? 'Pubblica' : 'Rimetti in vendita'}</button>
                  </form>
                )}
                <details class="danger">
                  <summary>Elimina</summary>
                  <form method="POST" action={actions.account.deleteListing}>
                    <input type="hidden" name="id" value={l.id} />
                    <p class="small">L'annuncio e le sue foto spariscono per sempre.</p>
                    <button class="btn" type="submit">Sì, elimina</button>
                  </form>
                </details>
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Layout>

<script>
  // Nome ed email degli avvisi: niente bottone "Salva", si salva uscendo dal campo o cambiando la casella
  import { actions } from 'astro:actions';
  import { autosave } from '../lib/autosave.ts';
  import { applyHand, type Hand } from '../core/hand.ts';

  const nameForm = document.querySelector<HTMLFormElement>('form.name-form');
  if (nameForm) {
    autosave(nameForm, {
      save: (form) => actions.account.updateName(form),
      message: () => 'Nome salvato: è quello che vedono gli altri',
    });
  }
  // Lato della barra su telefono: si sposta subito, poi si salva nel profilo
  const handForm = document.querySelector<HTMLFormElement>('form.hand-form');
  if (handForm) {
    handForm.addEventListener('change', (event) => {
      const input = event.target as HTMLInputElement;
      if (input.name === 'hand') applyHand(input.value as Hand);
    });
    autosave(handForm, {
      save: (form) => actions.account.setHand(form),
      message: (_label, data) =>
        (data as { hand: Hand }).hand === 'sinistra' ? 'Su telefono la barra sta a sinistra' : 'Su telefono la barra sta a destra',
    });
  }
  const assistantForm = document.querySelector<HTMLFormElement>('form.assistant-form');
  if (assistantForm) {
    autosave(assistantForm, {
      save: (form) => actions.account.setAssistant(form),
      message: (_label, data) => {
        const { on, slots } = data as { on: boolean; slots: number };
        if (!on) return 'Assistente spento: rispondi tu a tutti';
        return slots ? 'Assistente acceso: risponde e propone i ritiri' : 'Assistente acceso: risponde alle domande ripetitive';
      },
    });
  }
  const emailForm = document.querySelector<HTMLFormElement>('form.email-form:not(.assistant-form)');
  if (emailForm) {
    autosave(emailForm, {
      save: (form) => actions.account.setEmailNotices(form),
      message: (_label, data) => {
        const { mode, on } = data as { mode: string; on: number };
        if (mode === 'mai') return 'Email spente: gli avvisi restano sotto la campanella';
        if (on === 0) return 'Nessun tipo di avviso scelto: non ti arriverà nessuna email';
        return mode === 'riassunto' ? 'Salvato: un riassunto al giorno, alle 18' : 'Salvato: email subito';
      },
    });
  }
</script>

