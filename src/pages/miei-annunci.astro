---
import Layout from '../layouts/Layout.astro';
import { actions } from 'astro:actions';
import { photoUrl } from '../core/store.ts';
import { formatAge, formatChf } from '../core/format.ts';
import { maskSwissMobile } from '../core/phone.ts';
import '../styles/sell.css';

const user = Astro.locals.user;
const supabase = Astro.locals.supabase;
if (!user || !supabase) return Astro.redirect('/accedi?next=/miei-annunci');

const signOut = Astro.getActionResult(actions.account.signOut);
if (signOut && !signOut.error) return Astro.redirect('/');

const nameResult = Astro.getActionResult(actions.account.updateName);
const statusResult = Astro.getActionResult(actions.account.setListingStatus);
const deleteResult = Astro.getActionResult(actions.account.deleteListing);
const emailResult = Astro.getActionResult(actions.account.setEmailNotices);
const phoneStart = Astro.getActionResult(actions.account.startPhoneVerification);
const phoneConfirm = Astro.getActionResult(actions.account.confirmPhone);
const phoneError = phoneStart?.error?.message ?? phoneConfirm?.error?.message;

// Stato del cellulare: verificato, in attesa del codice, oppure da aggiungere
const { data: authData } = await supabase.auth.getUser();
const authUser = authData.user;
const verifiedPhone = authUser?.phone && authUser.phone_confirmed_at ? `+${authUser.phone}` : null;
const pendingPhone = phoneStart?.data?.phone ?? (authUser?.new_phone ? `+${authUser.new_phone}` : null);
const error = [nameResult, statusResult, deleteResult, signOut, emailResult].find((r) => r?.error)?.error?.message;
const notice = emailResult?.data
  ? emailResult.data.on
    ? 'Email degli avvisi accese.'
    : 'Email degli avvisi spente: gli avvisi restano sotto la campanella.'
  : nameResult?.data
  ? 'Nome salvato.'
  : statusResult?.data
    ? { venduto: 'Segnato come venduto.', pubblicato: 'Di nuovo in vendita.', archiviato: 'Annuncio archiviato.' }[statusResult.data.status]
    : deleteResult?.data
      ? 'Annuncio eliminato.'
      : phoneConfirm?.data
        ? 'Cellulare verificato: lo vedono anche gli acquirenti.'
        : null;

const { data: profile } = await supabase.from('profiles').select('display_name, phone_verified_at, notify_email').eq('id', user.id).single();
const { data: rows } = await supabase
  .from('listings')
  .select('id, title, price_chf, status, published_at, created_at, expires_at, sold_price_chf, photos:listing_photos(storage_path, position)')
  .eq('seller_id', user.id)
  .order('created_at', { ascending: false });

// Chi ha scritto per ogni annuncio: quando si segna venduto si sceglie a chi, per valutarsi a vicenda
const { data: convs } = await supabase
  .from('conversations')
  .select('listing_id, buyer_id, buyer:profiles!conversations_buyer_id_fkey(display_name)')
  .eq('seller_id', user.id);
const buyersOf = new Map<string, Array<{ id: string; name: string }>>();
for (const c of (convs ?? []) as unknown as Array<{ listing_id: string; buyer_id: string; buyer: { display_name: string } | null }>) {
  const list = buyersOf.get(c.listing_id) ?? [];
  list.push({ id: c.buyer_id, name: c.buyer?.display_name ?? 'Utente' });
  buyersOf.set(c.listing_id, list);
}

const listings = (rows ?? []).map((r) => ({
  ...r,
  cover: [...(r.photos ?? [])].sort((a, b) => a.position - b.position)[0]?.storage_path,
  buyers: buyersOf.get(r.id) ?? [],
}));

const STATUS_LABEL: Record<string, string> = {
  bozza: 'Bozza',
  pubblicato: 'In vendita',
  in_trattativa: 'In trattativa',
  venduto: 'Venduto',
  archiviato: 'Archiviato',
};
---

<Layout title="I miei annunci · giro.shop">
  <section class="wrap band mine">
    <header class="mine-head">
      <div>
        <span class="label">Il tuo account</span>
        <h1>{profile?.display_name ?? 'I miei annunci'}</h1>
        <p class="muted small">{user.email}</p>
      </div>
      <div class="head-actions">
        <a class="btn primary" href="/vendi">Nuovo annuncio</a>
        <a class="btn" href="/salvati">Salvati</a>
        <form method="POST" action={actions.account.signOut}>
          <button class="btn" type="submit">Esci</button>
        </form>
      </div>
    </header>

    {notice && <p class="notice" role="status">{notice}</p>}
    {error && <p class="error" role="alert">{error}</p>}

    <section class="panel phone-panel" aria-labelledby="cellulare-title">
      <div class="phone-head">
        <h2 id="cellulare-title">Cellulare</h2>
        {verifiedPhone && !pendingPhone && <span class="badge ok">Verificato · {maskSwissMobile(verifiedPhone)}</span>}
      </div>
      {phoneError && <p class="error" role="alert">{phoneError}</p>}
      {
        pendingPhone ? (
          <>
            <p class="muted">Ti abbiamo mandato un SMS con un codice di 6 cifre al {maskSwissMobile(pendingPhone)}.</p>
            <form class="phone-form" method="POST" action={actions.account.confirmPhone}>
              <input type="hidden" name="phone" value={pendingPhone} />
              <label class="fld">
                <span class="label">Codice</span>
                <input id="code" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required />
              </label>
              <button class="btn primary" type="submit">Conferma</button>
            </form>
            <form class="inline-link" method="POST" action={actions.account.startPhoneVerification}>
              <input type="hidden" name="phone" value={pendingPhone} />
              <button class="link-button" type="submit">Manda un nuovo codice</button>
            </form>
          </>
        ) : verifiedPhone ? (
          <details>
            <summary class="small">Cambia numero</summary>
            <form class="phone-form" method="POST" action={actions.account.startPhoneVerification}>
              <label class="fld">
                <span class="label">Nuovo cellulare</span>
                <input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="079 123 45 67" required />
              </label>
              <button class="btn" type="submit">Mandami il codice</button>
            </form>
          </details>
        ) : (
          <>
            <p class="muted">Chi compra si fida di più: accanto al tuo nome compare "Cellulare verificato". Il numero non viene mostrato.</p>
            <form class="phone-form" method="POST" action={actions.account.startPhoneVerification}>
              <label class="fld">
                <span class="label">Il tuo cellulare</span>
                <input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="079 123 45 67" required />
              </label>
              <button class="btn primary" type="submit">Mandami il codice</button>
            </form>
          </>
        )
      }
      {import.meta.env.DEV && <p class="small">In locale non parte nessun SMS: usa 079 123 45 67 con il codice 123456.</p>}
    </section>

    <section class="panel email-panel" id="email" aria-labelledby="email-title">
      <h2 id="email-title">Email degli avvisi</h2>
      <form class="email-form" method="POST" action={actions.account.setEmailNotices}>
        <label class="toggle">
          <input type="checkbox" name="on" checked={profile?.notify_email !== false} />
          <span>
            Ricevi per email gli avvisi: ricerche salvate, prezzi ridotti, domande, risposte e valutazioni.
            <span class="muted small">Restano comunque nel sito, sotto la campanella.</span>
          </span>
        </label>
        <button class="btn" type="submit">Salva</button>
      </form>
    </section>

    <details class="panel name-panel">
      <summary>Cambia il nome visibile agli altri</summary>
      <form class="name-form" method="POST" action={actions.account.updateName}>
        <label class="fld">
          <span class="label">Nome</span>
          <input id="displayName" name="displayName" value={profile?.display_name ?? ''} minlength="2" maxlength="40" required />
        </label>
        <button class="btn" type="submit">Salva</button>
      </form>
    </details>

    <div class="section-h">
      <h2>I miei annunci</h2>
      <span class="muted small">{listings.length === 1 ? '1 annuncio' : `${listings.length} annunci`}</span>
    </div>

    {
      listings.length === 0 ? (
        <div class="panel">
          <h3>Non hai ancora annunci.</h3>
          <p class="muted">Con "Scatta e vendi" bastano tre foto: l'assistente scrive l'annuncio e propone il prezzo.</p>
          <a class="btn primary" href="/vendi">Prepara il primo annuncio</a>
        </div>
      ) : (
        <ul class="rows">
          {listings.map((l) => (
            <li class="row-item">
              <a class="thumb" href={`/annuncio/${l.id}`} tabindex="-1" aria-hidden="true">
                {l.cover && <img src={photoUrl(l.cover)} alt="" width="96" height="72" loading="lazy" decoding="async" />}
              </a>
              <div class="info">
                <a class="title" href={`/annuncio/${l.id}`}>{l.title}</a>
                <span class="meta">
                  <span class={`badge ${l.status === 'pubblicato' ? 'ok' : 'plain'}`}>{STATUS_LABEL[l.status] ?? l.status}</span>
                  <span class="mono">{formatChf(Number(l.price_chf))}</span>
                  {l.status === 'venduto' && l.sold_price_chf != null && <span class="muted">venduto a {formatChf(Number(l.sold_price_chf))}</span>}
                  {l.published_at && <span class="muted">pubblicato {formatAge(l.published_at)}</span>}
                  {l.status === 'pubblicato' && l.expires_at && (
                    <span class="muted">scade il {new Date(l.expires_at).toLocaleDateString('it-CH', { day: 'numeric', month: 'long' })}</span>
                  )}
                </span>
              </div>
              <div class="row-actions">
                <a class="btn" href={`/miei-annunci/${l.id}`}>Modifica</a>
                {l.status === 'pubblicato' || l.status === 'in_trattativa' ? (
                  <>
                    <form class="inline" method="POST" action={actions.account.setListingStatus}>
                      <input type="hidden" name="id" value={l.id} />
                      <input type="hidden" name="status" value="venduto" />
                      <label class="sr" for={`sold-${l.id}`}>Prezzo di vendita in CHF</label>
                      <input id={`sold-${l.id}`} class="sold" name="soldPrice" inputmode="numeric" placeholder={String(Number(l.price_chf))} />
                      {l.buyers.length > 0 && (
                        <>
                          <label class="sr" for={`buyer-${l.id}`}>A chi l'hai venduto</label>
                          <select id={`buyer-${l.id}`} class="buyer" name="buyerId">
                            <option value="">A chi? (facoltativo)</option>
                            {l.buyers.map((b) => (
                              <option value={b.id}>{b.name}</option>
                            ))}
                          </select>
                        </>
                      )}
                      <button class="btn" type="submit">Venduto</button>
                    </form>
                    <form method="POST" action={actions.account.setListingStatus}>
                      <input type="hidden" name="id" value={l.id} />
                      <input type="hidden" name="status" value="archiviato" />
                      <button class="btn" type="submit">Archivia</button>
                    </form>
                  </>
                ) : (
                  <form method="POST" action={actions.account.setListingStatus}>
                    <input type="hidden" name="id" value={l.id} />
                    <input type="hidden" name="status" value="pubblicato" />
                    <button class="btn" type="submit">Rimetti in vendita</button>
                  </form>
                )}
                <details class="danger">
                  <summary>Elimina</summary>
                  <form method="POST" action={actions.account.deleteListing}>
                    <input type="hidden" name="id" value={l.id} />
                    <p class="small">L'annuncio e le sue foto spariscono per sempre.</p>
                    <button class="btn" type="submit">Sì, elimina</button>
                  </form>
                </details>
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Layout>

<style>
  .mine { display: grid; gap: 24px; max-width: 960px; }
  .mine-head { display: flex; justify-content: space-between; align-items: end; gap: 16px; flex-wrap: wrap; }
  .mine-head h1 { font-size: clamp(28px, 3.6vw, 40px); }
  .head-actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .notice { background: var(--surface); border-radius: 4px; padding: 10px 12px; font-size: 14px; }
  .phone-panel { gap: 12px; }
  .phone-head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .phone-head h2 { font-size: 18px; }
  .phone-form { display: flex; gap: 12px; align-items: end; flex-wrap: wrap; width: 100%; }
  .phone-form .fld { flex: 1; min-width: 200px; max-width: 320px; }
  .link-button { background: none; border: 0; padding: 0; color: var(--muted); font: inherit; font-size: 13px; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  .name-panel { padding: 16px 20px; }
  .email-panel { gap: 12px; }
  .email-panel h2 { font: 500 16px/1.3 var(--f-body); letter-spacing: 0; }
  .email-form { display: grid; gap: 14px; justify-items: start; }
  .toggle { display: flex; gap: 12px; align-items: flex-start; font-size: 15px; cursor: pointer; }
  .toggle input { width: 18px; height: 18px; margin-top: 3px; accent-color: var(--action); flex: none; }
  .toggle .small { display: block; margin-top: 2px; }
  .name-panel summary { cursor: pointer; font-size: 14px; }
  .name-form { display: flex; gap: 12px; align-items: end; flex-wrap: wrap; margin-top: 12px; }
  .name-form .fld { flex: 1; min-width: 200px; }
  .rows { display: grid; border-top: 1px solid var(--line); }
  .row-item { display: grid; grid-template-columns: 96px minmax(0, 1fr) auto; gap: 16px; align-items: center; padding-block: 16px; border-bottom: 1px solid var(--line); }
  .thumb { width: 96px; aspect-ratio: 4 / 3; border-radius: 4px; overflow: hidden; background: var(--surface); display: block; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .info { display: grid; gap: 6px; min-width: 0; }
  .title { font-weight: 500; text-decoration: none; overflow-wrap: anywhere; }
  .title:hover { text-decoration: underline; text-underline-offset: 4px; }
  .meta { display: flex; flex-wrap: wrap; gap: 6px 12px; align-items: center; font-size: 13px; }
  .row-actions { display: flex; gap: 8px; flex-wrap: wrap; justify-content: end; align-items: center; }
  .row-actions .btn { padding: 10px 12px; }
  .inline { display: flex; gap: 6px; align-items: center; }
  .sold { width: 84px; font: 400 14px/1.2 var(--f-mono); padding: 9px 10px; border: 1px solid var(--line-strong); border-radius: 4px; background: var(--surface-2); color: var(--ink); }
  .buyer { max-width: 160px; font: 400 14px/1.2 var(--f-body); padding: 9px 8px; border: 1px solid var(--line-strong); border-radius: 4px; background: var(--surface-2); color: var(--ink); }
  .danger summary { cursor: pointer; font-size: 13px; color: var(--muted); padding: 10px 4px; }
  .danger form { display: grid; gap: 8px; padding-top: 8px; }
  @media (max-width: 720px) {
    .row-item { grid-template-columns: 72px minmax(0, 1fr); }
    .thumb { width: 72px; }
    .row-actions { grid-column: 1 / -1; justify-content: start; }
  }
</style>
