---
import Layout from '../layouts/Layout.astro';
import SearchForm from '../components/SearchForm.astro';
import SearchResults from '../components/SearchResults.astro';
import TicinoMap from '../components/TicinoMap.astro';
import { LISTINGS_TAG } from '../lib/cache.ts';

Astro.cache.set({ tags: [LISTINGS_TAG] });

// Frasi d'esempio che si scrivono a turno nel campo di ricerca: corte, così stanno anche su mobile
const suggestions = [
  'scrivania in legno sotto i 150 franchi',
  'bici per una bimba di 6 anni a Bellinzona',
  "Vespa anni '80 anche da sistemare",
  'sci da 170 cm, zona Airolo',
  'passeggino trio vicino a Locarno',
  'iPhone sotto i 400 franchi a Lugano',
  'poltrona in velluto vicino a Mendrisio',
  'giacca da sci taglia L',
];
---

<Layout title="giro.shop · il mercatino del Ticino">
  <section class="wrap hero-in">
    <TicinoMap />
    <h1>Compra e vendi in Ticino, a parole tue.</h1>
    <p class="muted lede">Annunci da una foto e ricerca a frasi, con l'assistente al tuo fianco.</p>
    <SearchForm target="risultati" mode="home" suggestions={suggestions} />
  </section>

  <section class="wrap band">
    <p id="risultati-stato" class="sr" aria-live="polite"></p>
    <div id="risultati" class="results">
      <SearchResults q="" mode="home" />
    </div>
  </section>

  <section class="wrap duo">
    <a class="panel promo" href="/vendi">
      <span class="label">Scatta e vendi</span>
      <h2>Tre foto, nessun modulo.</h2>
      <p class="muted">L'assistente riconosce l'oggetto, scrive titolo e descrizione e propone un prezzo dagli annunci simili. Tu controlli e confermi.</p>
      <span class="btn">Prepara un annuncio</span>
    </a>
    <a class="panel promo" href="/connetti">
      <span class="label">Connettore MCP</span>
      <h2>giro dentro il tuo assistente AI.</h2>
      <p class="muted">Collega Claude o un altro client MCP: cerchi, stimi prezzi e prepari bozze parlando, senza aprire il sito.</p>
      <span class="btn">Come collegarlo</span>
    </a>
  </section>
</Layout>

<style>
  .hero-in { position: relative; isolation: isolate; display: grid; justify-items: center; gap: 24px; text-align: center; padding-block: clamp(40px, 8vw, 96px) clamp(32px, 5vw, 48px); }
  .hero-in h1 { max-width: 15ch; }
  .lede { max-width: 540px; text-wrap: balance; }
  .hero-in :global(.search) { width: 100%; max-width: 640px; margin-top: 24px; text-align: left; }
  .duo { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  @media (max-width: 760px) { .duo { grid-template-columns: 1fr; } }
  .promo { text-decoration: none; align-content: start; }
  .promo p { max-width: 44ch; }
  .promo .btn { margin-top: 8px; }
  .promo:hover .btn { border-color: var(--ink); }
</style>
