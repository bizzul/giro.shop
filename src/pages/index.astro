---
import Layout from '../layouts/Layout.astro';
import SearchForm from '../components/SearchForm.astro';
import ListingCard from '../components/ListingCard.astro';
import { latestListings } from '../core/store.ts';
import { priceVerdict } from '../core/price.ts';

const latest = latestListings(8);
const examples = [
  'scrivania in legno sotto i 150 franchi vicino a Lugano',
  'bici per una bimba di 6 anni, ritiro a Bellinzona',
  "Vespa anni '80 anche da sistemare, massimo 2000",
];
---

<Layout title="Piazza · il mercatino del Ticino">
  <section class="hero">
    <div class="wrap hero-in">
      <p class="eyebrow">Prototipo · annunci di prova</p>
      <h1>Compra e vendi in Ticino, <em>a parole tue</em>.</h1>
      <SearchForm />
      <p class="examples">
        <span>Prova:</span>
        {examples.map((q) => <a href={`/cerca?q=${encodeURIComponent(q)}`}>{q}</a>)}
      </p>
    </div>
  </section>

  <section class="wrap band">
    <div class="section-h">
      <h2>Ultimi annunci</h2>
      <a class="muted" href="/cerca">Tutti gli annunci →</a>
    </div>
    <div class="cards">
      {latest.map((l, i) => <ListingCard listing={l} verdict={priceVerdict(l)} eager={i < 4} />)}
    </div>
  </section>

  <section class="wrap duo">
    <a class="panel promo" href="/vendi">
      <span class="label">Scatta e vendi</span>
      <h2>Tre foto, nessun modulo.</h2>
      <p class="muted">L'assistente riconosce l'oggetto, scrive titolo e descrizione e propone un prezzo dagli annunci simili. Tu controlli e confermi.</p>
      <span class="btn primary">Prepara un annuncio</span>
    </a>
    <a class="panel promo" href="/connetti">
      <span class="label">Connettore MCP</span>
      <h2>Piazza dentro il tuo assistente AI.</h2>
      <p class="muted">Collega Claude o un altro client MCP: cerchi, stimi prezzi e prepari bozze parlando, senza aprire il sito.</p>
      <span class="btn">Come collegarlo</span>
    </a>
  </section>
</Layout>

<style>
  .hero { border-bottom: 1px solid var(--line-soft); background:
      radial-gradient(1200px 400px at 85% -10%, color-mix(in srgb, var(--volt) 10%, transparent), transparent 70%); }
  .hero-in { padding-block: clamp(40px, 7vw, 88px); display: grid; gap: 22px; max-width: 820px; margin-inline: 0; }
  @media (min-width: 1256px) { .hero-in { margin-inline: auto; max-width: 1192px; } .hero-in > * { max-width: 760px; } }
  .duo { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  @media (max-width: 760px) { .duo { grid-template-columns: 1fr; } }
  .promo { display: grid; gap: 10px; align-content: start; text-decoration: none; }
  .promo .btn { justify-self: start; margin-top: 6px; }
  .promo:hover { border-color: var(--volt); }
</style>
