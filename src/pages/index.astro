---
import Layout from '../layouts/Layout.astro';
import SearchForm from '../components/SearchForm.astro';
import SearchResults from '../components/SearchResults.astro';
import TicinoMap from '../components/TicinoMap.astro';
import DealOfTheDay from '../components/DealOfTheDay.astro';
import { LISTINGS_TAG } from '../lib/cache.ts';

Astro.cache.set({ tags: [LISTINGS_TAG] });
---

<Layout title="giro.shop · il mercatino del Ticino">
  <section class="wrap hero-in">
    <TicinoMap />
    <h1>Compra e vendi in Ticino, a parole tue.</h1>
    <p class="muted lede">Annunci da una foto e ricerca a frasi, con l'assistente al tuo fianco.</p>
    <SearchForm target="risultati" mode="home" />
  </section>

  <DealOfTheDay />

  <section class="wrap">
    <a class="wanted" href="/cercasi">
      <span class="label">Cercasi</span>
      <b>Cosa cercano gli altri</b>
      <span class="wanted-text">Le cose più cercate in Ticino: forse ce l'hai in cantina.</span>
    </a>
  </section>

  <section class="wrap band">
    <p id="risultati-stato" class="sr" aria-live="polite"></p>
    <div id="risultati" class="results">
      <SearchResults q="" mode="home" />
    </div>
  </section>
</Layout>

<style>
  /* Niente isolation qui: la ricerca fissa in basso (mobile) deve stare sopra tutta la pagina */
  .hero-in { position: relative; display: grid; justify-items: center; gap: 24px; text-align: center; padding-block: clamp(40px, 8vw, 96px) clamp(32px, 5vw, 48px); }
  .hero-in h1 { max-width: 15ch; }
  .lede { max-width: 540px; text-wrap: balance; }
  @media (min-width: 761px) {
    .hero-in :global(.search) { width: 100%; max-width: 640px; margin-top: 24px; text-align: left; }
  }
  .wanted { display: grid; grid-template-columns: auto auto minmax(0, 1fr); align-items: baseline; gap: 6px 16px; padding: 16px 18px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); color: var(--ink); text-decoration: none; transition: border-color 0.15s; }
  .wanted:hover { border-color: var(--ink); }
  .wanted b { font: 500 17px/1.3 var(--f-display); letter-spacing: -0.01em; }
  .wanted-text { font-size: 13.5px; color: var(--muted); }
  /* Su telefono: titolo e una riga, senza etichetta, per non spingere giù gli annunci */
  @media (max-width: 760px) {
    .wanted { grid-template-columns: 1fr; gap: 2px; padding: 12px 14px; }
    .wanted .label { display: none; }
  }
</style>
