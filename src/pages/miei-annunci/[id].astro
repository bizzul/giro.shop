---
import Layout from '../../layouts/Layout.astro';
import { actions, isInputError } from 'astro:actions';
import { CATEGORIES } from '../../core/categories.ts';
import { getComune } from '../../core/comuni.ts';
import { estimatePrice } from '../../core/price.ts';
import { photoUrl } from '../../core/store.ts';
import { CONDITIONS } from '../../core/types.ts';
import { CONDITION_HINT, CONDITION_LABEL, formatChf, formatChfRange, formatDay } from '../../core/format.ts';
import { publishedListings } from '../../core/store.ts';
import { suggestTags } from '../../core/tags.ts';
import { DROP_DAYS, DROP_PCTS, dropSchedule, nextDropAt, roundDown } from '../../core/insights.ts';
import { iconPath } from '../../lib/category-icons.ts';
import PhotoField from '../../components/PhotoField.tsx';
import ComunePicker from '../../components/ComunePicker.tsx';
import Combobox from '../../components/Combobox.tsx';
import TagInput from '../../components/TagInput.tsx';
import '../../styles/sell.css';

const { user, supabase } = Astro.locals;
const id = Astro.params.id ?? '';
if (!user || !supabase) return Astro.redirect(`/accedi?next=/miei-annunci/${id}`);

const result = Astro.getActionResult(actions.account.updateListing);
const fieldErrors = result?.error && isInputError(result.error) ? Object.values(result.error.fields).flat() : [];
const formError = result?.error && !isInputError(result.error) ? result.error.message : null;

const { data: listing } = await supabase
  .from('listings')
  .select('id, title, description, category_id, condition, price_chf, negotiable, comune_id, tags, status, shipping, shipping_chf, photos:listing_photos(storage_path, position)')
  .eq('id', id)
  .eq('seller_id', user.id)
  .maybeSingle();
if (!listing) return new Response('Annuncio non trovato tra i tuoi', { status: 404 });

// Impostazioni private: ribasso automatico e offerta minima (le vede solo chi vende)
const { data: settings } = await supabase
  .from('listing_settings')
  .select('drop_pct, drop_every_days, drop_floor_chf, drop_from, drop_last_at, min_offer_chf')
  .eq('listing_id', id)
  .maybeSingle();
const price = Number(listing.price_chf);
const dropOn = settings?.drop_pct != null;
const dropPct = Number(settings?.drop_pct ?? 10);
const dropDays = Number(settings?.drop_every_days ?? 14);
const dropFloor = settings?.drop_floor_chf != null ? Number(settings.drop_floor_chf) : null;
const nextDrop = dropOn && settings?.drop_from ? nextDropAt({ pct: dropPct, everyDays: dropDays, floorChf: dropFloor ?? 0, from: settings.drop_from, lastAt: settings.drop_last_at }) : null;
const minOffer = settings?.min_offer_chf != null ? Number(settings.min_offer_chf) : null;

const photos = [...(listing.photos ?? [])].sort((a, b) => a.position - b.position);
const comuneName = getComune(listing.comune_id)?.name ?? '';
const estimate = estimatePrice({
  text: `${listing.title} ${(listing.tags ?? []).join(' ')}`,
  category: listing.category_id,
  condition: listing.condition,
  excludeId: listing.id,
});
const onSale = listing.status === 'pubblicato' || listing.status === 'in_trattativa';
// Minimo proposto quando si accende il ribasso: il basso della fascia dei simili, o il 70% del prezzo
const floorDefault = dropFloor ?? (estimate && estimate.low < price ? estimate.low : roundDown(price * 0.7));
const schedule = dropSchedule(price, { pct: dropPct, floorChf: floorDefault });
const tags: string[] = listing.tags ?? [];
const tagSuggestions = suggestTags(
  { id: listing.id, title: listing.title, description: listing.description, category: listing.category_id, tags },
  publishedListings(),
  12,
);
const categoryOptions = CATEGORIES.map((c) => ({ value: c.id, label: c.name, icon: iconPath(c.icon), keywords: c.keywords }));
const conditionOptions = CONDITIONS.map((c) => ({ value: c, label: CONDITION_LABEL[c], description: CONDITION_HINT[c] }));
---

<Layout title={`Modifica · ${listing.title} · giro.shop`}>
  <section class="wrap band edit">
    <p class="crumbs muted"><a href="/miei-annunci" data-autosave-flush>I miei annunci</a></p>
    <h1>Modifica l'annuncio</h1>
    <p class="muted small autosave-hint">Ogni modifica si salva da sola quando esci dal campo; le foto appena le cambi.</p>

    {result?.data && (
      <p class="notice" role="status">
        Modifiche salvate. <a href={`/annuncio/${listing.id}`}>Vedi l'annuncio</a>
      </p>
    )}
    {formError && <p class="error" role="alert">{formError}</p>}
    {fieldErrors.length > 0 && (
      <ul class="error" role="alert">
        {fieldErrors.map((e) => <li>{e}</li>)}
      </ul>
    )}
    {!onSale && <p class="small">Questo annuncio non è in vendita: lo rimetti in vendita da I miei annunci.</p>}

    <form class="panel sellform edit-form" method="POST" action={actions.account.updateListing} enctype="multipart/form-data" autocomplete="off">
      <input type="hidden" name="id" value={listing.id} />

      <section class="sect" aria-label="Foto">
        <div class="fld">
          <PhotoField client:load initial={photos.map((p) => ({ path: p.storage_path, url: photoUrl(p.storage_path) }))} />
        </div>
      </section>

      <section class="sect" aria-labelledby="sect-oggetto">
        <header class="sect-head">
          <h2 id="sect-oggetto">L'oggetto</h2>
          <p class="small">Cosa vendi e in che stato è.</p>
        </header>

        <label class="fld">
          <span class="label">Titolo</span>
          <input id="title" name="title" value={listing.title} minlength="3" maxlength="80" required />
        </label>

        <label class="fld">
          <span class="label">Descrizione</span>
          <textarea id="description" name="description" rows="5" maxlength="4000">{listing.description}</textarea>
        </label>

        <div class="row">
          <div class="fld">
            <span class="label" id="category-label">Categoria</span>
            <Combobox
              client:load
              id="category"
              name="category"
              labelledBy="category-label"
              label="Categoria"
              options={categoryOptions}
              initial={listing.category_id}
              placeholder="Scegli la categoria"
              searchPlaceholder="Cerca: divano, bici, iPhone…"
              empty="Nessuna categoria trovata."
              autosave
            />
          </div>
          <div class="fld">
            <span class="label" id="condition-label">Condizione</span>
            <Combobox
              client:load
              id="condition"
              name="condition"
              labelledBy="condition-label"
              label="Condizione"
              options={conditionOptions}
              initial={listing.condition}
              placeholder="Scegli la condizione"
              searchPlaceholder="Cerca condizione…"
              empty="Nessuna condizione trovata."
              autosave
            />
          </div>
        </div>
      </section>

      <section class="sect" aria-labelledby="sect-prezzo">
        <header class="sect-head">
          <h2 id="sect-prezzo">Prezzo</h2>
          {estimate && (
            <p class="small">
              Annunci simili: <span class="mono">{formatChfRange(estimate.low, estimate.high)}</span> ({estimate.comparables})
            </p>
          )}
        </header>

        <div class="line">
          <label class="fld money">
            <span class="sr">Prezzo (CHF)</span>
            <span class="affix" aria-hidden="true">CHF</span>
            <input id="price" name="price" inputmode="decimal" value={String(Number(listing.price_chf))} required />
          </label>
          <label class="toggle">
            <input id="negotiable" name="negotiable" type="checkbox" checked={listing.negotiable} />
            <span class="toggle-mark" aria-hidden="true"></span>
            <span class="label">Prezzo trattabile</span>
          </label>
        </div>
        <p class="small toggle-hint" data-for="negotiable">
          <span class="when-on">Nell'annuncio si legge «Prezzo trattabile»: chi compra sa che può proporti un'offerta.</span>
          <span class="when-off">Prezzo fisso. Attiva «Prezzo trattabile» se sei disposto a scendere.</span>
        </p>

        <input type="hidden" name="settings" value="1" />
        <div class="line">
          <label class="toggle">
            <input id="dropOn" name="dropOn" type="checkbox" checked={dropOn} />
            <span class="toggle-mark" aria-hidden="true"></span>
            <span class="label">Ribasso automatico</span>
          </label>
        </div>
        <p class="small toggle-hint" data-for="dropOn">
          <span class="when-off">Se nessuno compra, il prezzo scende da solo fino al minimo che scegli. Chi ha salvato l'annuncio viene avvisato a ogni ribasso.</span>
          <span class="when-on">
            {nextDrop ? <>Prossimo ribasso {formatDay(nextDrop.toISOString(), 'il')}. </> : null}
            <span data-schedule>{schedule.length ? `Poi: ${schedule.map((p) => formatChf(p)).join(', ')}.` : 'Il prezzo è già al minimo.'}</span>
          </span>
        </p>
        <div class="line drop-rule">
          <div class="fld">
            <label class="label" for="dropPct">Di quanto</label>
            <select id="dropPct" name="dropPct">
              {DROP_PCTS.map((p) => <option value={p} selected={p === dropPct}>−{p}%</option>)}
            </select>
          </div>
          <div class="fld">
            <label class="label" for="dropDays">Ogni</label>
            <select id="dropDays" name="dropDays">
              {DROP_DAYS.map((d) => <option value={d} selected={d === dropDays}>{d} giorni</option>)}
            </select>
          </div>
          <div class="fld">
            <label class="label" for="dropFloor">Mai sotto</label>
            <span class="money">
              <span class="affix" aria-hidden="true">CHF</span>
              <input id="dropFloor" name="dropFloor" inputmode="decimal" value={String(floorDefault)} data-price={price} />
            </span>
          </div>
        </div>

        <div class="fld min-offer">
          <label class="label" for="minOffer">Offerta minima <span class="muted">(la vedi solo tu)</span></label>
          <span class="money">
            <span class="affix" aria-hidden="true">CHF</span>
            <input id="minOffer" name="minOffer" inputmode="decimal" value={minOffer != null ? String(minOffer) : ''} placeholder="nessuna" />
          </span>
          <p class="small">Con l'assistente venditore acceso, le offerte sotto questa cifra vengono rifiutate con gentilezza, senza disturbarti.</p>
        </div>
      </section>

      <section class="sect" aria-labelledby="sect-consegna">
        <header class="sect-head">
          <h2 id="sect-consegna">Ritiro e spedizione</h2>
          <p class="small">Il ritiro di persona resta sempre possibile.</p>
        </header>

        <div class="fld">
          <label class="label" for="comune">Comune di ritiro</label>
          <ComunePicker client:load id="comune" name="comune" initial={comuneName} required autosave />
        </div>

        <div class="line ship">
          <label class="toggle">
            <input id="shipping" name="shipping" type="checkbox" checked={listing.shipping} />
            <span class="toggle-mark" aria-hidden="true"></span>
            <span class="label">Si può spedire</span>
          </label>
          <label class="fld money ship-cost">
            <span class="sr">Costo di spedizione (CHF)</span>
            <span class="affix" aria-hidden="true">CHF</span>
            <input id="shippingChf" name="shippingChf" inputmode="decimal" value={listing.shipping_chf != null ? String(Number(listing.shipping_chf)) : ''} placeholder="da concordare" />
          </label>
        </div>
        <p class="small toggle-hint" data-for="shipping">
          <span class="when-on">Indica il costo di spedizione, o lascialo vuoto se è da concordare.</span>
          <span class="when-off">Solo ritiro di persona.</span>
        </p>
      </section>

      <section class="sect" aria-labelledby="sect-tags">
        <header class="sect-head">
          <h2 id="sect-tags"><label for="tags">Parole chiave</label></h2>
        </header>
        <TagInput client:load id="tags" name="tags" initial={tags} suggestions={tagSuggestions} autosave />
      </section>

      <div class="actions">
        <noscript><button class="btn primary" type="submit">Salva le modifiche</button></noscript>
        <a class="btn" href={`/annuncio/${listing.id}`} data-autosave-flush>Vedi l'annuncio</a>
        <a class="btn" href="/miei-annunci" data-autosave-flush>Torna ai miei annunci</a>
      </div>
    </form>
  </section>
</Layout>

<script>
  // Niente bottone "Salva": ogni campo si salva all'uscita, le foto a ogni cambio (vedi src/lib/autosave.ts)
  import { actions } from 'astro:actions';
  import { autosave } from '../../lib/autosave.ts';

  import { dropSchedule } from '../../core/insights.ts';
  import { formatChf } from '../../core/format.ts';

  const form = document.querySelector<HTMLFormElement>('form.sellform');
  // Ribasso automatico: i prezzi che verranno, ricalcolati mentre cambi le impostazioni
  const scheduleText = document.querySelector<HTMLElement>('[data-schedule]');
  const showSchedule = () => {
    if (!form || !scheduleText) return;
    const num = (name: string) => Number((form.elements.namedItem(name) as HTMLInputElement | null)?.value.replace(',', '.') ?? NaN);
    const price = num('price');
    const floor = num('dropFloor');
    if (!Number.isFinite(price) || !Number.isFinite(floor)) return;
    const steps = dropSchedule(price, { pct: num('dropPct'), floorChf: floor });
    scheduleText.textContent = floor >= price ? 'Il minimo deve essere sotto il prezzo di adesso.' : steps.length ? `Poi: ${steps.map((p) => formatChf(p)).join(', ')}.` : 'Il prezzo è già al minimo.';
  };
  form?.addEventListener('input', showSchedule);
  form?.addEventListener('change', showSchedule);
  if (form) {
    autosave(form, {
      save: (data) => actions.account.updateListing(data),
      prepare: () => {
        form.dispatchEvent(new Event('photos:prepare'));
        return form.dataset.photosError ?? null;
      },
      saved: (data) => {
        const photos = (data as { photos?: Array<{ path: string; url: string }> }).photos;
        if (photos) form.dispatchEvent(new CustomEvent('photos:saved', { detail: photos }));
      },
    });
  }
</script>

<style>
  .edit { display: grid; gap: 20px; max-width: 760px; }
  .autosave-hint { margin-top: -12px; }
  .sellform[aria-busy='true'] { cursor: progress; }
  .edit h1 { font-size: clamp(28px, 3.6vw, 40px); }
  .crumbs { font-size: 13px; }
  .crumbs a { color: inherit; text-underline-offset: 4px; }
  .notice { background: var(--surface); border-radius: 4px; padding: 10px 12px; font-size: 14px; }
  ul.error { padding-left: 28px; list-style: disc; }

  /* Sezioni del modulo: titolo piccolo e una riga sopra */
  .edit-form { gap: 0; }
  .sect { display: grid; gap: 18px; padding-block: 28px; border-top: 1px solid var(--line); }
  .sect:first-of-type { border-top: 0; padding-top: 0; }
  .sect-head { display: flex; align-items: baseline; justify-content: space-between; gap: 6px 16px; flex-wrap: wrap; }
  .sect-head h2 { font: 500 18px/1.3 var(--f-display); letter-spacing: -0.015em; }
  .sect-head label { cursor: pointer; }
  .actions { padding-top: 28px; border-top: 1px solid var(--line); }

  /* Prezzo e costo di spedizione: importo con CHF davanti, accanto all'interruttore */
  .line { display: flex; flex-wrap: wrap; gap: 12px; align-items: stretch; }
  .money { position: relative; display: block; flex: 0 1 220px; min-width: 160px; }
  .money .affix { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); font: 500 12px/1 var(--f-mono); color: var(--muted); pointer-events: none; }
  .money input { padding-left: 52px; font-family: var(--f-mono); font-variant-numeric: tabular-nums; height: 100%; }

  /* Interruttori: un bottone che si accende (pieno) e si spegne (contorno) */
  .toggle { position: relative; display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 18px 0 14px; border: 1px solid var(--line-strong); border-radius: 4px; background: var(--surface-2); color: var(--ink); cursor: pointer; user-select: none; transition: background 0.15s, color 0.15s, border-color 0.15s; }
  .toggle:hover { border-color: var(--ink); }
  .toggle input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
  .toggle .label { font: 500 14px/1.2 var(--f-body); letter-spacing: 0; text-transform: none; color: inherit; }
  .toggle-mark { position: relative; flex: none; width: 30px; height: 18px; border-radius: 9px; background: var(--line); box-shadow: inset 0 0 0 1px var(--line-strong); transition: background 0.15s; }
  .toggle-mark::after { content: ''; position: absolute; top: 3px; left: 3px; width: 12px; height: 12px; border-radius: 50%; background: var(--muted); transition: transform 0.15s, background 0.15s; }
  .toggle:has(input:checked) { background: var(--action); border-color: var(--action); color: var(--action-ink); }
  .toggle:has(input:checked) .toggle-mark { background: var(--action-ink); box-shadow: none; }
  .toggle:has(input:checked) .toggle-mark::after { transform: translateX(12px); background: var(--action); }
  .toggle:has(input:focus-visible) { outline: 2px solid var(--ink); outline-offset: 3px; }

  /* Testo sotto l'interruttore secondo lo stato; il costo si vede solo se si spedisce */
  .toggle-hint { margin-top: -8px; }
  .toggle-hint .when-on { display: none; }
  .sect:has(#negotiable:checked) [data-for='negotiable'] .when-on,
  .sect:has(#shipping:checked) [data-for='shipping'] .when-on { display: inline; }
  .sect:has(#negotiable:checked) [data-for='negotiable'] .when-off,
  .sect:has(#shipping:checked) [data-for='shipping'] .when-off { display: none; }
  .ship:not(:has(#shipping:checked)) .ship-cost { display: none; }
  .sect:has(#dropOn:checked) [data-for='dropOn'] .when-on { display: inline; }
  .sect:has(#dropOn:checked) [data-for='dropOn'] .when-off { display: none; }
  .sect:not(:has(#dropOn:checked)) .drop-rule { display: none; }
  .drop-rule .fld { flex: 0 1 160px; min-width: 120px; }
  .drop-rule .money, .min-offer .money { flex: none; }
  .drop-rule .money input, .min-offer .money input { width: 100%; height: 48px; }
  .min-offer { max-width: 360px; }
  .min-offer .label .muted { text-transform: none; letter-spacing: 0; }

  @media (max-width: 520px) {
    .line > * { flex: 1 1 100%; }
  }
</style>
