---
import Layout from '../../layouts/Layout.astro';
import { actions } from 'astro:actions';
import CategoryIcon from '../../components/CategoryIcon.astro';
import ListingCard from '../../components/ListingCard.astro';
import ContactBox from '../../components/ContactBox.astro';
import FavoriteButton from '../../components/FavoriteButton.astro';
import QuestionBox from '../../components/QuestionBox.astro';
import PriceChart from '../../components/PriceChart.astro';
import RatingsSummary from '../../components/RatingsSummary.astro';
import { ruleHighlights } from '../../core/highlights.ts';
import { detectCategory } from '../../core/categories.ts';
import { tokenize } from '../../core/text.ts';
import { LANGUAGES } from '../../core/claude.ts';
import { claudeKey } from '../../lib/claude.ts';
import { replyTime, sellerProfile } from '../../lib/sellers.ts';
import { listingJsonLd } from '../../core/seo.ts';
import { siteOrigin } from '../../lib/notify.ts';
import { LISTINGS_TAG } from '../../lib/cache.ts';
import { getListing, getPhoto, sourceName } from '../../core/store.ts';
import { getComune } from '../../core/comuni.ts';
import { getCategory } from '../../core/categories.ts';
import { estimatePrice, priceVerdict } from '../../core/price.ts';
import { similarTo } from '../../core/search.ts';
import { CONDITION_LABEL, VERDICT_LABEL, formatAge, formatChf, formatChfRange } from '../../core/format.ts';

const listing = getListing(Astro.params.id ?? '');
if (!listing) {
  return new Response('Annuncio non trovato', { status: 404 });
}

Astro.cache.set({ tags: [LISTINGS_TAG] });
const sold = listing.status === 'venduto';
const comune = getComune(listing.comuneId);
const photo = getPhoto(listing.id);
const morePhotos = (listing.photos ?? []).slice(1);
const category = getCategory(listing.category);
const verdict = priceVerdict(listing);
const estimate = estimatePrice({
  text: `${listing.title} ${listing.tags.join(' ')}`,
  category: listing.category,
  condition: listing.condition,
  excludeId: listing.id,
});
const similar = similarTo(listing.id, listing.title);
const attributes = Object.entries(listing.attributes);
// Gli annunci usati per la stima, come prova: dal più economico al più caro
const comparables = (estimate?.comparableIds ?? [])
  .map((id) => getListing(id))
  .filter((l): l is NonNullable<typeof l> => Boolean(l))
  .map((l) => ({ l, price: l.status === 'venduto' && l.soldPriceChf ? l.soldPriceChf : l.priceChf }))
  .sort((a, b) => a.price - b.price);
const factCount = 3 + attributes.length + (listing.shipping ? 1 : 0);

// Prezzo ridotto di recente: lo dice lo storico
const history = listing.priceHistory ?? [];
const last = history.at(-1);
const before = history.at(-2);
const reducedFrom =
  !sold && last && before && last.priceChf < before.priceChf && Date.now() - new Date(last.at).getTime() < 30 * 864e5 ? before.priceChf : null;

// In sintesi: i punti di Claude se ci sono, altrimenti righe costruite dai dati
const highlights = listing.highlights ?? ruleHighlights(listing, estimate, verdict);
const fromClaude = Boolean(listing.highlights?.length);

// Lo stesso oggetto in vendita adesso, per avere il prezzo in contesto
const object = detectCategory(tokenize(listing.title));
const forSale = estimate?.basis === 'simili' ? comparables.filter(({ l }) => l.status === 'pubblicato') : [];
const market = forSale.length
  ? { n: forSale.length, min: Math.min(...forSale.map((c) => c.price)), max: Math.max(...forSale.map((c) => c.price)) }
  : null;

const questions = listing.questions ?? [];
// Prima le risposte che più persone hanno trovato utili
const answered = questions.filter((q) => q.answer).sort((a, b) => b.helpful - a.helpful || a.createdAt.localeCompare(b.createdAt));
const voteAction = `/domande${actions.questions.vote}&id=${encodeURIComponent(listing.id)}`;
const { stats, ratings } = listing.sellerId ? await sellerProfile(listing.sellerId) : { stats: null, ratings: [] };
const memberSince = stats ? new Date(stats.memberSince).toLocaleDateString('it-CH', { month: 'long', year: 'numeric' }) : null;
const canTranslate = Boolean(claudeKey());
---

<Layout
  title={`${listing.title} · giro.shop`}
  description={listing.description}
  image={photo?.src}
  ogType="product"
  jsonLd={listingJsonLd(listing, siteOrigin(Astro.url.origin), comune)}
>
  <section class="wrap band">
    <p class="crumbs muted"><a href="/cerca">Annunci</a> · {category.name}</p>
    <div class="detail">
      {
        photo ? (
          <figure class="gallery">
            <img
              class="hero-photo"
              src={photo.src}
              width={photo.width}
              height={photo.height}
              alt={listing.title}
              fetchpriority="high"
              decoding="async"
            />
            {morePhotos.length > 0 && (
              <div class="thumbs">
                {morePhotos.map((p, i) => (
                  <a href={p.src} target="_blank" rel="noopener">
                    <img src={p.srcSmall} width={p.width} height={p.height} alt={`${listing.title}, foto ${i + 2}`} loading="lazy" decoding="async" />
                  </a>
                ))}
              </div>
            )}
            {photo.credit && (
            <figcaption class="credit">
              Foto di esempio:{' '}
              {photo.credit.authorUrl ? (
                <a href={photo.credit.authorUrl} target="_blank" rel="noopener">
                  {photo.credit.author ?? 'autore'}
                </a>
              ) : (
                (photo.credit.author ?? 'autore sconosciuto')
              )}{' '}
              ·{' '}
              {photo.credit.licenseUrl ? (
                <a href={photo.credit.licenseUrl} target="_blank" rel="noopener license">
                  {photo.credit.license}
                </a>
              ) : (
                photo.credit.license
              )}{' '}
              ·{' '}
              <a href={photo.credit.sourceUrl} target="_blank" rel="noopener">
                {sourceName(photo.credit.source)}
              </a>
            </figcaption>
            )}
          </figure>
        ) : (
          <div class="photo">
            <CategoryIcon category={listing.category} />
            <span class="label">Nessuna foto</span>
          </div>
        )
      }

      <div class="info">
        <h1 class="title" data-tr="title">{listing.title}</h1>
        <div class="price-row">
          <span class="price mono">{formatChf(listing.priceChf)}</span>
          {reducedFrom != null && <a class="badge ok" href="#storico">Ridotto da {formatChf(reducedFrom)}</a>}
          {sold && <span class="badge plain">Venduto</span>}
          {!sold && listing.negotiating && <span class="badge sun">In trattativa</span>}
          {!sold && !listing.negotiating && listing.negotiable && <span class="badge plain">Trattabile</span>}
          {!sold && verdict && <span class={`badge ${verdict === 'sopra_mercato' ? 'bad' : 'ok'}`}>{VERDICT_LABEL[verdict]}</span>}
        </div>

        {
          estimate && (
            <a class="estimate" href="#prezzo">
              <span class="ai-mark sm" />
              <span>
                {estimate.basis === 'simili' ? 'Annunci simili' : `Categoria ${category.name}`}: <b class="mono">{formatChfRange(estimate.low, estimate.high)}</b>
                <span class="muted">
                  {' '}
                  ({estimate.comparables} annunci, {estimate.soldComparables} venduti)
                </span>
              </span>
            </a>
          )
        }
        {
          market && object && (
            <p class="market small">
              In vendita ora: {market.n === 1 ? 'un altro annuncio' : `altri ${market.n} annunci`} di {object.label.toLowerCase()}
              {market.n > 1 ? `, da ${formatChf(market.min)} a ${formatChf(market.max)}` : `, a ${formatChf(market.min)}`}.{' '}
              <a href={`/cerca?q=${encodeURIComponent(object.label.toLowerCase())}`}>Vedili</a>
            </p>
          )
        }

        <div class="actions-row">
          {
            !sold && (
              <FavoriteButton server:defer listingId={listing.id}>
                <span slot="fallback" class="fav-ghost" aria-hidden="true" />
              </FavoriteButton>
            )
          }
          <button class="btn compare-btn" type="button" data-compare={listing.id} aria-pressed="false">
            Confronta
          </button>
          <a class="compare-link small" href="/confronta" data-compare-link hidden>Vedi il confronto</a>
        </div>

        {
          highlights.length > 0 && (
            <div class="summary">
              <span class="label">
                {fromClaude && <span class="ai-mark sm" />}
                In sintesi
              </span>
              <ul data-tr="highlights">
                {highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            </div>
          )
        }

        <p class="desc" data-tr="description">{listing.description}</p>

        {
          canTranslate && (
            <div class="translate small" data-translate={listing.id}>
              <span class="muted">Traduci:</span>
              {Object.entries(LANGUAGES).map(([code, name]) => (
                <button type="button" class="link-button" data-lang={code} lang={code}>
                  {name}
                </button>
              ))}
              <button type="button" class="link-button" data-lang="" hidden>
                Mostra l'originale
              </button>
              <span class="tr-status muted" aria-live="polite" />
            </div>
          )
        }

        <div id="contatta" class="seller panel">
          <div>
            <span class="label">Pubblicato da</span>
            <p class="name">
              {listing.sellerId ? <a class="seller-link" href={`/venditore/${listing.sellerId}`}>{listing.seller.name}</a> : listing.seller.name}
              {listing.seller.verified && <span class="badge ok">Cellulare verificato</span>}
            </p>
            {
              stats && (
                <ul class="trust small">
                  {stats.ratingCount > 0 && (
                    <li>
                      <a href="#valutazioni">
                        <b class="stars-inline" aria-hidden="true">★</b> {stats.ratingAvg?.toFixed(1)} · {stats.ratingCount}{' '}
                        {stats.ratingCount === 1 ? 'valutazione' : 'valutazioni'}
                      </a>
                    </li>
                  )}
                  {stats.medianReplyMinutes != null && <li>Risponde di solito {replyTime(stats.medianReplyMinutes)}</li>}
                  {stats.conversations >= 3 && (
                    <li>
                      Ha risposto a {stats.answered} {stats.answered === 1 ? 'persona' : 'persone'} su {stats.conversations}
                    </li>
                  )}
                  {stats.sold > 0 && <li>{stats.sold === 1 ? '1 vendita conclusa' : `${stats.sold} vendite concluse`}</li>}
                  {memberSince && <li>Su giro.shop da {memberSince}</li>}
                </ul>
              )
            }
          </div>
          {
            !sold && (
              <ContactBox server:defer listingId={listing.id} sellerName={listing.seller.name}>
                <div slot="fallback" class="contact-ghost" aria-hidden="true" />
              </ContactBox>
            )
          }
          <a class="report small muted" href={`/segnala?annuncio=${encodeURIComponent(listing.id)}`}>Segnala l'annuncio</a>
        </div>

        <div class="blocks">
          <details id="dettagli" open>
            <summary>
              <h2>Dettagli</h2>
              <span class="count">{factCount}</span>
            </summary>
            <dl class="facts">
              <div><dt>Condizione</dt><dd>{CONDITION_LABEL[listing.condition]}</dd></div>
              <div>
                <dt>Ritiro</dt>
                <dd>
                  {comune ? `${comune.cap} ${comune.name} · distretto di ${comune.district}` : '—'}
                  {comune && (
                    <span class="dist" data-lat={comune.lat} data-lon={comune.lon}>
                      <span data-dist />
                    </span>
                  )}
                  {comune && (
                    <button class="link-button ask-dist" type="button" data-place-open data-place-ask>
                      Quanto dista da te?
                    </button>
                  )}
                </dd>
              </div>
              {listing.shipping && <div><dt>Spedizione</dt><dd>{listing.shippingChf != null ? `Possibile, ${formatChf(listing.shippingChf)}` : 'Possibile, costo da concordare'}</dd></div>}
              {attributes.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
              <div><dt>Pubblicato</dt><dd>{formatAge(listing.publishedAt)}</dd></div>
            </dl>
          </details>

          <details id="domande" open={answered.length > 0 ? true : undefined} data-description={listing.description}>
            <summary>
              <h2>Domande</h2>
              {questions.length > 0 && <span class="count">{questions.length}</span>}
            </summary>
            <div class="block-body">
              {
                answered.length === 0 ? (
                  <p class="muted">Nessuna domanda con risposta, per ora. La risposta di chi vende la vedono tutti.</p>
                ) : (
                  <ul class="qa">
                    {answered.map((q) => (
                      <li>
                        <p class="q">{q.body}</p>
                        <p class="a">
                          <span class="label">{listing.seller.name} risponde</span>
                          {q.answer}
                        </p>
                        <span class="qa-foot">
                          <span class="muted small">
                            Chiesto da {q.askerName} · {formatAge(q.createdAt)} ·{' '}
                            <a class="report" href={`/segnala?annuncio=${encodeURIComponent(listing.id)}&domanda=${q.id}`}>Segnala</a>
                          </span>
                          {!sold && (
                            <form method="POST" action={voteAction}>
                              <input type="hidden" name="questionId" value={q.id} />
                              <button class="helpful" type="submit" data-vote={q.id} aria-pressed="false">
                                Utile{q.helpful > 0 && <span class="mono"> · {q.helpful}</span>}
                              </button>
                            </form>
                          )}
                        </span>
                      </li>
                    ))}
                  </ul>
                )
              }
              <QuestionBox server:defer listingId={listing.id}>
                <span slot="fallback" aria-hidden="true" />
              </QuestionBox>
            </div>
          </details>

          {
            history.length > 0 && (
              <details id="storico" open={reducedFrom != null ? true : undefined}>
                <summary>
                  <h2>Storico del prezzo</h2>
                  {history.length > 1 && <span class="count">{history.length - 1}</span>}
                </summary>
                <div class="block-body">
                  <PriceChart points={history} />
                  {!sold && <p class="muted">Salva l'annuncio con il cuore: se il prezzo cala ti avvisiamo, anche per email.</p>}
                </div>
              </details>
            )
          }

          {
            estimate && comparables.length > 0 && (
              <details id="prezzo">
                <summary>
                  <h2>Come stimiamo il prezzo</h2>
                  <span class="count">{comparables.length}</span>
                </summary>
                <div class="block-body">
                  <div class="range">
                    <span class="label">Fascia per questo annuncio</span>
                    <b class="mono">{formatChfRange(estimate.low, estimate.high)}</b>
                  </div>
                  <p class="muted">
                    {estimate.basis === 'simili'
                      ? 'Confrontiamo gli annunci dello stesso oggetto, anche quelli già venduti, e li riportiamo alla stessa condizione.'
                      : `Ci sono ancora pochi annunci di questo oggetto: la fascia viene da tutta la categoria ${category.name}, quindi è solo indicativa.`}
                  </p>
                  <ul class="comps">
                    {comparables.map(({ l, price }) => (
                      <li>
                        <a href={`/annuncio/${l.id}`}>{l.title}</a>
                        <span class="muted">
                          {CONDITION_LABEL[l.condition]}
                          {l.status === 'venduto' && ' · venduto'}
                        </span>
                        <span class="mono">{formatChf(price)}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </details>
            )
          }

          {
            stats && stats.ratingCount > 0 && (
              <details id="valutazioni">
                <summary>
                  <h2>Valutazioni di {listing.seller.name}</h2>
                  <span class="count">{stats.ratingCount}</span>
                </summary>
                <div class="block-body">
                  <RatingsSummary stats={stats} ratings={ratings} name={listing.seller.name} limit={4} />
                  {listing.sellerId && (
                    <a class="small" href={`/venditore/${listing.sellerId}#valutazioni`}>
                      {stats.ratingCount > 4 ? `Tutte le ${stats.ratingCount} valutazioni` : `Profilo di ${listing.seller.name}`}
                    </a>
                  )}
                </div>
              </details>
            )
          }

          <details id="sicurezza">
            <summary>
              <h2>Comprare in sicurezza</h2>
            </summary>
            <div class="block-body">
              <ul class="tips">
                <li>Fissa l'incontro in un luogo pubblico e guarda l'oggetto prima di pagare.</li>
                <li>Non pagare in anticipo a chi non conosci e non condividere codici ricevuti per SMS.</li>
                <li>Diffida di chi vuole spostare la conversazione su WhatsApp o ti manda link per pagare.</li>
                <li>Per gli oggetti di valore chiedi lo scontrino o il certificato di garanzia.</li>
              </ul>
              <p class="small">
                <a href="/sicurezza">Leggi la guida completa</a> · Qualcosa non torna?{' '}
                <a href={`/segnala?annuncio=${encodeURIComponent(listing.id)}`}>Segnala l'annuncio</a>
              </p>
            </div>
          </details>
        </div>
      </div>
    </div>
  </section>

  {
    !sold && (
      <div class="buybar" data-buybar data-bottom-ui>
        {photo && <img src={photo.srcSmall} alt="" width="56" height="42" decoding="async" />}
        <span class="bb-info">
          <span class="bb-price mono">{formatChf(listing.priceChf)}</span>
          <span class="bb-title">{listing.title}</span>
        </span>
        {listing.priceChf > 0 && (
          <a class="btn bb-offer" href="#contatta" data-focus="contact-offer">
            Offerta
          </a>
        )}
        <a class="btn primary bb-main" href="#contatta" data-focus="contact-body">
          Scrivi
        </a>
      </div>
    )
  }

  {
    similar.length > 0 && (
      <section class="wrap">
        <div class="section-h">
          <h2>Annunci simili</h2>
        </div>
        <div class="cards">
          {similar.map((h) => <ListingCard listing={h.listing} verdict={h.verdict} />)}
        </div>
      </section>
    )
  }
</Layout>

<script>
  // Confronto: fino a 4 annunci, ricordati solo in questo browser
  const KEY = 'giro:confronto';
  const readCompare = (): string[] => {
    try {
      const v = JSON.parse(localStorage.getItem(KEY) ?? '[]');
      return Array.isArray(v) ? v.filter((x) => typeof x === 'string').slice(0, 4) : [];
    } catch {
      return [];
    }
  };
  const compareBtn = document.querySelector<HTMLButtonElement>('[data-compare]');
  const compareLink = document.querySelector<HTMLAnchorElement>('[data-compare-link]');
  const showCompare = () => {
    if (!compareBtn || !compareLink) return;
    const ids = readCompare();
    const inside = ids.includes(compareBtn.dataset.compare ?? '');
    compareBtn.setAttribute('aria-pressed', String(inside));
    compareBtn.textContent = inside ? 'Nel confronto' : 'Confronta';
    compareLink.hidden = ids.length === 0;
    compareLink.href = `/confronta?ids=${ids.map(encodeURIComponent).join(',')}`;
    compareLink.textContent = `Vedi il confronto (${ids.length})`;
  };
  compareBtn?.addEventListener('click', () => {
    const id = compareBtn.dataset.compare ?? '';
    let ids = readCompare();
    ids = ids.includes(id) ? ids.filter((x) => x !== id) : [...ids.slice(-3), id];
    try {
      localStorage.setItem(KEY, JSON.stringify(ids));
    } catch {
      /* senza salvataggio il confronto vale per questa pagina */
    }
    showCompare();
  });
  showCompare();

  // Traduzione con Claude: titolo e descrizione cambiano lingua sul posto, l'originale torna con un tocco
  const tr = document.querySelector<HTMLElement>('[data-translate]');
  if (tr) {
    const title = document.querySelector<HTMLElement>('[data-tr="title"]');
    const desc = document.querySelector<HTMLElement>('[data-tr="description"]');
    const status = tr.querySelector<HTMLElement>('.tr-status');
    const original = { title: title?.textContent ?? '', description: desc?.textContent ?? '' };
    const back = tr.querySelector<HTMLButtonElement>('[data-lang=""]');
    tr.addEventListener('click', async (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('button[data-lang]');
      if (!button || !title || !desc || !status) return;
      const lang = button.dataset.lang ?? '';
      if (!lang) {
        title.textContent = original.title;
        desc.textContent = original.description;
        title.removeAttribute('lang');
        desc.removeAttribute('lang');
        if (back) back.hidden = true;
        status.textContent = '';
        return;
      }
      status.textContent = 'Traduco…';
      const res = await fetch(`/traduci?id=${encodeURIComponent(tr.dataset.translate ?? '')}&lang=${lang}`).catch(() => null);
      const data = res?.ok ? ((await res.json()) as { title: string; description: string }) : null;
      if (!data) {
        status.textContent = 'Traduzione non riuscita, riprova più tardi.';
        return;
      }
      title.textContent = data.title;
      desc.textContent = data.description;
      title.lang = lang;
      desc.lang = lang;
      if (back) back.hidden = false;
      status.textContent = 'Tradotto con Claude';
    });
  }

  // "Utile": quali risposte la persona ha già votato (la scheda è uguale per tutti, il voto no)
  const voteButtons = document.querySelectorAll<HTMLButtonElement>('[data-vote]');
  if (voteButtons.length) {
    const id = location.pathname.split('/').pop() ?? '';
    fetch(`/domande/voti?annuncio=${encodeURIComponent(id)}`)
      .then((r) => (r.ok ? r.json() : { voted: [] }))
      .then(({ voted }: { voted: string[] }) => {
        for (const b of voteButtons) b.setAttribute('aria-pressed', String(voted.includes(b.dataset.vote ?? '')));
      })
      .catch(() => {});
  }

  // Prima di chiedere: forse la risposta è già nella descrizione
  const stem = (w: string) => w.slice(0, 5);
  const words = (text: string) =>
    text
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .split(/[^a-z0-9]+/)
      .filter((w) => w.length >= 4 && !['sono', 'della', 'delle', 'questo', 'questa', 'ancora', 'anche', 'come', 'quanto', 'quale'].includes(w))
      .map(stem);
  document.addEventListener('input', (event) => {
    const field = event.target as HTMLTextAreaElement;
    if (!field.matches?.('textarea[data-question]')) return;
    const hint = field.form?.querySelector<HTMLElement>('[data-question-hint]');
    const description = document.getElementById('domande')?.dataset.description ?? '';
    if (!hint) return;
    const asked = new Set(words(field.value));
    let best = '';
    let score = 0;
    for (const sentence of description.split(/(?<=[.!?])\s+|\n+/)) {
      const shared = new Set(words(sentence).filter((w) => asked.has(w))).size;
      if (shared > score) {
        score = shared;
        best = sentence.trim();
      }
    }
    hint.hidden = score < 2;
    hint.textContent = score >= 2 ? `Forse è già scritto nella descrizione: «${best}»` : '';
  });

  // Sezioni a fisarmonica: il link con #dettagli, #prezzo o #sicurezza apre quella giusta,
  // e aprirne una mette il suo indirizzo nella barra, così si può condividere.
  const openFromHash = () => {
    const el = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
    if (el instanceof HTMLDetailsElement) {
      el.open = true;
      el.scrollIntoView({ block: 'start' });
    }
  };
  openFromHash();
  window.addEventListener('hashchange', openFromHash);
  for (const summary of document.querySelectorAll<HTMLElement>('.blocks summary')) {
    summary.addEventListener('click', () => {
      const details = summary.parentElement as HTMLDetailsElement;
      requestAnimationFrame(() => {
        const here = `#${details.id}`;
        if (details.open) history.replaceState(null, '', here);
        else if (location.hash === here) history.replaceState(null, '', location.pathname + location.search);
      });
    });
  }

  // Barra fissa su telefono: sparisce quando il riquadro per scrivere è in vista
  // e mostra il bottone giusto quando arriva il riquadro (server island).
  const bar = document.querySelector<HTMLElement>('[data-buybar]');
  const panel = document.getElementById('contatta');
  if (bar && panel) {
    new IntersectionObserver(([entry]) => bar.classList.toggle('away', entry.isIntersecting), {
      rootMargin: '0px 0px -40px 0px',
    }).observe(panel);

    const main = bar.querySelector<HTMLAnchorElement>('.bb-main');
    const offer = bar.querySelector<HTMLAnchorElement>('.bb-offer');
    const adapt = () => {
      const box = panel.querySelector<HTMLElement>('.contact-box[data-state]');
      if (!box || !main) return false;
      const state = box.dataset.state;
      const link = box.querySelector<HTMLAnchorElement>('a.btn.primary');
      if (state === 'owner' || state === 'off') {
        bar.remove();
      } else if ((state === 'open' || state === 'login') && link) {
        main.href = link.href;
        main.textContent = state === 'open' ? 'Apri la chat' : 'Accedi per scrivere';
        delete main.dataset.focus;
        offer?.remove();
      }
      return true;
    };
    if (!adapt()) {
      const watch = new MutationObserver(() => adapt() && watch.disconnect());
      watch.observe(panel, { childList: true, subtree: true });
    }

    bar.addEventListener('click', (event) => {
      const link = (event.target as Element).closest<HTMLAnchorElement>('a[data-focus]');
      const field = link ? document.getElementById(link.dataset.focus ?? '') : null;
      if (!(field instanceof HTMLTextAreaElement || field instanceof HTMLInputElement)) return;
      event.preventDefault();
      field.focus({ preventScroll: true });
      field.scrollIntoView({ block: 'center', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      if (field instanceof HTMLTextAreaElement) field.setSelectionRange(field.value.length, field.value.length);
    });
  }
</script>

