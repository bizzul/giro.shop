---
import Layout from '../../layouts/Layout.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';
import ListingCard from '../../components/ListingCard.astro';
import ContactBox from '../../components/ContactBox.astro';
import { LISTINGS_TAG } from '../../lib/cache.ts';
import { getListing, getPhoto, sourceName } from '../../core/store.ts';
import { getComune } from '../../core/comuni.ts';
import { getCategory } from '../../core/categories.ts';
import { estimatePrice, priceVerdict } from '../../core/price.ts';
import { similarTo } from '../../core/search.ts';
import { CONDITION_LABEL, VERDICT_LABEL, formatAge, formatChf, formatChfRange } from '../../core/format.ts';

const listing = getListing(Astro.params.id ?? '');
if (!listing) {
  return new Response('Annuncio non trovato', { status: 404 });
}

Astro.cache.set({ tags: [LISTINGS_TAG] });
const sold = listing.status === 'venduto';
const comune = getComune(listing.comuneId);
const photo = getPhoto(listing.id);
const morePhotos = (listing.photos ?? []).slice(1);
const category = getCategory(listing.category);
const verdict = priceVerdict(listing);
const estimate = estimatePrice({
  text: `${listing.title} ${listing.tags.join(' ')}`,
  category: listing.category,
  condition: listing.condition,
  excludeId: listing.id,
});
const similar = similarTo(listing.id, listing.title);
const attributes = Object.entries(listing.attributes);
// Gli annunci usati per la stima, come prova: dal più economico al più caro
const comparables = (estimate?.comparableIds ?? [])
  .map((id) => getListing(id))
  .filter((l): l is NonNullable<typeof l> => Boolean(l))
  .map((l) => ({ l, price: l.status === 'venduto' && l.soldPriceChf ? l.soldPriceChf : l.priceChf }))
  .sort((a, b) => a.price - b.price);
const factCount = 3 + attributes.length;
---

<Layout title={`${listing.title} · giro.shop`} description={listing.description}>
  <section class="wrap band">
    <p class="crumbs muted"><a href="/cerca">Annunci</a> · {category.name}</p>
    <div class="detail">
      {
        photo ? (
          <figure class="gallery">
            <img
              class="hero-photo"
              src={photo.src}
              width={photo.width}
              height={photo.height}
              alt={listing.title}
              fetchpriority="high"
              decoding="async"
            />
            {morePhotos.length > 0 && (
              <div class="thumbs">
                {morePhotos.map((p, i) => (
                  <a href={p.src} target="_blank" rel="noopener">
                    <img src={p.srcSmall} width={p.width} height={p.height} alt={`${listing.title}, foto ${i + 2}`} loading="lazy" decoding="async" />
                  </a>
                ))}
              </div>
            )}
            {photo.credit && (
            <figcaption class="credit">
              Foto di esempio:{' '}
              {photo.credit.authorUrl ? (
                <a href={photo.credit.authorUrl} target="_blank" rel="noopener">
                  {photo.credit.author ?? 'autore'}
                </a>
              ) : (
                (photo.credit.author ?? 'autore sconosciuto')
              )}{' '}
              ·{' '}
              {photo.credit.licenseUrl ? (
                <a href={photo.credit.licenseUrl} target="_blank" rel="noopener license">
                  {photo.credit.license}
                </a>
              ) : (
                photo.credit.license
              )}{' '}
              ·{' '}
              <a href={photo.credit.sourceUrl} target="_blank" rel="noopener">
                {sourceName(photo.credit.source)}
              </a>
            </figcaption>
            )}
          </figure>
        ) : (
          <div class="photo">
            <CategoryIcon category={listing.category} />
            <span class="label">Nessuna foto</span>
          </div>
        )
      }

      <div class="info">
        <h1 class="title">{listing.title}</h1>
        <div class="price-row">
          <span class="price mono">{formatChf(listing.priceChf)}</span>
          {sold && <span class="badge plain">Venduto</span>}
          {!sold && listing.negotiating && <span class="badge sun">In trattativa</span>}
          {!sold && !listing.negotiating && listing.negotiable && <span class="badge plain">Trattabile</span>}
          {!sold && verdict && <span class={`badge ${verdict === 'sopra_mercato' ? 'bad' : 'ok'}`}>{VERDICT_LABEL[verdict]}</span>}
        </div>

        {
          estimate && (
            <a class="estimate" href="#prezzo">
              <span class="ai-mark sm" />
              <span>
                {estimate.basis === 'simili' ? 'Annunci simili' : `Categoria ${category.name}`}: <b class="mono">{formatChfRange(estimate.low, estimate.high)}</b>
                <span class="muted">
                  {' '}
                  ({estimate.comparables} annunci, {estimate.soldComparables} venduti)
                </span>
              </span>
            </a>
          )
        }

        <p class="desc">{listing.description}</p>

        <div id="contatta" class="seller panel">
          <div>
            <span class="label">Pubblicato da</span>
            <p class="name">
              {listing.seller.name}
              {listing.seller.verified && <span class="badge ok">Cellulare verificato</span>}
            </p>
          </div>
          {
            !sold && (
              <ContactBox server:defer listingId={listing.id} sellerName={listing.seller.name}>
                <div slot="fallback" class="contact-ghost" aria-hidden="true" />
              </ContactBox>
            )
          }
        </div>

        <div class="blocks">
          <details id="dettagli" open>
            <summary>
              <h2>Dettagli</h2>
              <span class="count">{factCount}</span>
            </summary>
            <dl class="facts">
              <div><dt>Condizione</dt><dd>{CONDITION_LABEL[listing.condition]}</dd></div>
              <div><dt>Ritiro</dt><dd>{comune ? `${comune.cap} ${comune.name} · distretto di ${comune.district}` : '—'}</dd></div>
              {attributes.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
              <div><dt>Pubblicato</dt><dd>{formatAge(listing.publishedAt)}</dd></div>
            </dl>
          </details>

          {
            estimate && comparables.length > 0 && (
              <details id="prezzo">
                <summary>
                  <h2>Come stimiamo il prezzo</h2>
                  <span class="count">{comparables.length}</span>
                </summary>
                <div class="block-body">
                  <div class="range">
                    <span class="label">Fascia per questo annuncio</span>
                    <b class="mono">{formatChfRange(estimate.low, estimate.high)}</b>
                  </div>
                  <p class="muted">
                    {estimate.basis === 'simili'
                      ? 'Confrontiamo gli annunci dello stesso oggetto, anche quelli già venduti, e li riportiamo alla stessa condizione.'
                      : `Ci sono ancora pochi annunci di questo oggetto: la fascia viene da tutta la categoria ${category.name}, quindi è solo indicativa.`}
                  </p>
                  <ul class="comps">
                    {comparables.map(({ l, price }) => (
                      <li>
                        <a href={`/annuncio/${l.id}`}>{l.title}</a>
                        <span class="muted">
                          {CONDITION_LABEL[l.condition]}
                          {l.status === 'venduto' && ' · venduto'}
                        </span>
                        <span class="mono">{formatChf(price)}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </details>
            )
          }

          <details id="sicurezza">
            <summary>
              <h2>Comprare in sicurezza</h2>
            </summary>
            <ul class="block-body tips">
              <li>Fissa l'incontro in un luogo pubblico e guarda l'oggetto prima di pagare.</li>
              <li>Non pagare in anticipo a chi non conosci e non condividere codici ricevuti per SMS.</li>
              <li>Diffida di chi vuole spostare la conversazione su WhatsApp o ti manda link per pagare.</li>
              <li>Per gli oggetti di valore chiedi lo scontrino o il certificato di garanzia.</li>
            </ul>
          </details>
        </div>
      </div>
    </div>
  </section>

  {
    !sold && (
      <div class="buybar" data-buybar>
        {photo && <img src={photo.srcSmall} alt="" width="56" height="42" decoding="async" />}
        <span class="bb-info">
          <span class="bb-price mono">{formatChf(listing.priceChf)}</span>
          <span class="bb-title">{listing.title}</span>
        </span>
        {listing.priceChf > 0 && (
          <a class="btn bb-offer" href="#contatta" data-focus="contact-offer">
            Offerta
          </a>
        )}
        <a class="btn primary bb-main" href="#contatta" data-focus="contact-body">
          Scrivi
        </a>
      </div>
    )
  }

  {
    similar.length > 0 && (
      <section class="wrap">
        <div class="section-h">
          <h2>Annunci simili</h2>
        </div>
        <div class="cards">
          {similar.map((h) => <ListingCard listing={h.listing} verdict={h.verdict} />)}
        </div>
      </section>
    )
  }
</Layout>

<script>
  // Sezioni a fisarmonica: il link con #dettagli, #prezzo o #sicurezza apre quella giusta,
  // e aprirne una mette il suo indirizzo nella barra, così si può condividere.
  const openFromHash = () => {
    const el = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
    if (el instanceof HTMLDetailsElement) {
      el.open = true;
      el.scrollIntoView({ block: 'start' });
    }
  };
  openFromHash();
  window.addEventListener('hashchange', openFromHash);
  for (const summary of document.querySelectorAll<HTMLElement>('.blocks summary')) {
    summary.addEventListener('click', () => {
      const details = summary.parentElement as HTMLDetailsElement;
      requestAnimationFrame(() => {
        const here = `#${details.id}`;
        if (details.open) history.replaceState(null, '', here);
        else if (location.hash === here) history.replaceState(null, '', location.pathname + location.search);
      });
    });
  }

  // Barra fissa su telefono: sparisce quando il riquadro per scrivere è in vista
  // e mostra il bottone giusto quando arriva il riquadro (server island).
  const bar = document.querySelector<HTMLElement>('[data-buybar]');
  const panel = document.getElementById('contatta');
  if (bar && panel) {
    new IntersectionObserver(([entry]) => bar.classList.toggle('away', entry.isIntersecting), {
      rootMargin: '0px 0px -40px 0px',
    }).observe(panel);

    const main = bar.querySelector<HTMLAnchorElement>('.bb-main');
    const offer = bar.querySelector<HTMLAnchorElement>('.bb-offer');
    const adapt = () => {
      const box = panel.querySelector<HTMLElement>('.contact-box[data-state]');
      if (!box || !main) return false;
      const state = box.dataset.state;
      const link = box.querySelector<HTMLAnchorElement>('a.btn.primary');
      if (state === 'owner' || state === 'off') {
        bar.remove();
      } else if ((state === 'open' || state === 'login') && link) {
        main.href = link.href;
        main.textContent = state === 'open' ? 'Apri la chat' : 'Accedi per scrivere';
        delete main.dataset.focus;
        offer?.remove();
      }
      return true;
    };
    if (!adapt()) {
      const watch = new MutationObserver(() => adapt() && watch.disconnect());
      watch.observe(panel, { childList: true, subtree: true });
    }

    bar.addEventListener('click', (event) => {
      const link = (event.target as Element).closest<HTMLAnchorElement>('a[data-focus]');
      const field = link ? document.getElementById(link.dataset.focus ?? '') : null;
      if (!(field instanceof HTMLTextAreaElement || field instanceof HTMLInputElement)) return;
      event.preventDefault();
      field.focus({ preventScroll: true });
      field.scrollIntoView({ block: 'center', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      if (field instanceof HTMLTextAreaElement) field.setSelectionRange(field.value.length, field.value.length);
    });
  }
</script>

<style>
  .crumbs { font-size: 13px; margin-bottom: 24px; }
  .crumbs a { color: inherit; text-underline-offset: 4px; text-decoration-color: var(--line-strong); }
  .detail { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: clamp(32px, 5vw, 64px); align-items: start; }
  @media (max-width: 860px) { .detail { grid-template-columns: 1fr; } }
  .photo { aspect-ratio: 4 / 3; border-radius: 6px; background: var(--surface); display: grid; place-items: center; align-content: center; gap: 16px; color: var(--muted); max-width: 100%; }
  .photo svg { width: 30%; height: auto; }
  .gallery { display: grid; gap: 10px; }
  .hero-photo { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 6px; background: var(--surface); display: block; }
  .thumbs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
  .thumbs img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 4px; display: block; }
  .credit { font-size: 12px; color: var(--muted); line-height: 1.4; }
  .credit a { color: inherit; text-underline-offset: 2px; }
  .info { display: grid; gap: 24px; }
  .title { font-size: clamp(28px, 3.4vw, 40px); line-height: 1.1; }
  .price-row { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-top: -8px; }
  .price { font-size: 24px; font-weight: 500; line-height: 1; }
  .estimate { display: flex; gap: 12px; align-items: center; padding: 12px 14px; border-radius: 4px; background: var(--surface); font-size: 14px; text-decoration: none; }
  .estimate:hover { text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--line-strong); }
  .estimate b { font-weight: 500; }

  /* Sezioni a fisarmonica, con il numero di voci accanto al titolo */
  .blocks { border-top: 1px solid var(--line); }
  .blocks details { border-bottom: 1px solid var(--line); scroll-margin-top: 16px; }
  .blocks summary { display: flex; align-items: center; gap: 10px; padding-block: 18px; cursor: pointer; list-style: none; }
  .blocks summary::-webkit-details-marker { display: none; }
  .blocks summary::after { content: ''; width: 8px; height: 8px; margin-left: auto; margin-right: 4px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: translateY(-2px) rotate(45deg); transition: transform 0.15s; }
  .blocks details[open] > summary::after { transform: translateY(2px) rotate(-135deg); }
  .blocks summary h2 { font: 500 16px/1.3 var(--f-body); letter-spacing: 0; }
  .blocks .count { min-width: 22px; height: 20px; border-radius: 10px; padding-inline: 7px; background: var(--surface); color: var(--muted); font: 500 11.5px/20px var(--f-body); text-align: center; }
  .block-body { display: grid; gap: 14px; padding-bottom: 20px; font-size: 14.5px; }
  .block-body b { font-weight: 500; color: var(--ink); }
  .range { display: grid; gap: 6px; padding: 14px 16px; border-radius: 4px; background: var(--surface); }
  .range b { font-size: 20px; line-height: 1.2; white-space: nowrap; }
  .comps { display: grid; }
  .comps li { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2px 16px; padding-block: 10px; border-top: 1px solid var(--line); }
  .comps a { text-underline-offset: 4px; text-decoration-color: var(--line-strong); overflow-wrap: anywhere; }
  .comps .muted { grid-column: 1; font-size: 13px; }
  .comps .mono { grid-column: 2; grid-row: 1; font-size: 13px; }
  .tips { list-style: disc; padding-left: 20px; gap: 8px; }
  .facts { display: grid; border-top: 1px solid var(--line); margin-bottom: 20px; }
  .facts > div { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 12px; padding-block: 12px; border-bottom: 1px solid var(--line); font-size: 15px; }
  .facts dt { font: 500 11px/2 var(--f-body); text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
  .desc { font-size: 16px; line-height: 1.6; max-width: 62ch; }
  .seller { display: grid; gap: 16px; padding: 20px; }
  .name { display: flex; align-items: center; gap: 10px; font-weight: 500; margin-top: 6px; }
  .contact-ghost { min-height: 52px; }
  .contact { display: grid; gap: 6px; justify-items: end; }
  @media (max-width: 480px) { .contact { justify-items: stretch; width: 100%; } }

  /* Barra fissa in basso, solo su telefono: prezzo sempre in vista e un tocco per scrivere */
  .buybar { display: none; }
  @media (max-width: 760px) {
    .buybar {
      position: fixed;
      z-index: 40;
      left: 0;
      right: 0;
      bottom: 0;
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px max(16px, env(safe-area-inset-right, 0px)) calc(10px + env(safe-area-inset-bottom, 0px)) max(16px, env(safe-area-inset-left, 0px));
      background: var(--bg);
      border-top: 1px solid var(--line);
      box-shadow: 0 -8px 24px -16px rgba(17, 17, 17, 0.3);
      transition: transform 0.2s ease-out;
    }
    .buybar.away { transform: translateY(110%); }
    .buybar img { width: 56px; height: 42px; object-fit: cover; border-radius: 4px; flex: none; }
    .bb-info { display: grid; gap: 2px; min-width: 0; flex: 1; }
    .bb-price { font-size: 14px; font-weight: 500; }
    .bb-title { font-size: 12.5px; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .buybar .btn { padding: 13px 14px; flex: none; }
    :global(body:has(.buybar)) { padding-bottom: calc(76px + env(safe-area-inset-bottom, 0px)); }
  }
  @media (max-width: 360px) {
    .buybar img { display: none; }
  }
</style>
