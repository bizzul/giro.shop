---
import Layout from '../layouts/Layout.astro';
import SearchForm from '../components/SearchForm.astro';
import SearchResults from '../components/SearchResults.astro';

const q = Astro.url.searchParams.get('q')?.trim().slice(0, 200) ?? '';
---

<Layout title={q ? `${q} · giro.shop` : 'Cerca · giro.shop'}>
  <section class="wrap band">
    <div class="head">
      <SearchForm value={q} autofocus={!q} target="risultati" mode="cerca" />
    </div>
    <p id="risultati-stato" class="sr" aria-live="polite"></p>
    <div id="risultati" class="results">
      <SearchResults q={q} mode="cerca" />
    </div>
  </section>
</Layout>

<style>
  .head { display: grid; gap: 24px; max-width: 760px; margin-bottom: 40px; }
  /* Su telefono la ricerca è fissata in basso: qui sopra non resta niente da spaziare */
  @media (max-width: 760px) { .head { margin-bottom: 0; } }
</style>
