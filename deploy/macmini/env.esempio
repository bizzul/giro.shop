# .env del sito sul Mac mini (copialo in ~/piazza/.env, non va su git). Le chiavi di Supabase: `pnpm exec supabase status`.

# Indirizzo pubblico: link nelle email, sitemap, OAuth del connettore AI
PIAZZA_BASE_URL=https://giro.omarbeltraminelli.com

# Supabase: i browser usano l'indirizzo pubblico (foto, link di accesso), il server quello interno
PUBLIC_SUPABASE_URL=https://giro.omarbeltraminelli.com
SUPABASE_INTERNAL_URL=http://127.0.0.1:54421
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Email degli avvisi (le manda il sito). Finché non le compili, gli avvisi restano solo nel sito.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=giro.shop <avvisi@omarbeltraminelli.com>

# Facoltativa: Claude per bozze, traduzioni, ricerca con foto e moderazione
ANTHROPIC_API_KEY=
