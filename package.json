{
  "name": "piazza",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--max-http-header-size=65536 astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node --max-http-header-size=65536 dist/server/entry.mjs",
    "astro": "astro",
    "test": "vitest run",
    "mcp:stdio": "node src/mcp/stdio.ts",
    "mcp:smoke": "node scripts/mcp-smoke.ts",
    "db:seed-sql": "node scripts/seed-sql.ts > supabase/seed.sql",
    "test:db": "node scripts/check-db.ts",
    "test:moderazione": "node scripts/check-moderation.ts",
    "test:oauth": "node scripts/check-oauth.ts",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/screenshots.ts",
    "email:modelli": "node scripts/email-templates.ts",
    "email:anteprima": "node scripts/email-preview.ts",
    "foto:miniature": "node --env-file=.env scripts/miniature.ts",
    "icone": "node scripts/icone.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@astrojs/node": "^11.1.11",
    "@astrojs/preact": "^6.1.2",
    "@huggingface/transformers": "^4.3.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "astro": "^7.4.7",
    "nodemailer": "^10.3.1",
    "preact": "^11.2.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@modelcontextprotocol/client": "^2.4.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "supabase": "2.111.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
